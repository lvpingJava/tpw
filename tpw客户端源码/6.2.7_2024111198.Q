Function 合作中判断是否结束()
	
    合作中判断是否结束 = 0
    dm.Delay 5
    dm_ret = remoteFindPic("对战结束确定.tif", "460, 510, 588, 570", 0.8, 1)
    If len(dm_ret) > 0 Then
        合作中判断是否结束 = 1
        Exit Function
    End If
    
    dm.Delay 5
    dm_ret = dm.FindStrFast(460, 510, 588, 570, "确|定", "ffffff-303030", 0.83, intX, intY)
    If dm_ret >= 0 Then
        合作中判断是否结束 = 1
        Exit Function
    End If
    
    dm.Delay 5
    dm_ret = dm.FindStrFast(460, 510, 588, 570, "确|定", "ffffff-151515", 0.83, intX, intY)
    If dm_ret >= 0 Then
        合作中判断是否结束 = 1
        Exit Function
    End If
    
    dm.Delay 5
    dm_ret = dm.FindStrFast(808, 533, 989, 600, "对战", "ffffff-252525", 0.85, intX, intY)
    If dm_ret >= 0 Then
        合作中判断是否结束 = 1
        Exit Function
    End If
    
    dm.Delay 5
    dm_ret = remoteFindPic("主界面.bmp", "114,89,157,121", 0.8, 1)
    If len(dm_ret) > 0 Then
        合作中判断是否结束 = 1
        Exit Function
    End If
    
    If 寒冰ck = 1 Then 
        dm.Delay 5
        dm_ret = remoteFindPic("返回按钮.tif", "16,54,80,94", 0.81, 1)
        If len(dm_ret) > 0 Then
            合作中判断是否结束 = 1
            Exit Function
        End If
    End If
    
   
End Function


