End Function

Function 好友消息通知()
    好友消息通知 = 0
    dm_ret = dm.FindColor(811,48,832,62, "ff2727-292929", 0.89, 0, intX, intY)
    If dm_ret = 1 Then 
        好友消息通知 = 1
    End If
End Function

Sub 世界社交喊话()
    dm.Delay 100
    TracePrint "进入世界社交喊话"
    If 社交频道入口(0) = 1 Then 
        dm.Delay 60
        Call MoveToFcn(976,470)
        dm.Delay 200
        dm.LeftClick 
        dm.Delay 1000
        dm.LeftClick 
			
        If 世界频道社交() = 1 Then 
            TracePrint "世界社交喊话-扩展次数:" & 扩展次数
            If 扩展次数 > 0 Then 
                TracePrint "社交好友合作前，清除好友消息"
                dm.Delay 2000
                //点击好友
                For 3
                    Call MoveToFcn(785,65)
                    dm.Delay 200
                    dm.LeftClick 
                    dm.Delay 100
                Next
                dm.Delay 2000
                For 200
                    dm.Delay 100
                    If 关闭好友头像() = 1 Then 
                        dm.Delay 1000
                    Else 
                        TracePrint "没有消息，就退出清除循环"
                        扩展次数 = 0
                        //点击社交
                        dm.Delay 1000
                        Call MoveToFcn(627,67)
                        dm.Delay 200
                        dm.LeftClick
                        Exit For
                    End If
                Next
            End If
        	
        		
            If 好友消息通知() = 1 Then 
                TracePrint "世界社交喊话看到有消息，直接进入好友房间识别"
                Call 好友房间合作(1)
                Exit Sub
            End If
            
            Dim wxNowTime, 社交世界喊话时间间隔
            社交世界喊话时间间隔 = Int(社交世界喊话间隔text)
            If 社交喊话ck = 1 and 世界喊话ck = 1 Then 	
                Do While 世界喊话统计 < 501
                    wxNowTime = Now
                    Call 社交喊话do()
                    dm.Delay 5000
                    Call 世界喊话do()
                    Do
                        If 计时器(wxNowTime) > 社交世界喊话时间间隔 Then 
                            Exit Do
                        End If
   							
                        If 好友消息通知() = 1 Then 
                            Exit Do
                        End If
                        dm.Delay 1000
                    Loop
   						
                    If 好友消息通知() = 1 Then 
                        Exit Do
                    End If
                Loop
   					
            ElseIf 社交喊话ck = 1 Then
                Do While 社交喊话统计 < 101
                    wxNowTime = Now
                    Call 社交喊话do()
                    Do
                        If 计时器(wxNowTime) > 社交世界喊话时间间隔 Then 
                            Exit Do
                        End If
   							
                        If 好友消息通知() = 1 Then 
                            Exit Do
                        End If
                        dm.Delay 1000
                    Loop
   						
                    If 好友消息通知() = 1 Then 
                        Exit Do
                    End If
                Loop
            ElseIf 世界喊话ck = 1 Then 	
                Do While 世界喊话统计 < 501
                    wxNowTime = Now
                    Call 世界喊话do()
                    Do
                        If 计时器(wxNowTime) > 社交世界喊话时间间隔 Then 
                            Exit Do
                        End If
   							
                        If 好友消息通知() = 1 Then 
                            Exit Do
                        End If
                        dm.Delay 1000
                    Loop
   						
                    If 好友消息通知() = 1 Then 
                        Exit Do
                    End If
                Loop
            End If
   				
            If 好友消息通知() = 1 Then 
                Call 好友房间合作(1)
                Exit Sub
            End If
   						
        Else
            TracePrint "没找到社交"
            dm.Delay 1000
            Call 关闭通讯()	 
        End If
    Else 
        TracePrint "世界社交喊话进入失败"
        dm.Delay 1000
        Call 关闭通讯()	
    End If


End Sub
