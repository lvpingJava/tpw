Function 回显注册码信息()
	//端口获取   	
    Dim portTxt,txt
	portTxt = 5000
	txt = Plugin.lxj_Plug.lxj_Txtline("C:\test_game\port.txt")
	If txt = "" Then	
    	portTxt = 5000
	Else 
    	portTxt = Trim(txt(1))
	End If
	Form1.Label6.Caption = portTxt
	pyport = portTxt
	
    txt =""
    txt = Plugin.lxj_Plug.lxj_Txtline("C:\test_game\注册码.txt")
    If txt = "" Then	
        TracePrint "注册码文件路径不存在！"
        //挂机模式
        Form1.CheckBox89.Value = 1
    Else 
        Form1.InputBox3.text = Trim(txt(1))
        Form1.ComboBox1.ListIndex = Int(Trim(txt(2)))
    End If
End Function

