Sub 快捷键获取窗口句柄
    Hwndkj = 0
    If Hwndkj = 0 Then 
        Hwndkj = Plugin.Window.Find("Chrome_WidgetWin_0", "塔防精灵")
        If Hwndkj > 0 Then 
            Plugin.Window.Size Hwndkj,1040,629
            Form1.Label156.Caption = "启动快捷成功！请进入对战或者合作，直接按对应的按键即可！"
            Delay 100
            Call 按键info()
        Else 
            Form1.Button21.Enabled = True
            MessageBox "启动快捷失败，请确认是否启动游戏！"
        End If
        //改建助手.Label18.Caption = "成功绑定窗口" & Hwnd
    End If
End Sub


Function 获取坐标(tag, index)
    Dim 对战坐标,合作坐标左,合作坐标右
    If tag = 1 Then 
        对战坐标 = Array("97,441", "50,439", "94,363", "47,363", "89,290", "50,301", "154,371")
        获取坐标 = 对战坐标(index)
    ElseIf tag = 2 Then
        合作坐标左 = Array("145,448", "105,448", "145,376", "105,376", "145,303", "105,303","125,225")
        获取坐标 = 合作坐标左(index)
    ElseIf tag = 3 Then
        合作坐标右 = Array("271,447","235,447","271,375","235,375","271,304","235,304","227,225")
        获取坐标 = 合作坐标右(index)
    ElseIf tag = 4 Then
        大航海坐标 = Array("127,441", "80,439", "129,363", "80,363", "120,290", "80,301", "184,371")
        获取坐标 = 大航海坐标(index)	
    End If	
End Function


Sub 按键info

    If Form1.CheckBox92.Value = 1 Then 
        Delay 10
