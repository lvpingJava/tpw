Function 当前是否全部升满()
    当前是否全部升满 = 0
    Dim 金i, yi
    金i = 0
    yi = 0
    For ixi = 0 To 6
        If 战车上卡牌升级统计(ixi) > 0 Then 
            yi = yi + 1
            If 战车上卡牌升级统计(ixi) = 10 Then 
                金i = 金i + 1
            End If
        End If
    Next
	
	
    If 金i = yi Then 
        当前是否全部升满 = 1
        TracePrint "当前卡牌全满，不需要使用光精灵：" & 金i
    End If
	
End Function

Function 金卡初始化(jkindex)
    If jkindex = 0 Then 
        一号金 = 0
    ElseIf	jkindex = 1 Then 
        二号金 = 0
    ElseIf	jkindex = 2 Then 
        三号金 = 0
    ElseIf	jkindex = 3 Then 
        四号金 = 0
    ElseIf	jkindex = 4 Then 
        五号金 = 0
    ElseIf	jkindex = 5 Then
        六号金 = 0
    ElseIf	jkindex = 6 Then 
        七号金 = 0
    End If
End Function

Function 对战英雄升满切换()
    If 对战英雄全满级时英雄切换ck = 1 and 对战升满计数 >= 对战满级数量 and 对战英雄全满级时英雄切换完成 = 0  Then 
        TracePrint "对战英雄升满切换开始"
        Dim 对战英雄全满级时英雄切换数组Size
        对战英雄全满级时英雄切换数组Size = UBound(对战英雄全满级时英雄切换数组)
        TracePrint "对战英雄全满级时英雄切换数组Size：" & 对战英雄全满级时英雄切换数组Size
        If 对战英雄全满级时英雄切换数组Size >= 0 Then 
            Dim hki, is是否删除,qcardAdd,qcardDel,获得英雄,iz,dx, dy
            For hki = 0 To 对战英雄全满级时英雄切换数组Size
                TracePrint "对战英雄全满级时英雄切换数组:" & 对战英雄全满级时英雄切换数组(hki)
                获得英雄 = Split(Trim(对战英雄全满级时英雄切换数组(hki)), "-")
                qcardDel = 获得英雄(0) 	
                qcardAdd = 获得英雄(1)			
                For iz = 0 To 6
                    If qcardDel = 战车卡牌位置数组(iz) Then 
  	
                        英雄坐标 = 对战战车上卡牌坐标(iz)
                        TracePrint  iz & "号下标位置要卖卡，卡牌为：" & qcardDel
                        获得坐标数组 = Split(Trim(英雄坐标), ",")
                        dx = Int(获得坐标数组(0))
                        dy = Int(获得坐标数组(1))
 							
                        For 100
                            dm.Delay 50
                            Call MoveToFcn(dx,dy)
                            dm.Delay 30
                            dm.LeftClick 
                            dm.Delay 50
                            If 战车中英雄弹框红叉() = 1 Then 
                                Exit For
                            End If
                        Next
	
                        For 100
                            dm.Delay 50 
                            Call MoveToFcn(327,452)
                            dm.Delay 30
                            dm.LeftClick 
                            dm.Delay 50
                            If 战车中英雄弹框红叉() = 0 Then 
                                is是否删除 = 1
                                Exit For
                            End If
 								
                        Next
    						
                        If is是否删除 = 1 Then 
                            战车上卡牌升级统计(iz) = 0
                            战车卡牌位置数组(iz) = 0
    							
                            Call 金卡初始化(iz)
    							
                            Call 删除对战不上的卡牌(qcardAdd)
                            Call 删除核心英雄优先数组(qcardDel)
                            Call 调整卡牌顺序(qcardAdd)
                            Call 新增对战不上的卡牌(qcardDel)
                            对战英雄全满级时英雄切换完成 = 1
                            Exit For
                        End If
	
                    End If
                Next
					
            Next
  
		
			
        End If
    End If
End Function

Function 对战某个英雄升满切换()
    对战某个英雄升满切换 = 0
    If 对战某个英雄全满级时英雄切换ck = 1 and 对战某个英雄全满级时英雄切换完成 = 0 Then 
        TracePrint "对战某个英雄升满切换开始"
        Dim 对战某个英雄全满级时英雄切换数组Size
        对战某个英雄全满级时英雄切换数组Size = UBound(对战某个英雄全满级时英雄切换数组)
        TracePrint "对战某个英雄全满级时英雄切换数组Size：" & 对战某个英雄全满级时英雄切换数组Size
        If 对战某个英雄全满级时英雄切换数组Size >= 0 and len(对战某个英雄全满级时英雄str) > 0 Then 
        
            If 战车卡牌位置下标((对战某个英雄全满级时英雄str)) <= - 1  Then 
                Exit Function
            End If
        	
            If 战车上卡牌升级统计(战车卡牌位置下标((对战某个英雄全满级时英雄str))) < 10 Then 
                Exit Function
            End If

            Dim hki, is是否删除,qcardAdd,qcardDel,获得英雄,iz,dx,dy,切换的英雄没上车
            For hki = 0 To 对战某个英雄全满级时英雄切换数组Size
                TracePrint "对战某个英雄全满级时英雄切换数组:" & 对战某个英雄全满级时英雄切换数组(hki)
                获得英雄 = Split(Trim(对战某个英雄全满级时英雄切换数组(hki)), "-")
                qcardDel = 获得英雄(0)
                qcardAdd = 获得英雄(1)
                切换的英雄没上车 = 1
                For iz = 0 To 6
                    If qcardDel = 战车卡牌位置数组(iz) Then 
                        切换的英雄没上车 = 0
                        英雄坐标 = 对战战车上卡牌坐标(iz)
                        TracePrint  iz & "号下标位置要卖卡，卡牌为：" & qcardDel
                        获得坐标数组 = Split(Trim(英雄坐标), ",")
                        dx = Int(获得坐标数组(0))
                        dy = Int(获得坐标数组(1))
 							
                        For 100
                            dm.Delay 50
                            Call MoveToFcn(dx,dy)
                            dm.Delay 30
                            dm.LeftClick 
                            dm.Delay 50
                            If 战车中英雄弹框红叉() = 1 Then 
                                Exit For
                            End If
                        Next
	
                        For 100
                            dm.Delay 50 
                            Call MoveToFcn(327,452)
                            dm.Delay 30
                            dm.LeftClick 
                            dm.Delay 50
                            If 战车中英雄弹框红叉() = 0 Then 
                                is是否删除 = 1
                                Exit For
                            End If
 								
                        Next
    						
                        If is是否删除 = 1 Then 
                            战车上卡牌升级统计(iz) = 0
                            战车卡牌位置数组(iz) = 0
    							
                            Call 金卡初始化(iz)
    							
                            Call 删除对战不上的卡牌(qcardAdd)
                            Call 删除核心英雄优先数组(qcardDel)
                            Call 调整卡牌顺序(qcardAdd)
                            Call 新增对战不上的卡牌(qcardDel)
                            对战某个英雄全满级时英雄切换完成 = 1
                            对战某个英雄升满切换 = 1
                            Exit For
                        End If
	
                    End If
                Next
                
                If 切换的英雄没上车 = 1 Then 
                    TracePrint "某个满级切换的英雄没上车，提前处理"
                    Call 删除对战不上的卡牌(qcardAdd)
                    Call 删除核心英雄优先数组(qcardDel)
                    Call 调整卡牌顺序(qcardAdd)
                    Call 新增对战不上的卡牌(qcardDel)
                    对战某个英雄全满级时英雄切换完成 = 1
                    对战某个英雄升满切换 = 1
                End If
            Next
        End If
    End If
End Function

Function 满金核心英雄加入核心栏(card)
    If 对战5Buffck = 1 Then 
        For ixi = 0 To 6
            If 对战满星英雄判断数组(ixi) = card Then 
                For jxi = 0 To 6
                    If IsNumeric(对战满星英雄后强制加入核心栏英雄(jxi)) <> - 1  Then 
                        Call 新增核心英雄优先数组(对战满星英雄后强制加入核心栏英雄(jxi))
                        Call 删除对战不上的卡牌(对战满星英雄后强制加入核心栏英雄(jxi))
                    End If
                Next
                Exit For
            End If
        Next
    End If
End Function

Function 对战卖卡牌数组初始化()
    If 对战要卖的英雄ck = 1 Then 
        If len(Trim(对战要卖的卡牌str)) > 0 Then 
            对战要卖的卡牌str = 字符串竖杠处理(对战要卖的卡牌str)
            对战要卖的卡牌数组 = Split(对战要卖的卡牌str, "|")
            对战要卖的卡牌数组max = UBound(对战要卖的卡牌数组)
        End If
    End If
End Function


Function 战车中英雄弹框红叉()

    战车中英雄弹框红叉 = 0
    dm.Delay 30
    dm_ret = remoteFindPic("关闭红叉标志.tif", "778,109,825,146", 0.8, 1)
    If len(dm_ret) > 0 Then 
        战车中英雄弹框红叉 = 1
    End If
End Function

Function get对战要卖的卡牌(card)
    get对战要卖的卡牌 = 0
    mkSize = UBound(对战要卖的卡牌数组)
    For bskpi=0 To mkSize
        If 对战要卖的卡牌数组(bskpi) = card Then 
            get对战要卖的卡牌 = 1
            Exit For
        End If
    Next
End Function

Function 对战执行卖卡操作()
    If 对战要卖的英雄ck = 1 and 是否有要买卡牌的英雄 = 1 Then 
        Dim mkSize,mki,nowZcSize,zckpi,获得坐标数组
        mkSize = UBound(对战要卖的卡牌数组)
        For mki = 0 To mkSize
            nowZcSize = UBound(战车卡牌位置数组)
            For zckpi = 0 To nowZcSize
                If 战车卡牌位置数组(zckpi) = 对战要卖的卡牌数组(mki) Then 
                    mkpCard = 对战要卖的卡牌数组(mki)
                    英雄坐标 = 对战战车上卡牌坐标(zckpi)
                    TracePrint  zckpi & "号下标位置要卖卡，卡牌为：" & mkpCard
                    //处理坐标
                    获得坐标数组 = Split(Trim(英雄坐标), ",")

    				
                  	
                    intX = Int(获得坐标数组(0))
                    intY = Int(获得坐标数组(1))
 					
                    is是否删除 = 0
                    If mkpCard = "小鹿" Then 
 					
                        For 100
                            Call MoveToFcn(intX+获取随机数(6),intY+获取随机数(6))
                            dm.Delay 100
                            dm.LeftClick 
 							
                            If 战车中英雄弹框红叉() = 1 Then 
                                Exit For
                            End If
                        Next

                        For 100
                            Call MoveToFcn(327,452)
                            dm.Delay 100
                            dm.LeftClick 
 							
                            If 战车中英雄弹框红叉() = 0 Then 
                                is是否删除 = 1
                                Exit For
                            End If
 							
                        Next
    				
                    ElseIf mkpCard = "冰法" Then
					
                        For 100
                            Call MoveToFcn(intX+获取随机数(6),intY+获取随机数(6))
                            dm.Delay 100
                            dm.LeftClick 
 							
                            If 战车中英雄弹框红叉() = 1 Then 
                                Exit For
                            End If
                        Next

                        For 100
                            Call MoveToFcn(327,452)
                            dm.Delay 100
                            dm.LeftClick 
 							
                            If 战车中英雄弹框红叉() = 0 Then 
                                is是否删除 = 1
                                Exit For
                            End If
 							
                        Next
    					
                    End If
 					
                    If is是否删除 = 1 Then 
					
                        If mkpCard = "冰法" Then 
                            买冰法次数计数 = 买冰法次数计数 + 1
                        End If
							
                        If mkpCard = "小鹿" Then
                            买小鹿次数计数 = 买小鹿次数计数 + 1
                        End If
					
                        If 买冰法次数计数 >= 买冰法次数 Then 
                            If 冰法是否排序到最后 = 0 Then 
                                Call 调整卡牌顺序后("冰法")	
                                冰法是否排序到最后 = 1
                                Call 删除核心英雄优先数组("冰法")
                            End If	
                        End If
							
                        If 买小鹿次数计数 >= 买小鹿次数 Then 
                            If 小鹿是否排序到最后 = 0 Then 
                                Call 调整卡牌顺序后("小鹿")
                                小鹿是否排序到最后 = 1
                                Call 删除核心英雄优先数组("小鹿")
                            End If
							
                        End If
 					
                        TracePrint mkpCard&":已删除"
                        战车卡牌位置数组(zckpi) = 0
                        战车上卡牌升级统计(zckpi) = 0
                        已有英雄多次判断 = 0
                        卡牌已删除 = 1

                    Else 
                        Call 卡牌面板循环关闭()
                    End If
 					
                    Exit For
                End If
            Next			
        Next
    End If
End Function




Function 是否属于不记录卡牌(card)
    是否属于不记录卡牌 = 0
    For bjlkpi = 0 To 不记录卡牌位置的数组Len
        If card = 不记录卡牌位置的数组(bjlkpi)  Then 
            是否属于不记录卡牌 = 1
            Exit For
        End If
    Next
End Function


Function get战车上卡牌升级统计()
    dqkplogStr = ""
	
    For ixi = 0 To 6
        dqkplogStr =dqkplogStr &  战车上卡牌升级统计(ixi) & ","
    Next
    TracePrint "卡牌升级情况：" & 	dqkplogStr
End Function

Function 战车上卡牌数量Filter()
    战车上卡牌数量Filter = 0
    For ix = 0 To 6
        If 战车上卡牌升级统计(ix) > 0 Then 
            If 工程类英雄(战车卡牌位置数组(ix)) = 0 Then 
                战车上卡牌数量Filter = 战车上卡牌数量Filter + 1
            End If
        End If
    Next	
End Function

Function 快速卡牌下架(index)
    Dim 坐标,坐标数组
    坐标 = "0,0"
    If 卡牌在战车方向 = "右" Then 
        坐标=合作战车上卡牌坐标右(index)
    Else
        坐标=合作战车上卡牌坐标左(index)
    End If
    
    For 3
        For 2
            坐标数组 = Split(Trim(坐标),",")
            Call MoveToFcn(Int(坐标数组(0)), Int(坐标数组(1)))
            dm.Delay 30
            dm.LeftClick 
        Next
	
        For 2
            Call MoveToFcn(369,456+获取随机数(4))
            dm.Delay 30
            dm.LeftClick 
        Next
    Next
End Function



Function 战车卡牌位置添加(cardxy,tag)
    If 工程类英雄(cardxy) = 1 Then 
        战车上卡牌升级统计(6) = 战车上卡牌升级统计(6) + 1
        战车卡牌位置数组(6) = cardxy
        TracePrint "添加卡牌：" & cardxy
    Else 
        // 是否属于不记录卡牌(cardxy) = 0
        If tag = 0 Then 
            boolAdd = 0 
            For iz = 0 To 6
                If cardxy = 战车卡牌位置数组(iz)  Then 
                    boolAdd = 1
                    战车上卡牌升级统计(iz) = 战车上卡牌升级统计(iz) + 1
                    Exit For
                End If
            Next
			
            If boolAdd = 0 Then 
                For ix = 0 To 6
                    z = 战车卡牌位置数组(ix)
                    If IsNumeric(z) = - 1  Then 
                        战车卡牌位置数组(ix) = cardxy
                        战车上卡牌升级统计(ix) = 战车上卡牌升级统计(ix) + 1
                        TracePrint "添加卡牌：" & cardxy
                        Exit For
                    End If
                Next	
            End If	
        End If
    End If
End Function

Function 战车位置确认()
    战车位置确认 = -1
    For ix = 0 To 6
        z = 战车卡牌位置数组(ix)
        If IsNumeric(z) = -1  Then 
            战车位置确认 = ix 
            Exit For
        End If
    Next	
End Function

//卡牌是否已上战车
Function 卡牌是否已上战车(card)
    卡牌是否已上战车 = 0
    //iwmax = UBound(战车卡牌位置数组)
    For iw = 0 To 6
        If card = 战车卡牌位置数组(iw)  Then 
            卡牌是否已上战车 = 1
            Exit For
        End If
    Next
End Function

Function 战车上是否已全部上了英雄(card)
    Dim 战车上是否已全部上了英雄i
    战车上是否已全部上了英雄i = 0
    For iw = 0 To 6
        If 战车上卡牌升级统计(iw) > 0  Then 
            战车上是否已全部上了英雄i = 战车上是否已全部上了英雄i + 1
        End If
    Next
	
    If 战车上是否已全部上了英雄i >= 7 Then 
        战车上是否已全部上了英雄 = 1
        TracePrint "对战战车上是否已全部上了英雄7个英雄了"
    Else 
        If 战车上是否已全部上了英雄i >= 6 and 是否有工程类英雄 = 0 Then 
            战车上是否已全部上了英雄 = 1
            TracePrint "对战战车上是否已全部上了英雄6个英雄了"
        End If
    End If
	
End Function

Function 战车卡牌位置下标(card)
    战车卡牌位置下标 = -1
    //iwmax = UBound(战车卡牌位置数组)
    For iw = 0 To 6
        If card = 战车卡牌位置数组(iw)  Then 
            战车卡牌位置下标 = iw
            Exit For
        End If
    Next
End Function

Function 当前卡牌阵容下标(card)
    当前卡牌阵容下标 = -1
    For iw = 0 To 9
        If card = 当前卡牌阵容(iw)  Then 
            当前卡牌阵容下标 = iw
            Exit For
        End If
    Next
End Function

Function 合作战车上卡牌的数量()
    合作战车上卡牌的数量 = 0
    Dim iw1,战车上卡牌的数量i
    战车上卡牌的数量i = 0
    For iw1 = 0 To 6
        If 战车上卡牌升级统计(iw1) > 0   Then 
            战车上卡牌的数量i = 战车上卡牌的数量i + 1
        End If
    Next
    合作战车上卡牌的数量 = 战车上卡牌的数量i
End Function

//战车上卡牌的数量
Function 战车上卡牌的数量()
    战车上卡牌的数量 = 0
    Dim iw1,战车上卡牌的数量i
    战车上卡牌的数量i = 0
    For iw1 = 0 To 5
        If 战车上卡牌升级统计(iw1) > 0   Then 
            战车上卡牌的数量i = 战车上卡牌的数量i + 1
        End If
    Next
    战车上卡牌的数量 = 战车上卡牌的数量i
End Function

