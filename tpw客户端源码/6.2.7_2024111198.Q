Function 英雄识别(tag)
    英雄识别 = 0
    If 合作刷新判断() = 1 Then 
        识别到的英雄数组 = Array(0, 0, 0)
        识别到的英雄坐标数组 = Array(0, 0, 0)
        dm_ret =  remoteFindPicS("400,517,640,608",0.85,0,卡牌阵容初始值str,0)
        If Len(dm_ret) > 0 Then
            TracePrint "识别结果为：" & dm_ret
            Dim resultList,doi,doCounti,返回识别结果,resultListChild,card,intX,intY
            resultList = split(dm_ret,"|")
            doi = 0
            doCounti = UBound(resultList) + 1
            TracePrint "doCounti为：" & doCounti
            If tag = 1 Then 
                If doCounti < 3 Then 
                    TracePrint "doCounti小于1，退出方法：" & doCounti
                    Exit Function
                End If
            End If
    		
            返回识别结果 = 0
            Do While doi < doCounti
                resultListChild = split(resultList(doi),",")
                card = resultListChild(0)
                intX = int(resultListChild(1))
                intY = int(resultListChild(2))
                doi = doi + 1
                返回识别结果 = 返回识别结果 + 识别到的英雄(card, intX, intY)
  	
                If 返回识别结果 = 3 Then 
                    doCounti = -1
                End If
            Loop
        End If
        英雄识别 = 返回识别结果
    End If
End Function

Sub 识别到的英雄排序()
    Dim ia,ib,zkCard
    调整顺序后识别到的英雄数组 = Array(0, 0, 0)
    For ia = 0 To 9
        For ib = 0 To 2
            zkCard = 识别到的英雄数组(ib)
            If IsNumeric(zkCard) <> - 1  Then 
                If 当前卡牌阵容(ia) = zkCard Then 
                    add调整顺序后识别到的英雄数组(zkCard)
                    If IsNumeric(调整顺序后识别到的英雄数组(2)) <> - 1  Then
                        Exit Sub
                    End If
                End If
            End If
        Next
    Next
    
End Sub

Function add调整顺序后识别到的英雄数组(card)
    Dim  booljlAdd,iz,z
    booljlAdd = 0
    For iz = 0 To 2
        If card = 调整顺序后识别到的英雄数组(iz)  Then 
            booljlAdd = 1
            Exit For
        End If
    Next
	
    If booljlAdd = 0 Then 
        For iz = 0 To 2
            z = 调整顺序后识别到的英雄数组(iz)
            If IsNumeric(z) = -1  Then 
                调整顺序后识别到的英雄数组(iz) = card
                Exit For
            End If
        Next	
    End If	
		
End Function

