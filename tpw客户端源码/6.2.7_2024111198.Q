卡组上下图标坐标 = ""
Function 卡组图片识别()
    卡组图片识别 = 0 
    //新版老版判断
	
	
    //老版本
    For 3
        dm.Delay 50	
        dm_ret = dm.FindPic(404,64,443,100, "卡组上图标1.bmp|卡组上图标2.bmp|卡组下图标1.bmp|卡组下图标2.bmp", "101010", 0.85, 0, intX, intY)
        If intX >= 0 and intY >= 0 Then 
            小程序旧版 = 1
            TracePrint "小程序旧版"
            MessageBox "你的微信不是最新版本，请更新微信"
            ExitScript		
            Exit For
        End If
    Next
	
    //新版本
    For 3
		
        dm.Delay 50	
        dm_ret = dm.FindPic(404,64,443,100, "卡组图标上1_x.bmp|卡组图标上2_x.bmp|卡组图标下1_x.bmp|卡组图标下2_x.bmp|卡组上图标3.bmp|卡组下图标3.bmp|特殊卡组标识下.bmp", "050505", 0.65, 0, intX, intY)
        If intX >= 0 and intY >= 0 Then 
            小程序新版 = 1
            TracePrint "小程序新版"
            Exit For
        End If
    Next
	
    If 小程序新版 = 0 and 小程序旧版 = 0 Then 
        Exit Function
    End If
	
	
    dm.Delay 60
    //dm_ret = dm.FindPic(404,64,443,100, "卡组上图标1.bmp|卡组上图标2.bmp|卡组上图标3.bmp", "101010", 0.85, 0, intX, intY)
    //卡组上面标识
    dm_ret = dm.FindColorBlock(416,82,437,94,"ffd736-050505",0.85,95,21,12,intX,intY)
    If intX >= 0 and intY >= 0 Then 
        卡组图片识别 = 1
        卡组上下图标坐标 = 425 & "," & 82
        Exit Function
    End If
    dm.Delay 60
    //dm_ret = dm.FindPic(404,64,443,100, "卡组下图标1.bmp|卡组下图标2.bmp|卡组下图标3.bmp", "101010", 0.85, 0, intX, intY)
    //卡组下面标识
    dm_ret = dm.FindColorBlock(415,70,437,85,"ffd736-050505",0.85,95,22,15,intX,intY)
    If intX >= 0 and intY >= 0 Then 
        卡组图片识别 = 2
        卡组上下图标坐标 = 425 & "," & 82
        Exit Function
    End If
	
End Function

Function 选择出战卡组(tag)
    dm.Delay 50
    dm_ret = remoteFindPic("关闭红叉标志.tif", "776,102,828,136", 0.8, 1)
    If len(dm_ret) > 0  Then
        Call MoveToFcn(804,119)
        dm.Delay 50
        dm.LeftClick 
        TracePrint "检查到头像红叉"
    End If
    
    //点击主界面英雄图标
    For kzxzi = 0 To 6
        dm.Delay 2000
        If 卡组图片识别() = 0 Then 
            dm.Delay 200
            Call MoveToFcn(976,317)
            dm.Delay 150
            dm.LeftClick 
            dm.Delay 1500
            dm.Delay 50
            dm_ret = remoteFindPic("关闭红叉标志.tif", "776,102,828,136", 0.8, 1)
            If len(dm_ret) > 0  Then
                Call MoveToFcn(804,119)
                dm.Delay 50
                dm.LeftClick 
                TracePrint "检查到头像红叉"
            End If
            If kzxzi > 4 Then 
                MessageBox  "环境没配置好，请不要进入对战和合作，不然识别会有误差，请中止程序，如果你不是win7系统，请检查腾讯助手或者微信是否兼容过win7，如果已兼容，如果是腾讯助手，必须要右键退出，再进即可"
            End If
        Else 
            Exit For
        End If
    Next

    //1 对战 ， 2 降杯，3 合作，4 寒冰
    If tag = 1 Then 
        index = 对战卡组()	
    ElseIf tag = 2 Then
        index = 降杯卡组()
    ElseIf tag = 3 Then
        index = 合作卡组()
    ElseIf tag = 4 Then
        index = 寒冰卡组()
    End If
    TracePrint "index:"&index
    If index > 5 Then 
        For 5
            卡组图片识别结果 = 卡组图片识别()
            TracePrint "卡组上下图标坐标:"&卡组上下图标坐标
            If  卡组图片识别结果 = 1 Then 
                Exit For
            ElseIf 卡组图片识别结果 <> 0 Then
                坐标数组 = Split(Trim(卡组上下图标坐标), ",")
                Call MoveToFcn(Int(坐标数组(0)), Int(坐标数组(1)))
                dm.Delay 150
                dm.LeftClick 
                dm.Delay 2000
            End If
        Next
        index = index - 5
    Else
        For 5
            卡组图片识别结果 = 卡组图片识别()
            TracePrint "卡组上下图标坐标:"&卡组上下图标坐标
            If  卡组图片识别结果 = 2 Then 
                Exit For
            ElseIf 卡组图片识别结果 <> 0 Then
                坐标数组 = Split(Trim(卡组上下图标坐标), ",")
                Call MoveToFcn(Int(坐标数组(0)), Int(坐标数组(1)))
                dm.Delay 150
                dm.LeftClick 
                dm.Delay 2000
            End If
        Next		
    End If
		
	
    坐标 = 出战卡组坐标数组(index - 1)	

    坐标数组 = Split(Trim(坐标), ",")
	
    Call MoveToFcn(Int(坐标数组(0)), Int(坐标数组(1)))	
    dm.Delay 200
    dm.LeftClick 
    dm.Delay 1000
    Call MoveToFcn(Int(坐标数组(0)), Int(坐标数组(1)))
    dm.LeftClick 
    dm.Delay 200 
    Call 返回关闭()
 	
    dm.Delay 1000 
    If 返回主页面按钮() = 1 Then 
        dm.Delay 3000
        Call 返回关闭()
 		
        dm.Delay 1000
        dm_ret = remoteFindPic("关闭红叉标志.tif", "776,102,828,136", 0.8, 1)
        If len(dm_ret) > 0  Then
            Call MoveToFcn(804,119)
            dm.Delay 50
            dm.LeftClick 
            TracePrint "检查到头像红叉"
        End If
    End If
 	
    dm.Delay 100
    dm_ret = remoteFindPic("关闭红叉标志.tif", "776,102,828,136", 0.8, 1)
    If  len(dm_ret) > 0  Then
        Call MoveToFcn(804,119)
        dm.Delay 50
        dm.LeftClick 
        TracePrint "检查到头像红叉"
    End If
End Function


