    TracePrint "默认初始装备:" & 默认初始装备

    If 寒冰ck = 0 Then 
        Call 暂停寒冰99点名识别子线程()
    End If
   


    已有英雄多次判断 = 0
    卡牌已删除 = 0
    //寒冰 or 合作 
    If 助战合作ck = 1 or 寒冰ck = 1 Then 
        If 寒冰好友房间自动识别ck = 0 and 寒冰微信自动识别ck = 0 and 双开自动完成3次寒冰ck = 0 and 合作自动发送房间给好友ck = 0 and 寒冰自动发送房间给好友ck = 0 Then
            If 助战合作ck = 1 Then 
                MessageBox "助战合作模式已开始！输入房间号或者创建房间号，等待进入战场即可"
            Else 
                MessageBox "寒冰已开始！输入房间号或者创建房间号，等待进入战场即可"
            End If
		
            ishezuoli = 0
            While ishezuoli = 0
                dm.Delay 2000
                ishezuoli = 判断当前是否在战场中()
                当前在战斗 = ishezuoli
                TracePrint 助战合作ck & ":助战模式等待：" & 寒冰ck
            Wend
		
            If ishezuoli = 1 Then 
                If getCard("幻精灵") = 0 Then 
                    装备切换 = - 1 
                ElseIf 默认初始装备 = "无" Then
                    装备切换 = 1			
                End If
                //合作标志 = 1
                Call 合作标志Handle(1)
                扩建控制 = 合作前期扩建允许次数
            End If
        End If	
    Else
        Dim kpzxi, kpzxHave,对战按钮识别i
        kpzxHave = 0
        对战按钮识别i = 0
        While 对战按钮识别i = 0
            dm.Delay 1000
            对战按钮识别i = 主界面对战按钮()
            TracePrint "等待游戏主界面...."
        Wend
    End If





 
    TracePrint "已识别到游戏主界面....."
    respost = post_url("", "http://127.0.0.1:"& pyport & "/getIslogin")
    If  len(respost) <= 0 Then 
        MessageBox "服务端异常，请检查服务端是否已登录"
        TracePrint "服务端异常，请检查服务端是否已登录"
        注册码校验结果 = -9
    End If

    辅助开始执行时间 = 辅助开始执行时间()
    TracePrint "辅助开始执行时间:" & 辅助开始执行时间

    If Int(辅助开始执行时间) > - 1 and 注册码校验结果 > -1  Then 
        MessageBox "你已选择，" & Int(辅助开始执行时间) & " 点执行辅助，现在开始等待到该时间点，才执行操作，如果确认无误，请点确定"
        Do
            If  Int(辅助开始执行时间) = Int(Hour(Now)) Then 
                TracePrint "到时间了，退出循环，开始执行...."
                Exit Do
            End If
            TracePrint "等待 "& 辅助开始执行时间 & " 点运行...."
            //睡眠10分钟
            dm.Delay 600000
        Loop
    End If

    Do While  注册码校验结果 > -1

        If 当前在战斗 = 0 Then 
            isbool = 0
            If 联盟自动抢房间ck = 0 and 好友房间自动识别ck = 0 and 微信房间自动识别ck = 0 and 双开自动完成6次合作ck = 0 and 是否合作刷金币 = 1 Then 
                isbool = 世界频道社交()
            End If
			
            If 寒冰ck = 1 Then 
                isbool = 1
            End If
			
            If 主界面对战按钮() = 1 or isbool = 1 Then 
                If 寒冰好友房间自动识别ck = 0 and 寒冰微信自动识别ck = 0 and 双开自动完成3次寒冰ck = 0 and 合作自动发送房间给好友ck = 0 and 寒冰自动发送房间给好友ck = 0 Then
                    If 助战合作ck = 1 or  寒冰ck = 1 Then 
                        ishezuoli = 判断当前是否在战场中()
                        While ishezuoli = 0
                            dm.Delay 2000
                            ishezuoli = 判断当前是否在战场中()
                            当前在战斗 = ishezuoli
                        Wend
						
                        If ishezuoli = 1 Then 
                            Call paramInit()
                            If getCard("幻精灵") = 0 Then 
                                装备切换 = - 1 
                            ElseIf 默认初始装备 = "无" Then
                                装备切换 = 1			
                            End If
                            Call 合作标志Handle(1)
                            扩建控制 = 合作前期扩建允许次数
                        End If	
                    End If
                End If	
                TracePrint "主界面页面..."
				
                If 降杯ck = 1 Then 
                    If 三千杯子() = 0 Then 
                        Call 降杯(0)
                    Else 
                        If 对战120次且降完杯后电脑关机ck = 1 Then 
                            TracePrint "当前对战战120次降完分,执行关机"
                            Call Plugin.Sys.ExitOS(1)
                            Delay 100
                            dm_ret1 = dm.ExitOs(1)
                            ExitScript
                        End If
                    End If
                End If
	
                If  社交喊话ck = 1 or 世界喊话ck = 1 Then 
                    Call 世界社交喊话()
                ElseIf 联盟自动抢房间ck = 1 Then 
                    Call 联盟频道合作()
                ElseIf 好友房间自动识别ck = 1 Then 
                    Call 好友房间合作(0)
                ElseIf 寒冰好友房间自动识别ck = 1 Then 
                    Call 好友房间寒冰()    
                ElseIf 微信房间自动识别ck = 1 Then 
                    Call 微信房间合作()
                ElseIf 寒冰微信自动识别ck = 1 Then 
                    Call 微信房间寒冰()    
                ElseIf 双开自动完成6次合作ck = 1 Then 
                    Call 双开自动完成6次合作()
                ElseIf 双开自动完成3次寒冰ck = 1 Then 
                    Call 双开自动完成6次寒冰()
                ElseIf 合作自动发送房间给好友ck = 1 Then 
                    Call 创建房间发送给好友()
                ElseIf 寒冰自动发送房间给好友ck = 1 Then 
                    Call 寒冰创建房间发送给好友() 
                ElseIf 是否合作刷金币 = 1 Then 
                    Call 世界频道合作()	
                Else 
                    If ggjlv = 1 Then 
                        dm.Delay 50
                        Call 广告奖励()
                    End If
    			
                    If cqsjv = 1 Then 
                        dm.Delay 50
                        Call 传奇赛季()
                    End If
    				
                    If txzv = 1 Then 
                        dm.Delay 50
                        Call 通行证()
                    End If
    				
                    If rwv = 1 Then 
                        dm.Delay 50
                        Call 任务()
                    End If
    				
                    If shoop = 1 Then 
                        dm.Delay 50
                        //Call 商店执行()
                    End If
    
    			
                    //联盟钻石捐献
                    If lianmengzsjxcount = 0 Then 
                        dm.Delay 50
                        lianmengzsjxcount = lianmengzsjx()
                    End If
    				
                    If 联盟宝箱领取ck = 1 Then 
                        dm.Delay 50
                        Call 联盟宝箱领取()
                    End If
    				
                    If 试炼场ck = 1 Then 
                        dm.Delay 50
                        Call 试炼场()
                    End If
        
                End If
			
                dm.Delay 200
                dm_ret = remoteFindPic("关闭红叉标志.tif", "776,102,828,136", 0.8, 1)
                If len(dm_ret) > 0  Then
                    Call MoveToFcn(804,119)
                    dm.Delay 50
                    dm.LeftClick 
                    TracePrint "检查到头像红叉"
                End If
    		
            End If
        End If	
	
	
        If 当前在战斗 = 0 and 是否合作刷金币 = 0 Then 
            Call 对战()
        End If
        //---------------------------------------------------开始

        If 当前在战斗 = 0 Then 
            If 是否出现快速匹配() = 1 Then 
                If 合作未打完弹窗() = 1 Then 
                    TracePrint "出现误点合作"
                    Call MoveToFcn(809,155)
                    dm.Delay 500
                    dm.LeftClick 
                    dm.Delay 500
                    Call 对战()
                    dm.Delay 1000
                Else	
                    第二天凌晨 = 是否是第二天凌晨(0)
                    If 对战ck = 0 Then 
                        Call MoveToFcn(804,154)
                        dm.Delay 100
                        dm.LeftClick 
                        Form1.CheckBox14.Value = 0
                        Form1.CheckBox27.value = 1
                        对战ck = 1
                        降杯ck = 0
                        是否合作刷金币 = 0
     			
                        dm.Delay 3000
                        For 3
                            Call 选择出战卡组(1)
                        Next
     				
                        dm.Delay 1000
                        Call 卡牌阵容初始化()
                        //是否已选择出战卡组 = 1
                    Else 
                        第二天凌晨 = 是否是第二天凌晨(30)
                        //凌晨终止辅助
                        If 停止辅助23点30ck = 1 Then 
                            If 第二天凌晨 = 1 Then 
                                TracePrint "已执行23:30停止辅助"
                                ExitScript 
                                MessageBox "凌晨终止辅助"
                            End If		
                        End If
    				
                        If Int(辅助中止时间点) > - 1  Then 
                            If  Int(辅助中止时间点) = Int(Hour(Now)) Then 
                                TracePrint "已执行辅助中止时间点：" & 辅助中止时间点
                                ExitScript
                            End If
                        End If
    				
                        Dim 是否已超过对战次
                        是否已超过对战次 = 0
                        If 对战次数统计 >= 对战次数控制 Then 
                            TracePrint "已超过对战次"
                            是否已超过对战次 = 1
                            Call MoveToFcn(804+获取随机数(5),154+获取随机数(5))
                            dm.Delay 100
                            dm.LeftClick 
    					
                            If 对战120次电脑关机ck = 1 Then 
                                TracePrint "当前对战战120次,执行关机"
    		 				
                                Call Plugin.Sys.ExitOS(1)
                                Delay 100
                                dm_ret1 = dm.ExitOs(1)
                                ExitScript
                            End If
                        Else 
                            dm.Delay 200
                            Call MoveToFcn(701,524)
                            dm.Delay 100
                            dm.LeftClick 
                        End If
    				
                        //自动降杯判断
                        If 是否已超过对战次 = 0 Then 
                            是否已超过对战次 = 已超过对战次数继续(1)
                        End If
    				
                        If 对战120次电脑关机ck = 1 and 是否已超过对战次 = 1 Then 
                            TracePrint "当前对战战120次,执行关机"
                            Call Plugin.Sys.ExitOS(1)
                            Delay 100
                            dm_ret1 = dm.ExitOs(1)
                            ExitScript
                        End If
    				
                        If 是否已超过对战次 = 1 and 第二天凌晨 = 1 Then 
                            //睡眠10分钟
                            dm.Delay 600000
                        End If
    
                        If 只对战ck = 0 Then 
    					
                            //是否已超过对战次 = 0
                            If 是否对战次数完后降杯刷合作 = 1 and 是否已超过对战次 = 1 Then 
                                是否三千杯子 = 三千杯子()
                                If 上分不降杯 = 0 and 是否三千杯子 = 0 Then 
                                    TracePrint "满足条件，进行降杯"
                                    dm.Delay 1000
                                    Call 联盟宝箱领取()
                                    dm.Delay 3000
                                    //选择降杯 		
                                    Form1.CheckBox14.value = 1
                                    对战ck = 0
                                    降杯ck = 1
                                    是否合作刷金币 = 0
				
                                    dm.Delay 3000
                                    For 3
                                        Call 选择出战卡组(2)
                                    Next
								
                                    //Call 卡牌阵容初始化()
                                    Form1.CheckBox27.Value = 0
                                    dm.Delay 3000
                                Else 	
                                    //自动合作判断
                                    If 是否三千杯子 = 1 or 上分不降杯 = 1 Then 
                                        Dim is去合作
                                        is去合作 = 0
                                        If 强制合作ck = 1 Then 
                                            is去合作 = 1
										
                                        Else 
                                            If 第二天凌晨 = 0  Then 
                                                六次合作打完 = 是否六次合作打完()
                                                If 六次合作打完 = 1 Then 
                                                    is去合作 = 1
     					
                                                End If	
                                            End If
										
                                        End If
									
                                        If is去合作 = 1 Then 
                                            TracePrint "满足条件，进行合作"
                                            dm.Delay 3000
                                            Form1.CheckBox14.value = 0
                                            //选择法师队伍
                                            Form1.CheckBox16.Value = 1
                                            对战ck = 0
                                            降杯ck = 0
                                            是否合作刷金币 = 1
                                            //选择合作卡牌
                                            For 3
                                                Call 选择出战卡组(3)	
                                            Next
     									
     									
                                            dm.Delay 500
                                            TracePrint "满足条件，卡牌阵容初始化"
                                            Call 卡牌阵容初始化()
                                        End If
     								
                                    End If
				
                                End If
                            End If	
                        End If
                    End If	
		
    			
                    If 对战ck = 1 Then 
                        //进入战场要等待一段时间
                        TracePrint "开始进入战场...."
                        If 是否合作刷金币 = 0 and 降杯ck = 0 Then 
                            Dim 对战中i,循环次数统计a
                            循环次数统计a = 0
                            对战中i = 0
                            While 对战中i = 0
                                TracePrint "循环对战等待中...."
                                dm.Delay 350
                                对战中i = 判断当前是否在战场中()
                                循环次数统计a = 循环次数统计a + 1
                                If 循环次数统计a > 250 Then 
                                    对战中i = 1
                                End If
                            Wend
    					
    					
                            //开始对战后，等待一段时间如果没开始，就退出
                            If 循环次数统计a > 100 Then 
                                dm.Delay 50
                                dm_ret = dm.FindColorBlock(452,383,494,411,"ffc431-050505",0.85,900,42,28,intX,intY)
                                If intX > 0 and intY > 0 Then  
                                    Call MoveToFcn(515,392)
                                    dm.Delay 100
                                    dm.LeftClick 
                                End If
							
                                //对战出现没匹配到对手时，退出
                                dm.Delay 50
                                If 对战异常结束确定() = 1 Then 
                                    dm.Delay 1000
                                    TracePrint "对战出现没匹配到对手时，退出"
                                    Call MoveToFcn(515,535)
                                    dm.Delay 100
                                    dm.LeftClick 
                                End If
							
                            Else 
                                dm.Delay 1000
                            End If
                        End If
                    End If
    			
                End If
            End If
        End If

        If 当前在战斗 = 0 Then 
            当前在战斗 = 判断当前是否在战场中()
            TracePrint "当前在战斗:::" & 当前在战斗
            If 当前在战斗 = 0 Then 
                For 50
                    TracePrint "判断是否已进入战场...."
                    If 判断当前是否在战场中() = 1 Then 
                        当前在战斗 = 1
                        TracePrint "当前再战斗中了...."
                        Exit For
                    End If
                    If 对战结束确定() = 1 Then 
                        当前在战斗 = 0
                        TracePrint "对战或者合作结束了1！"
                        Exit For
                    End If
				
                    If get试炼场标志() = 1 Then 
                        If 退出试炼() = 1 Then 
                            Exit For
                        End If
                    End If
                    dm.Delay 300
                Next
            End If
        End If
	
        If get对战标志() = 0 and get合作标志() = 0 and 对战ck = 1 Then 
            TracePrint "初始化对战标志"
            Dim is对战标志
            is对战标志 = 判断当前是否在对战中()
            TracePrint "is对战标志：" & is对战标志
            Call 对战标志Handle(is对战标志)
        End If

        If get试炼场标志() = 1  Then 
            当前在战斗 = 判断当前是否在战场中()
            If 当前在战斗 = 0 Then 
                TracePrint "试炼结束..."
                dm.Delay 100
                If 返回主页面按钮() = 1 Then 
                    TracePrint "试炼初始化"
                    dm.Delay 100
                    Call 卡牌阵容初始化()
                    dm.Delay 100
                    //变量初始化
                    Call paramInit()
				
                End If
			
		
                If 退出试炼() = 1 Then 
                    TracePrint "退出试炼"
                    For 2
                        dm.Delay 200
                        Call MoveToFcn(678,544)
                        dm.Delay 200
                        dm.LeftClick 
                    Next

                    For 3
                        Delay 2000
                        If 返回主页面按钮() = 1 Then 
                            dm.Delay 3000
                            Call 返回关闭()
                            Exit For
                        End If
                    Next
                    Delay 1000
                    Call 试炼场()
                End If
            End If
        End If
         
         
        If 当前在战斗 = 0 Then 	
            TracePrint "我不在对战中...."
            Call 已超过对战次数继续(1)
            If 合作助战弹窗() = 1 Then 
                Call MoveToFcn(699,221)
                dm.Delay 50
                dm.LeftClick 	
            End If
		
            If 合作未打完弹窗() = 1 Then 
                Call MoveToFcn(809,155)
                dm.Delay 50
                dm.LeftClick 
            End If
        End If
        
		If 骰子识别开始 = 0 Then 
			Call 卡牌面板关闭dm()
		End If
       
		
		
        //合作一些处理逻辑
        If 当前在战斗 = 1 and get合作标志() = 1 Then 

            If 自动补木 = 1 Then 
                If 合作血条判断(5) = 1 Then 
                    TracePrint "满足血量等于50%，可以使用木精灵"
                    Call add合作中可使用精灵("木精灵",0)
                Else 
                    TracePrint "不满足血量移除木精灵"
                    Call 删除合作中可使用精灵("木精灵")
                End If
            End If
       		
            If 自动补魂 = 1  Then 
                If 合作血条判断(5) = 1 Then 
                    TracePrint "满足血量等于50%，可以使用魂精灵"
                    Call add合作中可使用精灵("魂精灵",0)
                Else 
                    TracePrint "不满足血量移除魂精灵"
                    Call 删除合作中可使用精灵("魂精灵")
                End If
            End If

            is往下执行 = 1
            If 骰子随缘上卡ck = 1 and 骰子识别开始 = 1 Then 
                is往下执行 = 0
            End If
		
            If is往下执行 = 1
		
                Call 装备变更()

                If 英雄不点击查看 = 1 Then 
                    TracePrint  "英雄不点击查看:" 
                    Call 合作卡牌升满统计(0)
                Else
                    If 寒冰ck = 0  and  合作满星检查关卡ck = 1  Then 
                        If Int(合作满星检查关卡) > 0 Then 
                            If 当前合作关卡 > Int(合作满星检查关卡) Then  
                                满星检测关卡 = Int(合作满星检查关卡)
                                Call 卡牌升满统计()
                            End If
                        End If
                    ElseIf  寒冰ck = 1  Then
                        If 寒冰满星检查关卡ck = 1 Then 
                            If Int(寒冰满星检查关卡) > 0 Then 
                                If 当前合作关卡 > Int(寒冰满星检查关卡) Then 
                                    满星检测关卡 = Int(寒冰满星检查关卡)
                                    Call 卡牌升满统计()
                                End If
                            End If
                        Else 
                            If 是否带了光精灵 = 1 and 当前合作关卡 > 11 Then 
                                满星检测关卡 = 11
                                Call 卡牌升满统计()
                            ElseIf 当前合作关卡 > 15 Then
                                满星检测关卡 = 15
                                Call 卡牌升满统计()
                            End If		
                        End If
					
                    Else 
                        If 是否带了光精灵 = 1 and 当前合作关卡 > 35 Then 
                            满星检测关卡 = 35
                            Call 卡牌升满统计()
                        ElseIf 当前合作关卡 > 45 Then
                            满星检测关卡 = 45
                            Call 卡牌升满统计()
                        End If
                    End If
                    TracePrint "满星检测关卡:" & 满星检测关卡
                End If
			
                光精灵暂时不使用 = 0
                
                If 装备切换 <> 0 and 卡牌是否全部升满 = 1 and 精灵使用 = 1 Then 
                    Call 精灵控制执行()
                End If

                If 寒冰ck = 1 and 寒冰99识别ck = 1 and 当前合作关卡 >= 96 and 当前合作关卡 < 108 Then 
                    Call 当前合作关卡Handle(当前合作关卡)
                    If 当前合作关卡 >= 96 and 当前合作关卡 <= 99 Then 
                        If 是否动寒冰99点名 = 0 Then 
                            寒冰99点名不上英雄数组临时备份 = 不上的卡牌数组
                            寒冰99点名不满英雄数组临时备份 = 前期不满的英雄
                            //Call 继续寒冰99点名识别子线程()
                            是否动寒冰99点名 = 1
                        End If	
                    End If
				
                    If 当前合作关卡 >= 98 and 当前合作关卡 <= 99 and 是否停止寒冰99点名 = 0 Then
                        Call 寒冰99下卡上卡操作()
                    End If
				
                    If 当前合作关卡 >= 100 and 当前合作关卡 <= 105 Then 
                        If 是否停止寒冰99点名 = 0 Then 
                            Call 寒冰99点名识别Handle("")
                            是否停止寒冰99点名 = 1
                        End If	
                    End If
				
				
                    If 是否停止寒冰99点名 = 1 Then 
                        TracePrint "龙王寒冰点名操作完后，还原上卡配置"
                        不上的卡牌数组 = 寒冰99点名不上英雄数组临时备份
                        前期不满的英雄 = 寒冰99点名不满英雄数组临时备份
                        Dim 要处理的英雄
                        For i = 0 To 9
                            要处理的英雄 = 当前卡牌阵容(i)
                            If 获取不上的卡牌(要处理的英雄, 0) = 0 Then 
                                If 卡牌是否已上战车(要处理的英雄) = 0 Then 
                                    If UBound(Filter(精灵类数组, 要处理的英雄)) <> 0 Then 
                                        TracePrint "龙王寒冰点名操作完后，还原上卡配置英雄：" & 要处理的英雄
                                        If 获取不满的卡牌(要处理的英雄) = 1 Then 
                                            Call 卡牌下架("无", 要处理的英雄, "不满",0,1)
                                        Else
                                            Call 卡牌下架("无",要处理的英雄, "满",0,1)
                                        End If
                                    End If
                                End If	
                            End If	
                        Next
                        是否停止寒冰99点名 = 2	
                    End If
                End If
                
                If 寒冰ck = 1 and 寒冰159识别ck = 1 and 当前合作关卡 >= 157 and 当前合作关卡 < 163 Then 
                    Call 当前合作关卡Handle(当前合作关卡)
                    If 当前合作关卡 >= 157 and 当前合作关卡 <= 159 Then 
                        If 是否动寒冰99点名 = 0 Then 
                            寒冰99点名不上英雄数组临时备份 = 不上的卡牌数组
                            寒冰99点名不满英雄数组临时备份 = 前期不满的英雄
                            //Call 继续寒冰99点名识别子线程()
                            是否动寒冰99点名 = 1
                        End If	
                    End If
				
                    If 当前合作关卡 >= 98 and 当前合作关卡 <= 99 and 是否停止寒冰99点名 = 0 Then
                        Call 寒冰99下卡上卡操作()
                    End If
				
                    If 当前合作关卡 >= 100 and 当前合作关卡 <= 105 Then 
                        If 是否停止寒冰99点名 = 0 Then 
                            Call 寒冰99点名识别Handle("")
                            是否停止寒冰99点名 = 1
                        End If	
                    End If
				
				
                    If 是否停止寒冰99点名 = 1 Then 
                        TracePrint "龙王寒冰点名操作完后，还原上卡配置"
                        不上的卡牌数组 = 寒冰99点名不上英雄数组临时备份
                        前期不满的英雄 = 寒冰99点名不满英雄数组临时备份
                        要处理的英雄
                        For i = 0 To 9
                            要处理的英雄 = 当前卡牌阵容(i)
                            If 获取不上的卡牌(要处理的英雄, 0) = 0 Then 
                                If 卡牌是否已上战车(要处理的英雄) = 0 Then 
                                    If UBound(Filter(精灵类数组, 要处理的英雄)) <> 0 Then 
                                        TracePrint "龙王寒冰点名操作完后，还原上卡配置英雄：" & 要处理的英雄
                                        If 获取不满的卡牌(要处理的英雄) = 1 Then 
                                            Call 卡牌下架("无", 要处理的英雄, "不满",0,1)
                                        Else
                                            Call 卡牌下架("无",要处理的英雄, "满",0,1)
                                        End If
                                    End If
                                End If	
                            End If	
                        Next
                        是否停止寒冰99点名 = 2	
                    End If
                End If
      
                If 寒冰ck = 1 and 当前合作关卡 > 108 Then 

                    If 海妖换圣骑ck = 1 and 当前合作关卡 <= 123 Then
                        If 当前合作关卡 >= 119 and 当前合作关卡 <= 121 Then 
                            If 合作刷新判断() = 0 Then 
                                是否已提前刷出英雄 = 0
                                For 1000
                                    //血量低于40% ，进行加血
                                    If 合作血条判断(3) = 1 Then 
                                        TracePrint "血量低于40%，开始下海妖，上圣骑"
                                        If 卡牌下架(海妖换圣骑Str(0), 海妖换圣骑Str(1), "不满", 0,1) = 1 Then 
                                            Exit For
                                        End If
                						
                                    ElseIf 合作血条判断(-1 ) = 1 Then//血量高于90%换回海妖
                                        TracePrint "血量高于90%，开始下圣骑，上海妖"
                                        If 卡牌下架(海妖换圣骑Str(1), 海妖换圣骑Str(0), "不满", 0,1) = 1 Then 
                                            Exit For
                                        End If	
                                    End If
                                    dm.Delay 100
                                    TracePrint "循环等待海妖换骑士"
                                    If 获取关卡() > 121 Then 
                                        TracePrint "检测到海妖换圣骑已过，停止循环a"
                                        Exit For
                                    End If
                                    If 对战结束确定a() = 1 Then 
                                        当前在战斗 = 0
                                        Exit For
                                    End If
                                    If 是否已提前刷出英雄 = 0 Then 
                                        If 卡牌是否已上战车(海妖换圣骑Str(0)) = 0 Then 
                                            是否已提前刷出英雄 =  提前刷出英雄(海妖换圣骑Str(0))
                                        ElseIf 卡牌是否已上战车(海妖换圣骑Str(1)) = 0 Then 
                                            是否已提前刷出英雄 =  提前刷出英雄(海妖换圣骑Str(1))
                                        End If
                                    End If
                	
                                Next
                            Else 
                                //血量低于50% ，进行加血
                                If 合作血条判断(4) = 1 Then 
                                    TracePrint "血量低于50%，开始下海妖，上圣骑"
                                    Call 卡牌下架(海妖换圣骑Str(0), 海妖换圣骑Str(1), "不满", 0,1)
                                ElseIf 合作血条判断(-1 ) = 1 Then//血量高于90%换回海妖
                                    TracePrint "血量高于90%，开始下圣骑，上海妖"
                                    Call 卡牌下架(海妖换圣骑Str(1), 海妖换圣骑Str(0), "不满", 0,1)
                                End If
                            End If
                			
                        End If
                		
               
                        If 当前合作关卡 >= 122 and 当前合作关卡 <= 123 and 验证执行(0) = 0 Then 
                            TracePrint "过了119了，检查海妖是否满级"
                            If 获取不满的卡牌(要下的英雄) = 1 Then 
                                TracePrint "过了119了，检查开始下圣骑，上海妖，不满"
                                Call 卡牌下架(海妖换圣骑Str(1), 海妖换圣骑Str(0), "不满", 0,1)
                            Else 
                                TracePrint "过了119了，检查开始下圣骑，上海妖，满"
                                Call 卡牌下架(海妖换圣骑Str(1), 海妖换圣骑Str(0), "满", 0, 1)
                                Call 合作要升满的英雄判断("120", "124", "无", 海妖换圣骑Str(0))
                            End If	
                            验证执行(0) = 1
                        End If
                		
                    End If

                    Call 当前合作关卡Handle(当前合作关卡)
                    If 当前合作关卡 >= 128 and 当前合作关卡 <= 132 and 寒冰129点名自动上下卡ck = 1 Then 
                        Call 当前合作关卡Handle(129)
                        Rem 船长点名下卡
                        TracePrint "获取船长点名"
                        position = get船长点名()
                        If len(position) = 0 Then 
                            If  装备切换 <> 0 and 卡牌是否全部升满 = 1  Then
                                For 1000
                                    position = get船长点名()
                                    If len(position) > 0 Then 
                                        TracePrint "成功等待船长点名"
                                        Exit For
                                    End If
                                    If 获取关卡() > 131 Then 
                                        TracePrint "检测到船长点名关卡已过，停止循环a"
                                        Exit For
                                    End If
                                    If 对战结束确定a() = 1 Then 
                                        当前在战斗 = 0
                                        Exit For
                                    End If
                                    dm.Delay 30
                                    TracePrint "循环等待get船长点名"
                                Next
                            End If
                        End If
                 		
                        If len(position) > 0 Then 
                            If Int(position) < 10 Then 
                                //根据坐标得到英雄名称
                                要下的英雄 = 战车卡牌位置数组(Int(position))
                                //执行下卡
                                Call 卡牌下架(要下的英雄, "无", "无", 0,1)
                                Call 船长点名Handle("")
                                //执行上卡
                                If 获取不满的卡牌(要下的英雄) = 1 Then 
                                    Call 卡牌下架("无", 要下的英雄, "不满",0,1)
                                Else
                                    Call 卡牌下架("无",要下的英雄, "满",0,1)
                                End If
                 				
                            Else 
                                Call 船长点名Handle("")
                                //船长喊话
                                If 自动补木 = 1
                                    //刷出木精灵等待
                                    TracePrint "刷出木精灵等待"
                                    Call 刷出精灵等待执行("木精灵")
                                Else 
                                    //睡眠12.5秒
                                    TracePrint "睡眠12.8秒"
                                    For 12
                                        dm.Delay 1050
                                        If 获取关卡() > 131 Then 
                                            TracePrint "检测到船长点名关卡已过，停止循环a"
                                            Exit For
                                        End If
                                        If 对战结束确定a() = 1 Then 
                                            当前在战斗 = 0
                                            Exit For
                                        End If
                                        If len(get船长点名()) > 0 Then 
                                            TracePrint "检测到船长点名，立即跳转"
                                            Goto 船长点名下卡
                                        End If
                                    Next
                 				
                                End If
                                If len(get船长点名()) > 0 Then 
                                    TracePrint "检测到船长点名，立即跳转"
                                    Goto 船长点名下卡
                                End If
                            End If
    
                        End If
                 		
                    End If
                 	
                 	
                    If 当前合作关卡 >= 148 and 当前合作关卡 < 150 and 寒冰149红篮球上下魇ck = 1 Then 
                 		
                        If get寒冰149统计() <= 6 Then 
                            For 150
                                If get寒冰149统计() <= 6  and   len(get寒冰149结果()) = 0 and 装备切换 <> 0 and 卡牌是否全部升满 = 1 Then 
                                    dm.Delay 100
                                    TracePrint "等待149识别球中。。。。"
                                Else
                                    Exit For
                                End If
                            Next
                        End If
                 		
                        If get寒冰149统计() <= 6 and  get寒冰149统计() > 0 Then 
                            If get寒冰149结果() = "红球" Then 
                                TracePrint "识别到红球上魇"
                                Call 卡牌下架("无", 寒冰149下Card, "不满", 0, 1)
                                Call 寒冰149Handle("")
                                If get寒冰149统计() = 6 Then 
                                    TracePrint "已处理了6个球了，=+1"
                                    Call 寒冰149统计Handle(7)
                                End If
                            ElseIf get寒冰149结果() = "蓝球" Then
                                TracePrint "识别到蓝球下魇"
                                Call 卡牌下架(寒冰149下Card, "无", "无", 0, 1)
                                Call 寒冰149Handle("")
                                For 10
                                    TracePrint "准备提前刷出："& 寒冰149下Card
                                    If 提前刷出英雄(寒冰149下Card) = 1 Then 
                                        TracePrint "提前刷出魇"
                                        For 150
                                            dm.Delay 300
                                            TracePrint "等待上魇"
                                            If len(get寒冰149结果()) > 0 Then 
                                                If get寒冰149结果() = "红球" Then 
                                                    TracePrint "是红球，上魇"
                                                    Call 卡牌下架("无", 寒冰149下Card, "不满", 0, 1)
                                                    Call 寒冰149Handle("")
                                                    TracePrint "等待结束"
                                                    Exit For
                                                End If
                                                TracePrint "等待不是红球，继续等待！"
                                            End If
                                            If 获取关卡() > 149 Then 
                                                TracePrint "检测到149名关卡已过，停止循环a"
                                                Exit For
                                            End If
                                            If get寒冰149统计() > 6 Then 
                                                TracePrint "已大于6次，结束"
                                                Exit For
                                            End If
                                            If get寒冰149统计() = 6 Then 
                                                TracePrint "等于6次结束循环，等待10秒"
                                                dm.Delay 8000
                                                Exit For
                                            End If
                                            If 对战结束确定a() = 1 Then 
                                                当前在战斗 = 0
                                                Exit For
                                            End If
                                        Next
                                        Exit For
                                    End If
                                    dm.Delay 50
                                    If 获取关卡() > 149 Then 
                                        TracePrint "检测149点名关卡已过，停止循环b"
                                        Exit For
                                    End If
                                    If 对战结束确定a() = 1 Then 
                                        当前在战斗 = 0
                                        Exit For
                                    End If
                                Next
                 				
                            End If
                            If get寒冰149统计() = 6 Then 
                                TracePrint "已处理了6个球了，=+1"
                                Call 寒冰149统计Handle(7)
                            End If
                        End If	
                        If get寒冰149统计() > 6 and get寒冰149统计() < 199 Then
                            TracePrint "处理了6个球了， 开始满魇"
                            Call 卡牌下架("无", 寒冰149下Card, "满", 0, 1)
                            Call 合作要升满的英雄判断("149", "153", "无", 寒冰149下Card)
                            Call 寒冰149统计Handle(200)
                        End If
                 		
                    End If
                 
                End If

            End If	
        End If

        If 当前在战斗 = 1 and  get合作标志() = 1 and 扩展次数 < 5  Then 
            If 光精灵使用次数 > 4 Then 
                光精灵暂时不使用 = 1
            End If
        End If
	
	
        If get合作标志() = 1 and 助战合作ck = 0 and 寒冰ck = 0  and 好友房间自动识别ck = 0 and 双开自动完成6次合作ck= 0 and 微信房间自动识别ck = 0  Then 
            当前是否在对战中 = 判断当前是否在对战中()
            If 当前是否在对战中 = 1 Then 
                TracePrint "合作中，进入了对战，执行退出"
                dm.Delay 100
                Call 对战中退出()
                dm.Delay 1000
                Call 对战中退出确认()
			
                当前在战斗 = 0
            End If	
        End If
		


        If 当前在战斗 = 1 and get合作标志() = 0 Then 
            If 对战有紫卡优先升级ck = 1 Then 
                Call 卡牌紫卡统计()
            End If

            Call 对战核心英雄动态调整()
            Call 控制英雄要上的格子(4) 	
            If get对战标志() = 1 Then 
                Call 对战木精灵血条()
            End If
        End If


        If  get合作标志() = 1 and  当前在战斗 = 1 Then 
            If 装备切换 = 0 and 是否带了幻精灵 = 1 Then 
                Call 装备识别(1)
                TracePrint "中途识别装备.."
            End If
        End If
        
        If 寒冰ck = 0 and 是否合作刷金币 = 1 and 当前在战斗 = 1 and  get合作标志() = 1 Then 
            If 当前合作关卡 >= 307 Then 
                Call 骰子下卡上卡操作()
            End If
        End If

        If 当前在战斗 = 1 Then 
            If 卡牌是否全部升满 = 1 Then 
                快速英雄识别结果 = 0
            End If
			
            If get合作标志() = 1 Then 
                If 合作刷新判断() = 1 Then 
                    刷出合作卡牌限制上战场 = 0
                    卡牌识别成功次数 = 0
                    是否识别为零 = 0
				

//                    If 卡牌全部升满记录 = 1 and 骰子识别开始 = 1 Then 
//                        TracePrint "卡牌全部升满记录-kpzxMax:" & kpzxMax
//                        If kpzxMax > 0 Then 
//                            For addbskpi = 0 To 6
//                                TracePrint "开始判断查询到不满的卡牌已经上战车1:" & 战车卡牌位置数组(addbskpi)
//                                If 战车上卡牌升级统计(addbskpi) > 0 and 战车上卡牌升级统计(addbskpi) < 3 Then 
//                                    TracePrint "开始判断查询到不满的卡牌已经上战车：" & 战车卡牌位置数组(addbskpi)
//                                    If 获取不满的卡牌(战车卡牌位置数组(addbskpi)) = 1 Then 
//                                        TracePrint "查询到不满的卡牌已经上战车，该英雄优先级降低：" & 战车卡牌位置数组(addbskpi)
//                                        Call 卡牌阵容排序(战车卡牌位置数组(addbskpi), kpzxMax)
//                                    End If
//                                End If
//                            Next
//                        End If
//                    End If
					

					
                    等待刷新次数 = 0
                    等待刷新次数A = 0
                    If 当前在战斗 = 1 Then 
                        If 卡牌全部升满记录 = 1  and 中途换卡加速ck = 1 and 扩展次数 >=5 Then 
                            TracePrint "进入快速识别"
                            Call cardFilter()
                            If len(卡牌阵容str) > 0 Then 
                    		
                                If 快速英雄识别结果 = 1 and 识别结果count = 1 and 骰子识别开始 = 0  Then 
                                    TracePrint "检查到快速识别上卡，延迟70毫秒"
                                    dm.Delay 70
                                End If
                    	    	
                    	    	
                                识别结果等于零次数 = 0
                                For 10
                                    快速英雄识别结果 = 0
                                    If len(get船长点名()) > 0 Then 
                                        TracePrint "检测到船长点名，立即停止刷新,跳转到下卡a"
                                        Goto 船长点名下卡 
                                    End If
	 								
                                    If 是否带了幻精灵 = 1 and 装备切换 = 0 and 卡牌是否全部升满 = 1 Then	
                                        If IsNumeric(合作中可使用精灵(0)) = 0 Then 
                                            If 装备识别(1) = 1 Then 
                                                Exit For
                                                TracePrint "装备切换成功了， 退出循环刷新"
                                            End If
                                        End If
                                    End If
	 								
                                    查看是否已满级 = 0
	 								
                                    If 寒冰ck = 1 and 当前合作关卡 >= 127 and 当前合作关卡 <= 129 and 寒冰129点名自动上下卡ck = 1 Then 
                                        TracePrint "进入船长识别处理，加速识别卡"
                                        For 3
                                            If len(get船长点名()) > 0 Then 
                                                TracePrint "进入船长识别处理，加速识别卡---检测到船长点名，立即停止刷新,跳转到下卡m"
                                                Goto 船长点名下卡 
                                            End If
                                            识别结果count = 快速英雄识别Test(1, 卡牌阵容str, 3, 0.85)
                                            If 识别结果count > 0 Then 
                                                TracePrint "进入船长识别处理，加速识别卡。识别到了，退出循环"
                                                Exit For
                                            End If
                                        Next
                                    Else
                                        识别结果count = 快速英雄识别Test(1, 卡牌阵容str, 11, 0.85)
                                    End If
	 								
	 								
	 								
                                    If len(get船长点名()) > 0 Then 
                                        TracePrint "检测到船长点名，立即停止刷新,跳转到下卡b"
                                        Goto 船长点名下卡 
                                    End If
	 								
                                    If 识别结果count > 1 Then 
                                        TracePrint "等待一段时间识别到了0000"
                                        等待刷新次数 = 0
                                        Dim 要识别的英雄数组,要识别的英雄数组Size,zki,zkCard,zkki,isYes
                                        isYes = 0	
                                        要识别的英雄数组 = split(卡牌阵容str, "|")
                                        要识别的英雄数组Size = UBound(要识别的英雄数组)
                                        For zkki = 0 To 要识别的英雄数组Size
                                            For zki = 0 To 2
                                                zkCard = 识别到的英雄数组(zki)
                                                If IsNumeric(zkCard) <> - 1  Then 
                                                    If 要识别的英雄数组(zkki) = zkCard Then 
                                                        TracePrint zki&"：位置，快速手牌没识别成功，正常手牌识别成功:" & zkCard
                                                        isYes = 1
                                                        识别到的英雄数组 = Array(0, 0, 0)
                                                        识别到的英雄数组(zki) = zkCard
                                                        If zkCard = "幻精灵" Then 
                                                            If 装备识别(1) = 1 Then 
                                                                isYes = 0
                                                                TracePrint "装备切换成功，中途记录a"
                                                            End If
                                                            TracePrint "装备识别判断：" & 查看是否已满级
                                                            TracePrint "识别到幻精灵，中途记录a"
                                                        End If
                                                        Exit For
                                                    End If
                                                End If
                                            Next
                                            If isYes = 1 Then 
                                                快速英雄识别结果 = 1
                                                Exit For
                                            End If
                                        Next

                                        If isYes = 0 Then 
                                            等待刷新次数 = 0
                                            查看是否已满级 = 1
                                            TracePrint "后补刷新aaaa...."
                                        Else 
                                            快速英雄识别结果 = 1
                                            Exit For	
                                        End If
                                    End If
	 								
                                    If len(get船长点名()) > 0 Then 
                                        TracePrint "检测到船长点名，立即停止刷新,跳转到下卡c"
                                        Goto 船长点名下卡 
                                    End If
	 								
                                    If 识别结果count = 0 Then 
                                        TracePrint "快速刷新a"
                                        Call 快速刷新(识别结果count)
                                        If 对战结束确定a() = 1 Then 
                                            当前在战斗 = 0
                                            Exit For
                                        End If
                                    End If
									
                                    If 识别结果count = 1 Then
                                        快速英雄识别结果 = 1
                                        If 是否带了幻精灵 = 1 and 装备切换 = 0 Then 
                                            If 识别到的英雄数组(0) = "幻精灵" Then 
                                                If 装备识别(1) = 1 Then 
                                                    查看是否已满级 = 1
                                                    快速英雄识别结果 = 0
                                                    TracePrint "装备切换成功，中途记录b"
                                                End If
                                                TracePrint "识别到幻精灵，中途记录b"
                                            End If
                                        End If
                                        If 快速英雄识别结果 = 1 Then 
                                            Exit For
                                        End If	
    										
                                    End If
									

                                    If 查看是否已满级 = 1 Then 	
                                        Call 合作卡牌升满统计(1)
                                        If 合作刷新判断() = 1 Then 
                                            识别结果等于零次数 = 0
                                            Call 快速刷新(识别结果count)
                                        Else 
                                            Exit For
                                        End If
                                    End If
		
                                Next
                            End If
	 						
                            If len(get船长点名()) > 0 Then 
                                TracePrint "检测到船长点名，立即停止刷新,跳转到下卡g"
                                Goto 船长点名下卡 
                            End If

                            If 快速英雄识别结果 = 1 Then 
				
                                For kpzxi = 0 To 2
                                    识别到的英雄card = 识别到的英雄数组(kpzxi)
                                    If IsNumeric(识别到的英雄card) = 0 Then 
                                        TracePrint "执行识别结果："  &  识别到的英雄card
                                        Call 卡牌执行(识别到的英雄card, 1)
                                        卡牌识别成功次数 = 卡牌识别成功次数 + 1
                                        Exit For
                            			
                                    End If
                                Next
                            End If	
                        Else 

                            快速英雄识别结果 = 0
                            If 英雄识别(0) < 3  Then 
                                TracePrint "未识别到英雄"
                                For 90
                                    快速英雄识别结果 = 0
                                    If 对战结束确定a() = 1 Then 
                                        等待刷新次数 = 0
                                        当前在战斗 = 0
                                        Exit For
                                    End If
									
                                    If 英雄识别(0) >= 3  Then 
                                        TracePrint "等待一段时间识别到了1"
                                        等待刷新次数 = 0
                                        Exit For		
                                    End If
                                	
                                	If 骰子识别开始 = 1 Then 
                                		TracePrint "骰子识别开始了，识别条件降低"
                                    	If 英雄识别(0) > 0 Then 
                                        	等待刷新次数A = 等待刷新次数A + 1
                                        	If 等待刷新次数A > 1 Then 
                                            	TracePrint "没识别到全部英雄，先使用部分英雄aaabb"
                                            	Exit For
                                        	End If
                                    	End If
                                	Else 
                                		dm.Delay 10
                                    	If 英雄识别(0) > 1 Then 
                                        	等待刷新次数A = 等待刷新次数A + 1
                                        	If 等待刷新次数A > 3 Then 
                                            	TracePrint "没识别到全部英雄，先使用部分英雄"
                                            	Exit For
                                        	End If
                                    	End If
                                	End If
                                    
                                	
                                    等待刷新次数 = 等待刷新次数 + 1
                                    If 等待刷新次数 >= 15 and 当前在战斗 = 1 Then 
                                        dm.Delay 10
                                        If 英雄识别(0) = 0 Then 
                                            Call 刷新()
                                            等待刷新次数 = 0
                                            TracePrint "后补刷新...."
                                        End If
                                    End If
                                Next
                            End If
                        	
                            Call 识别到的英雄排序()
                        
                            For kpzxi = 0 To 2
                                If IsNumeric(调整顺序后识别到的英雄数组(kpzxi)) = 0 Then 
                                    Call 卡牌执行(调整顺序后识别到的英雄数组(kpzxi), 1)
                                    卡牌识别成功次数 = 卡牌识别成功次数 + 1
                                    If 卡牌识别成功次数 > 2 Then 
                                        Exit For
                                    End If
                                End If
                            Next
                        		
                        End If

                    End If	

                End If
            Else 
				
                Call 对战卡牌升级识别()
				
                //这个得放后面
                Call 对战只升级一次的卡牌排序()

                If 小鹿是否排序到最后 = 0 or 小鹿是否排序到最后 = 1 Then 
                    If 战车上卡牌升级统计(5) > 0 Then 
                        TracePrint "战车6号位置已上英雄，把小鹿和冰法排序到最后"
                        If getCard("小鹿") Then 
                            对战要卖的卡牌数组max = UBound(对战要卖的卡牌数组)
                            For mki = 0 To 对战要卖的卡牌数组max
                                If 对战要卖的卡牌数组(mki) = "小鹿" Then 
                                    Call 卡牌阵容排序("小鹿", 9)
                                    小鹿是否排序到最后 = 2
                                    Call 删除核心英雄优先数组("小鹿")
                                    Call 新增对战不上的卡牌("小鹿")
                                    Exit For
                                End If
                            Next
                        Else 
                            小鹿是否排序到最后 = 2
                        End If
                    End If
                End If
				
                If 冰法是否排序到最后 = 0 or 冰法是否排序到最后 = 1 Then 
                    If 战车上卡牌升级统计(5) > 0 Then 
                        If getCard("冰法") Then 
                            对战要卖的卡牌数组max = UBound(对战要卖的卡牌数组)
                            Dim 是否有卖冰法
                            是否有卖冰法 = 0	
                            For mki = 0 To 对战要卖的卡牌数组max
                                If 对战要卖的卡牌数组(mki) = "冰法" Then 
                                    是否有卖冰法 = 1
                                    Call 卡牌阵容排序("冰法", 9)
                                    冰法是否排序到最后 = 2	
                                    Call 删除核心英雄优先数组("冰法")
                                    Call 新增对战不上的卡牌("冰法")
                                    Call 删除对战要卖的卡牌英雄("冰法")
                                    Exit For
                                End If
                            Next
                            If 是否有卖冰法 = 0 Then 
                                冰法是否排序到最后 = 2
                            End If
                        End If
                    End If
                End If	
				
				
                Call 对战英雄升满切换()

                刷出合作卡牌限制上战场 = 0
                卡牌识别成功次数 = 0
                是否识别为零 = 0
                当轮识别第一个英雄 = 0
                对战建筑未满是否升级一次满足条件 = 0
				
				
                等待刷新次数 = 0
                等待刷新次数A = 0
                If 当前在战斗 = 1 Then 
                    If 英雄识别(0) < 3  Then 
                        TracePrint "未识别到英雄"
                        For 90
                           
                            If 对战结束确定() = 1 Then 
                                等待刷新次数 = 0
                                当前在战斗 = 0
                                TracePrint "对战结束了.."
                                Exit For
                            End If
							
                            If 英雄识别(0) > 0 Then 
                                等待刷新次数A = 等待刷新次数A + 1
                                If 等待刷新次数A > 3 Then 
                                    TracePrint "没识别到全部英雄，先使用部分英雄"
                                    Exit For
                                End If
                            End If
                            
                            If 英雄识别(0) >= 3  Then 
                                TracePrint "等待一段时间识别到了1"
                                等待刷新次数 = 0
                                Exit For		
                            End If
							
                            等待刷新次数 = 等待刷新次数 + 1
                            If 等待刷新次数 >= 30 and 当前在战斗 = 1  Then 
                                If 英雄识别(0) = 0 Then 
                                    Call 刷新()
                                    等待刷新次数 = 0
                                    TracePrint "后补刷新...."
                                End If
                                TracePrint "后补刷新...."
                            End If
                        Next
                    End If
                End If	

                Call 识别到的英雄排序()
                
                For kpzxi = 0 To 2
                    If IsNumeric(调整顺序后识别到的英雄数组(kpzxi)) = 0 Then 
                        Call 卡牌执行(调整顺序后识别到的英雄数组(kpzxi), 1)
                        当轮识别第一个英雄 = 1
                        卡牌识别成功次数 = 卡牌识别成功次数 + 1	
                        If 卡牌识别成功次数 > 2 Then 
                            Exit For
                        End If
                    End If

                Next
            End If
        End If

        是否可以刷新 = 1
        If 当前在战斗 = 1 Then 
            If 卡牌识别成功次数 > 3 Then 
                是否可以刷新 = 0
            End If
            
            //待优化
            If  骰子识别开始 = 0 Then
            	If 合作中判断是否结束() = 1 Then 
                	dm.Delay 2000
                	If 对战结束确定() = 1 or 主界面对战按钮a() = 1 or 判断当前是否在主界面() = 1 or 返回主页面按钮() = 1 Then 
                    	TracePrint "对战或者合作结束了2！"
                    	当前在战斗 = 0
                    	Goto 合作结束标志
                	End If
            	End If
           End If
        End If

   
        If get合作标志() = 0 and 当前在战斗 = 1 and  卡牌识别成功次数 > 3  Then 
            Call 对战执行卖卡操作()	
        End If

        //刷新----------------------------------------------------刷新
        If 当前在战斗 = 1 and get合作标志() = 1 Then 
            If 合作刷新判断() = 1  Then 
                卡牌升满后执行刷新 = 0
                is刷新 = 0
                If 是否可以刷新 = 1 Then 
                    If 扩展次数 >= 5 or 卡牌识别成功次数 = 0 or 刷出合作卡牌限制上战场 >= 3 Then 
                        TracePrint "刷出合作卡牌限制上战场:"& 刷出合作卡牌限制上战场 &" --卡牌识别成功次数:："& 卡牌识别成功次数&" --装备切换:："& 装备切换&" --卡牌是否全部升满:："& 卡牌是否全部升满&" --IsNumeric(合作中可使用精灵(0)):："& IsNumeric(合作中可使用精灵(0))
                        is刷新 = 1
                    End If
                Else 
                    is刷新 = 1
                End If
			
                If is刷新 = 1 Then 
                    If 刷新() = 1 Then 
                        For 100
                            If 刷新() = 0 Then 
                                Exit For
                            End If
                            If 对战结束确定() = 1 Then 
                                当前在战斗 = 0
                                Exit For
                            End If
                            dm.Delay 1000
                        Next
                    End If	
                End If

            Else 
            	If 骰子识别开始 = 1 and 中途换卡加速ck = 1 Then 
            		TracePrint "骰子上卡结束后刷新"
            		If 快速英雄识别(0, 卡牌阵容初始值str, 0, 0.85) < 2 Then 
                    	Call 刷新()
                    End If
                Else    
                	//and 卡牌升满后执行刷新 = 0
                	If 卡牌是否全部升满 = 1 and 卡牌识别成功次数 > 3 Then 
                		
                    	If 快速英雄识别(0, 卡牌阵容初始值str, 0, 0.86) = 3 Then 
                        	卡牌识别成功次数 = 1
                    	Else 
                    		If 快速英雄识别(0, 卡牌阵容初始值str, 0, 0.85) = 0 Then 
                    			dm.Delay 1500
                    			If 快速英雄识别(0,卡牌阵容初始值str,0,0.85) = 0 Then
                        			卡牌识别成功次数 = 1
                        			If 刷新() = 1 Then 
                            			For 50
                                			If 刷新() = 0 Then 
                                    			卡牌升满后执行刷新 = 1
                                    			TracePrint "卡牌升满后执行刷新a"
                                    			Exit For
                                			End If
                                			If 对战结束确定() = 1 Then 
                                    			当前在战斗 = 0
                                    			Exit For
                                			End If
                                			dm.Delay 50
                            			Next
                        			Else 
                            			卡牌升满后执行刷新 = 1
                            			TracePrint "卡牌升满后执行刷新b"
                        			End If
                    			End If
                			End If
                    	End If 
                	End If
                End If	
                TracePrint "合作刷新条件不满足，装备切换,卡牌是否全部升满"  & 装备切换 & "," & 卡牌是否全部升满 
            End If
        ElseIf 当前在战斗 = 1 and  get合作标志() = 0 Then
            If 装备切换 = 0 or 卡牌是否全部升满 = 0 Then 
                is刷新 = 0
                If 是否可以刷新 = 1 Then 
                    If 卡牌识别成功次数 > 0 Then
                        卡牌识别成功次数 =卡牌识别成功次数 - 刷出合作卡牌限制上战场
                    End If
                    If 扩展次数 >= 5 or 卡牌识别成功次数 <= 0 or 刷出合作卡牌限制上战场 >= 3 Then 
                        is刷新 = 1
                    End If
                Else 
                    is刷新 = 1
                End If
					
                If is刷新 = 1 Then 
                    If 刷新() = 1 Then 
                        For 200
                            If 刷新() = 0 Then 
                                Exit For
                            Else 
                                Call 对战自动领取宝箱()
                            End If
                            If 对战结束确定() = 1 Then 
                                当前在战斗 = 0
                                Exit For
                            End If
                            dm.Delay 300
                        Next
                    End If
                End If
                Call 对战自动领取宝箱()

            Else 
		
            End If
        End If
	
        If 骰子识别开始 = 0 and  当前在战斗 = 1 and 开启日志 = 0 Then 
            TracePrint "刷新后的战车上卡牌升级统计:"
            Call get战车上卡牌升级统计()
            TracePrint "刷新后的战车卡牌数组按顺序输出:"
            Call 战车卡牌数组按顺序输出()
            TracePrint "刷新后卡牌阵容排序输出:"
            Call 当前卡牌排序()
        End If
	

        If 当前在战斗 = 1 Then 
            If get合作标志() = 1 Then 
                检测关卡 = 150
                //寒冰
                If 寒冰ck = 1 Then 
                    检测关卡 = 40
                End If
                If 合作优先扩建ck = 1 and 寒冰ck = 0 and 当前合作关卡 < 检测关卡 Then 
                    If 扩建是否满级() = 0 Then 
                        If 主界面对战按钮() = 0 Then 

                            If 判断当前是否在战场中() = 1  Then 
                                Call MoveToFcn(318+获取随机数(4), 578+获取随机数(4))
                                dm.Delay 20
                                dm.LeftClick 
                            End If
                        End If	
                    End If
		 	
                ElseIf 寒冰优先扩建ck = 1 and 寒冰ck = 1 and 当前合作关卡 < 检测关卡 Then
                    If 扩建是否满级() = 0 Then 
                        If 主界面对战按钮() = 0 Then 
                            If 判断当前是否在战场中() = 1   Then 
                                Call MoveToFcn(318+获取随机数(4), 578+获取随机数(4))
                                dm.Delay 20
                                dm.LeftClick 
                            End If
                        End If	
                    End If
		 	
                ElseIf  是否可以刷新 = 1 and 卡牌识别成功次数 > 0 Then 
                    Call 扩建战车()
                End If 
			
            ElseIf  是否可以刷新 = 1 and 卡牌识别成功次数 > 0 Then 
                Call 扩建战车()
            End If
		
        End If
	

        If 当前在战斗 = 1 and 识别已满级 = 0  Then 
            If 扩建是否满级() = 1 Then 
                TracePrint "识别扩展次数已满级，当前扩展次数为："& 扩展次数
                扩展次数 = 5
                光精灵暂时不使用 = 0
                识别已满级 = 1
                TracePrint "识别扩展次数已满级"
            Else 
                If 扩展次数 >= 5 Then 
                    扩展次数 = 4
                    Call 扩建战车()
                    TracePrint "错误识别扩展次数"
                End If
                
                If Int(扩建控制) = 5 Then 
                    dm_ret = dm.Ocr(216,596,268,615, "D7D7D7-282828", 0.84)
                    If len(dm_ret) > 0 Then 
                        If Int(dm_ret) > 200 Then 
                            TracePrint "检查到扩未全，强行扩建"
                            Call MoveToFcn(318+获取随机数(4), 578+获取随机数(4))
                            dm.Delay 50
                            dm.LeftClick 
                        End If
                    End If
                End If
            End If
        End If
	
	
        If 对战土精灵排序最后 = 0 and 当前在战斗 = 1 Then 
            If get合作标志() = 0 Then 
                If 扩展次数 >= 5 Then 
                    If getCard("土精灵") = 1 Then 
                        Call 调整卡牌顺序后("土精灵")
                        对战土精灵排序最后 = 1
                        Call 新增对战不上的卡牌("土精灵")
                    End If
                End If
            End If
        End If
	
	
        If 对战当前阵容顺序是否还原 = 0 and 对战只升一级ck = 1 and 当前在战斗 = 1 Then 
            If get合作标志() = 0 Then 
                If 扩展次数 >= 5 Then 
                    Call 对战当前阵容顺序还原()
                    对战当前阵容顺序是否还原 = 1
                    If 买冰法次数计数 >= 买冰法次数 Then  
                        Call 调整卡牌顺序后("冰法")	
                        冰法是否排序到最后 = 1
                        Call 删除核心英雄优先数组("冰法")
                    End If
						
                    If 买小鹿次数计数 >= 买小鹿次数 Then   
                        Call 调整卡牌顺序后("小鹿")
                        小鹿是否排序到最后 = 1
                        Call 删除核心英雄优先数组("小鹿")	
                    End If
 					
                End If
            End If
        End If
	
        If 当前在战斗 = 0 Then 
            If 对战结束确定() = 1 Then 
                Rem 合作结束标志
                当前在战斗 = 0	

                TracePrint "结束确定。。。。。"
                //对战标志 = 0
                Call 对战标志Handle(0)
                //合作标志 = 0
                Call 合作标志Handle(0)
                
                Call 当前合作关卡Handle(0)
			
                //Call 释放内存()
                
                If 微信房间自动识别ck = 1 or 寒冰微信自动识别ck = 1 Then 
                    Call 合作结算()
                End If

                If 双开自动完成6次合作ck = 1 and 双开自动完成6次合作Index = 1 or 双开自动完成3次寒冰ck = 1 or  合作自动发送房间给好友ck = 1 and 寒冰自动发送房间给好友ck = 1 Then 
                    Form1.InputBox75.Visible = True
                    If 当前合作关卡 > 301 Then 
                        当前合作关卡 = 309
                    End If
                    Call 合作结算()
                    If 当前合作关卡 > 10 Then 
                        Form1.InputBox75.Text = Form1.InputBox75.Text  & VBcrlf & "合作结束关卡:"& 当前合作关卡
                    End If
                    
                End If
                
                If 对战ck = 1 Then 
                    //对战记录
                    dm_ret = remoteFindPic("失败.tif", "472,141,556,192", 0.8, 1)
                    If  len(dm_ret) > 0 Then 
                        TracePrint "检测到对战失败"
                        If 当前线程 = 1 Then 
                            Form1.Label150.Caption = Int(Form1.Label150.Caption) + 1
                        ElseIf 当前线程 = 2 Then
                            Form1.Label152.Caption = Int(Form1.Label152.Caption) + 1
                        Else 
                            Form1.Label150.Caption = Int(Form1.Label150.Caption) + 1
                        End If
                    End If
                
                    
                    dm_ret =  remoteFindPic("胜利.tif", "473,154,557,201", 0.8, 1)
                    If len(dm_ret) > 0 Then 
                        TracePrint "检测到对战胜利"
                        If 当前线程 = 1 Then 
                            Form1.Label147.Caption = Int(Form1.Label147.Caption) + 1
                        ElseIf 当前线程 = 2 Then
                            Form1.Label149.Caption = Int(Form1.Label149.Caption) + 1
                        Else 
                            Form1.Label147.Caption = Int(Form1.Label147.Caption) + 1
                        End If
                    End If
                End If
			
                If 助战合作ck = 0 and 寒冰ck = 0 and 是否合作刷金币 = 1 and 助战20次停止辅助ck = 1 or 助战20次电脑关机ck = 1 Then 
                    dm_ret = dm.FindStrFast(386,442,653,487, "助|战", "ffffff-303030", 0.85, intX, intY)
                    Dim dm_ret_colorBlock
    		 	
                    dm_ret_colorBlock = dm.FindColorBlock(433,452,471,475, "ffffff-050505|a5a5a5-050505|c4c4c4-050505", 0.95, 225, 38,23, intX, intY)
				
                    //暂时关闭
                    dm_ret_colorBlock = 0
				
                    If 助战20次电脑关机ck = 1 Then 
                        If dm_ret > - 1  or dm_ret_colorBlock = 1 Then 
                            TracePrint "当前已助战20次,执行关机"
                            Call Plugin.Sys.ExitOS(1)
                            Delay 100
                            dm_ret1 = dm.ExitOs(1)
                            ExitScript
                        End If	
                    End If
    		 	
                    If dm_ret > - 1 or dm_ret_colorBlock = 1 Then 
                        TracePrint "当前已助战20次"
                        MessageBox "当前已助战20次"
                        ExitScript
                    End If
    		 	
    		 	
    		 	
                    If dm_ret > - 1  or dm_ret_colorBlock = 1 Then 
                        TracePrint "当前已助战20次"
                        MessageBox "当前已助战20次"
                        ExitScript
                    End If
                End If
			
                If 对战结束确定() = 1 Then 
                    Call MoveToFcn(515,535)
                    dm.Delay 50
                    dm.LeftClick 
                    dm.Delay 1500
                End If	
    		
                For 2
                    If 对战结束确定() = 1  Then 
                        Call MoveToFcn(515,535)
                        dm.Delay 100
                        dm.LeftClick 
                        dm.Delay 2000 
                    End If
                    dm.Delay 500
                Next	
    		
                ggwl =1	
    		
                //助战合作 or 寒冰
                If 助战合作ck = 1 or 寒冰ck = 1 Then 
                    If 寒冰好友房间自动识别ck = 0 and 寒冰微信自动识别ck = 0 and 双开自动完成3次寒冰ck = 0 and 合作自动发送房间给好友ck = 0 and 寒冰自动发送房间给好友ck = 0 Then
                        If 助战合作ck = 1 Then 
                            MessageBox "助战合作已结束，当前合作关卡为："& 当前合作关卡 & ",可以继续输入房间号继续合作"
                        Else 
                            MessageBox "寒冰已结束，当前寒冰关卡为："& 当前合作关卡 & ",可以继续输入房间号继续寒冰"
                        End If
                        dm.Delay 15000

                        ishezuoli = 0
                        While ishezuoli = 0
                            ishezuoli = 判断当前是否在战场中()
                            当前在战斗 = ishezuoli
                            dm.Delay 3000
                        Wend
					
                        If ishezuoli = 1 Then 
                            Call paramInit()
                            If getCard("幻精灵") = 0 Then 
                                装备切换 = - 1 
                            ElseIf 默认初始装备 = "无" Then
                                装备切换 = 1	
                            End If
                            //合作标志 = 1
                            Call 合作标志Handle(1)
                            扩建控制 = 合作前期扩建允许次数
                        End If
                        ggwl = 0
                    End If
                End If
    		 	
                If 对战ck = 1 Then 
                    对战次数统计 = 对战次数统计 + 1
       
                    While ggwl > 0
            		
                        dm.Delay 1000
                        If 对战胜利() = 1  and 对战胜利看广告ck = 1 Then 
		
                            //欣然接受
                            dm.Delay 1000
                            Call MoveToFcn(532,520)
                            dm.Delay 100
                            dm.LeftClick 
                    				
                            For 20
                                If is残忍拒绝() = 1 Then 
                                    dm.Delay 100
                                    Call MoveToFcn(532,520)
                                    dm.Delay 50
                                    dm.LeftClick 
                                Else 
                                    Exit For
                                End If
                                dm.Delay 1000
                            Next
                    				
                    					
                            Call MoveToFcn(936,44)
                            dm.Delay 100
                            dm.LeftClick  
           							
                            If 是否有免广告特权ck = 1 Then 
                                For 30
                                    dm.Delay 1000
                                    Call MoveToFcn(936,44)
                                    dm.Delay 100
                                    dm.LeftClick 
                                    If 主界面对战按钮() = 1 or 返回主页面按钮() = 1 Then 
                                        Exit For
                                    End If
                                Next
                            Else	
                                广告卡r = 0
                                无广告可看r = 0
                                For 6
                                    dm.Delay 1000
                                    If 广告卡r = 0 Then 
                                        广告卡r= 广告卡()
                                    End If
   			 								
                                    If 广告卡r = 2 Then 
                                        Exit For
                                    Else
                                        dm.Delay 1000
                                        无广告可看r = 无广告可看()
                                        If 无广告可看r = 1 Then 
                                            Exit For
                                        End If
                                    End If
   			 								
                                Next
   		    							
   		    							
                                Call MoveToFcn(936,44)
                                dm.Delay 100
                                dm.LeftClick 
                                dm.Delay 100
                                dm.LeftClick
                                If 主界面对战按钮() = 1 or 返回主页面按钮() = 1 Then 
                                    广告卡r = 2
                                End If
   		    									
   		    							
                                If 广告卡r <> 2 Then 
                                    If 无广告可看r = 1 Then 
                                        dm.Delay 2000
                                        //残忍拒绝
                                        Call MoveToFcn(357,529)
                                        dm.Delay 100
                                        dm.LeftClick 
                                        dm.Delay 1000
                                        //ggwl =0
                                    Else 
                                        Call 关闭广告()
                                        dm.Delay 1000
                                        //ggwl =0
                                    End If
                                End If
                            End If
                    				
                        ElseIf is残忍拒绝() = 1 and 对战胜利() = 0 and 对战失败看广告ck = 1 Then 	
                    			
                            dm.Delay 200
                            Call MoveToFcn(532,520)
                            dm.Delay 200
                            dm.LeftClick 
                    			
                            For 20
                                If is残忍拒绝() = 1 Then 
                                    dm.Delay 100
                                    Call MoveToFcn(532,520)
                                    dm.Delay 50
                                    dm.LeftClick 
                                Else 
                                    Exit For
                                End If
                                dm.Delay 1000
                            Next
    							
                            Call MoveToFcn(936,44)
                            dm.Delay 100
                            dm.LeftClick 
    							
    							
                            If 是否有免广告特权ck = 1 Then 
                                For 30
                                    dm.Delay 1000
                                    Call MoveToFcn(936,44)
                                    dm.Delay 100
                                    dm.LeftClick 
                                    If 主界面对战按钮() = 1 or 返回主页面按钮() = 1 Then 
                                        Exit For
                                    End If
                                Next
                            Else	
                                广告卡r = 0
                                无广告可看r = 0
                                For 6
                                    dm.Delay 1000
                                    If 广告卡r = 0 Then 
                                        广告卡r= 广告卡()
                                    End If
   			 							
                                    If 广告卡r = 2 Then 
                                        Exit For
                                    Else
                                        dm.Delay 1000
                                        无广告可看r = 无广告可看()
                                        If 无广告可看r = 1 Then 
                                            Exit For
                                        End If
                                    End If
   			 							
                                Next
   		    						
                                Call MoveToFcn(936,44)
                                dm.Delay 100
                                dm.LeftClick 
                                dm.Delay 100
                                dm.LeftClick
                                If 主界面对战按钮() = 1 or 返回主页面按钮() = 1 Then 
                                    广告卡r = 2
                                End If
   		    						
                                If 广告卡r <> 2 Then 
                                    If 无广告可看r = 1 Then 
                                        dm.Delay 2000
                        					
                                        Call MoveToFcn(357,529)
                                        dm.Delay 100
                                        dm.LeftClick 
                                        dm.Delay 1000
                                        //ggwl =0
                                    Else 
                                        Call 关闭广告()
                                        dm.Delay 1000
                                        //ggwl =0
                                    End If
                                End If
                            End If		
                        Else
                            If 残忍拒绝字体() = 1 Then  
                                Call MoveToFcn(357,529)
                                dm.Delay 100
                                dm.LeftClick 
                                ggwl =0
                            End If	
                        End If
						
					   	
						
                        dm.Delay 150
                        If 主界面对战按钮() = 1 and 残忍拒绝字体() = 0 Then 
                            TracePrint "对战结束识别到了对战。。。"
                            ggwl = 0
	   		 	  			
                            If is残忍拒绝() = 1 Then  
                                Call MoveToFcn(357,529)
                                dm.Delay 100
                                dm.LeftClick 
                                ggwl =0
                            End If	
                        Else 
                            dm.Delay 500
                            Call 广告卡()
                            dm.Delay 500
                            Call 无广告可看()
                            dm.Delay 500
                            Call MoveToFcn(936,44)
                            dm.Delay 100
                            dm.LeftClick 
                            dm.Delay 500
                        End If
                		
                        If 广告视频已() = 1 Then 
                            TracePrint "漏网之鱼的广告"
                            dm.Delay 1000
                            Call MoveToFcn(995,74)
                            dm.Delay 200
                            dm.LeftClick 
                            If get合作标志() = 0 Then 
                                dm.Delay 1000
                                Call MoveToFcn(936,44)
                                dm.Delay 100
                                dm.LeftClick 	
                            End If
                            ggwl = 0	
                        End If
                    Wend
                End If
            End If
        End If	

    Loop
    If 开启日志 = 0 Then 
        LogStop 
    End If

  
End Sub

Sub 寒冰99点名识别子线程()
    当前线程 = 0
    If Form1.Label98.Caption = "yes" Then 
        当前线程 = 1
    ElseIf Form1.Label99.Caption = "yes" 
        当前线程 = 2
    End If
    TracePrint "寒冰99点名识别子线程已启动 ...."
    Delay 50	
    Set dm = createobject("dm.dmsoft")
    Delay 50
    Call 塔防精灵句柄(0,0)
    dm.SetPath "c:\test_game"
    Delay 10
    dm_ret = dm.SetDict(6, "寒冰点名.txt")
    Call 识别寒冰99点名()
End Sub

Sub 停止寒冰99点名识别子线程()
    TracePrint "进入停止寒冰99点名识别子线程"	
    Dim 寒冰99点名识别子线程Id	
    If 当前线程 = 2 Then 
        寒冰99点名识别子线程Id = Form1.寒冰99点名子线程2.Caption
        Form1.寒冰99点名子线程2.Caption = ""	
        TracePrint "开始停止寒冰99点名识别子线程2：" & 寒冰99点名识别子线程Id		
    Else 
        寒冰99点名识别子线程Id = Form1.寒冰99点名子线程1.Caption
        Form1.寒冰99点名子线程1.Caption = ""
        TracePrint "开始停止寒冰99点名识别子线程1：" & 寒冰99点名识别子线程Id		
    End If
  
    If len(寒冰99点名识别子线程Id) > 0 Then 
        Delay 100
        StopThread 寒冰99点名识别子线程Id
        TracePrint "寒冰99点名识别子线程"&当前线程&"结束：" & 寒冰99点名识别子线程Id
    End If
    
End Sub

Sub 暂停寒冰99点名识别子线程()
    If 寒冰ck = 1 and 寒冰99识别ck = 1 Then 
        TracePrint "暂停寒冰99点名识别子线程"	
        Dim 寒冰99点名识别子线程Id	
        If 当前线程 = 2 Then 
            寒冰99点名识别子线程Id = Form1.寒冰99点名子线程2.Caption	
            TracePrint "暂停寒冰99点名识别子线程2：" & 寒冰99点名识别子线程Id		
        Else 
            寒冰99点名识别子线程Id = Form1.寒冰99点名子线程1.Caption
            TracePrint "暂停寒冰99点名识别子线程子线程1：" & 寒冰99点名识别子线程Id		
        End If
  		
        If len(寒冰99点名识别子线程Id) > 0 Then 
            Delay 100	
            PauseThread 寒冰99点名识别子线程Id
            TracePrint "已暂停寒冰99点名识别子线程"&当前线程&"结束：" & 寒冰99点名识别子线程Id
        End If
    End If
    
End Sub


Sub 继续寒冰99点名识别子线程()
    If 寒冰ck = 1 and 寒冰99识别ck = 1 Then 
