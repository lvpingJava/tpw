Function 获取不上的卡牌(card,is调整)
    获取不上的卡牌 = 0
    For bskpi=0 To 9
        If 不上的卡牌数组(bskpi) = card Then 
            获取不上的卡牌 = 1
            If is调整 = 1 Then 
                刷出合作卡牌限制上战场 = 刷出合作卡牌限制上战场 + 1
            End If
            TracePrint card &":是不上的卡牌"
            Exit For
        End If
    Next
End Function

Function 新增不上的卡牌(card)
    bskpBool = 1
    不上的卡牌数组size = UBound(不上的卡牌数组)
    For addbskpi=0 To 不上的卡牌数组size
        If 不上的卡牌数组(addbskpi) = card Then 
            bskpBool = 0
            Exit For
        End If
    Next
	
    If bskpBool = 1 Then 
        不上的卡牌数组size = UBound(不上的卡牌数组)
        For addbskpi=0 To 不上的卡牌数组size
            If 不上的卡牌数组(addbskpi) = "0" Then 
                不上的卡牌数组(addbskpi) = card
                TracePrint card & ":调整新增不上的卡牌顺序后2："
                If 中途换卡加速ck = 0 Then 
                    Call 调整卡牌顺序后(card)
                End If
                
                Exit For
            End If
        Next
    End If
End Function

Function 删除不上的卡牌(card)
    不上的卡牌数组size = UBound(不上的卡牌数组)
    For delbskpi=0 To 不上的卡牌数组size
        If 不上的卡牌数组(delbskpi) = card Then 
            不上的卡牌数组(delbskpi) = "0"
            Exit For
        End If
    Next
End Function


Function 获取对战不上的卡牌(card)
    获取对战不上的卡牌 = 0
    //If 对战前期不上的英雄ck = 1 Then 
    For bskpi = 0 To 5
        If 对战不上的卡牌数组(bskpi) = card Then 
            获取对战不上的卡牌 = 1
            //对战建筑未满是否升级一次满足条件 = 对战建筑未满是否升级一次满足条件 + 1
            刷出合作卡牌限制上战场 = 刷出合作卡牌限制上战场 + 1
            Exit For
        End If
    Next
    //End If
End Function

Function 新增对战不上的卡牌(card)
    bskpBool = 1
    对战不上的卡牌数组size = UBound(对战不上的卡牌数组)
    For addbskpi=0 To 对战不上的卡牌数组size
        If 对战不上的卡牌数组(addbskpi) = card Then 
            bskpBool = 0
            Exit For
        End If
    Next
	
    If bskpBool = 1 Then 
        对战不上的卡牌数组size = UBound(对战不上的卡牌数组)
        For addbskpi=0 To 对战不上的卡牌数组size
            If 对战不上的卡牌数组(addbskpi) = "0" Then 
                对战不上的卡牌数组(addbskpi) = card
                Exit For
            End If
        Next
    End If
End Function

Function 删除对战不上的卡牌(card)
    If 对战前期不上的英雄ck = 1 Then 
        For delbskpi=0 To 5
            If 对战不上的卡牌数组(delbskpi) = card Then 
                对战不上的卡牌数组(delbskpi) = "0"
                Exit For
            End If
        Next
    End If	
End Function


Function 获取不满的卡牌(card)
    获取不满的卡牌 = 0
    For bskpi=0 To 9
        If 前期不满的英雄(bskpi) = card Then 
            获取不满的卡牌 = 1
            Exit For
        End If
    Next
End Function
 
Function 获取临时不满的卡牌(card)
    获取临时不满的卡牌 = 0
    For bskpi=0 To 9
        If 寒冰99点名不满英雄数组临时备份(bskpi) = card Then 
            获取临时不满的卡牌 = 1
            Exit For
        End If
    Next
End Function

