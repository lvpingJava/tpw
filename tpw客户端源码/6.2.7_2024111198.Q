Sub 后期要升满的英雄输出
    zcstr = ""
    For i2=0 To 6
        dds = 后期要升满的英雄(i2)
        zcstr =zcstr & dds & ","
    Next
    TracePrint "后期要升满的英雄输出：" & zcstr
End Sub	


Function 是否不升满的英雄(card)
    If 获取不满的卡牌(card) = 0 Then 
        Exit Function
    End If

    cardIndex = 战车卡牌位置下标(card)
    TracePrint card & ":在 不满的卡牌数组里，不升满的英雄坐标： "& cardIndex
    If Int(cardIndex) > -1 Then 
        If 战车上卡牌升级统计(cardIndex) > 2 Then 
            是否不升满的英雄 = 1
            刷出合作卡牌限制上战场 = 刷出合作卡牌限制上战场 + 1
            TracePrint "当前英雄不能升满1：" & card
        ElseIf 战车上卡牌升级统计(cardIndex) > 0 Then
            TracePrint "当前不升满的英雄，随缘升级：" & card
        End If
    	
    End If	
End Function

