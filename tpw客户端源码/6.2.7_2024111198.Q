Function 字符串回车键去除(str)
    字符串回车键去除 = ""
    If Len(Trim(str)) > 0 Then 
        字符串回车键去除 = Replace(str, vbcrlf, "")
    End If
End Function

Function 字符串回车键添加(str)
    字符串回车键添加 = ""
    If Len(Trim(str)) > 0 Then 
        Dim stri, strSize,strs
        strs = Split(str,"|")
        strSize = UBound(strs) 
        For stri = 0 to strSize
            If stri = strSize Then 
                字符串回车键添加 = 字符串回车键添加 & strs(stri)
            Else 
                字符串回车键添加 = 字符串回车键添加 & strs(stri) & "|"& vbcrlf
            End If	
        Next
    End If	
End Function


Event Form1.Button11.Click
    Dim 日志str,rizii,txt
    Form1.Button11.Enabled = False
    txt = ""
    txt = Plugin.lxj_Plug.lxj_Txtline("C:\test_game\tfjlChild.log")
    If txt = "" Then	
        TracePrint "文件路径不存在！"
    Else 
        日志str = ""
        For rizii = 1 To txt(0)
            日志str = 日志str & txt(rizii) & " "& vbcrlf
        Next
	
    End If
	
    //获取桌面路径	
    path = Plugin.lxj_Plug.lxj_GetSpecialPath(16)
    path = path & "\躺平王塔防日志"&Form1.Label8.Caption&".txt"
    //删除配置
    Call Plugin.lxj_Plug.lxj_Recycle(path, 1)
    Delay 500
    Call Plugin.lxj_Plug.lxj_WriteTXT(path, 日志str, "ANSI")
    MessageBox "日志已下载到电脑桌面，请刷新下查看"
    Plugin.Msg.Tips path
    Form1.Button11.Enabled = True
End Event

