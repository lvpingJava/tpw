Sub 战车卡牌数组按顺序输出
    zcstr = ""
    For i2=0 To 6
        dds = 战车卡牌位置数组(i2)
        zcstr =zcstr & dds & ","
    Next
    TracePrint "战车卡牌位置数组顺序为：" & zcstr
End Sub			

Function 删除英雄图标()

    删除英雄图标 = 0
    dm.Delay 20
    dm_ret = remoteFindPic("删除图标.tif", "271,439,319,479", 0.8, 1)
    If len(dm_ret) > 0 Then 
        删除英雄图标 = 1
        dm_ret = 1
    End If
End Function



Function 卡牌下架(card, up, full, tag,kj)
    卡牌下架 = 0
    TracePrint card& "进入下架方法：" & up
    Call 卡牌在战车方向确定()
    If 卡牌在战车方向是否已确认 = 1 Then 
        If Int(扩建控制) < 5 and kj = 1 Then
            扩建控制 = 5
        End If
        If card = "无" and up <> "无" Then 
            If 卡牌是否已上战车(up) = 0 Then
                TracePrint "当前要下的卡牌为无：要上的卡牌为：关卡：：" & up & ":" & 当前合作关卡
                卡牌是否全部升满 = 0
                If full = "满" Then 
                    Call 删除不满的卡牌(up)
                    Call 删除不上的卡牌(up)
                    Call 新增后期要升满的英雄(up)
                ElseIf full = "不满" or full = "无"  Then
                    Call 删除不上的卡牌(up)
                    Call 新增不满的卡牌(up)
                End If
                TracePrint card & ":执行删除操作 ," & up & ":执行上架，顺序调整最前面1"
                
                If 中途换卡加速ck = 0  Then 
                    Call 调整卡牌顺序(up)
                End If
                卡牌下架 = 1
            End If
            Exit Function
        End If
			
		
		
			
        zckpindex = -1
        //得到要下架卡牌的位置
        For zcni=0 To 6
            If card = 战车卡牌位置数组(zcni)  Then 
                zckpindex = zcni
                Exit For
            End If
        Next
    		
        If zckpindex = -1  Then 
            Exit Function
        End If
    		
        坐标 = "0,0"
        If 卡牌在战车方向 = "右" Then 
            坐标=合作战车上卡牌坐标右(zckpindex)
        Else
            坐标=合作战车上卡牌坐标左(zckpindex)
        End If
    		
        //处理坐标
        坐标数组 = Split(Trim(坐标),",")
        Call MoveToFcn(Int(坐标数组(0)), Int(坐标数组(1)))
        dm.Delay 40
        dm.LeftClick 
        TracePrint "进入卡牌下架"
        Dim forCount
        forCount = 0
        For 45
            //执行删除操作
            //dm_ret = dm.FindPic(235,423,423,499,"删除图标.bmp|删除图标1.bmp|删除图标2.bmp","151515",0.85,0,intX,intY) 
            //dm_ret = dm.FindColorBlock(274,448,308,474,"ff7e1c-050505|3b1f08-050505",0.88,350,34,26,intX,intY)
            forCount = forCount + 1
            dm.Delay 30
            If 删除英雄图标() = 1 Then 
                For 35
                    Call MoveToFcn(330,459)
                    dm.Delay 40
                    dm.LeftClick 
                    If 删除英雄图标() = 0 and 删除英雄图标() = 0 Then 
                        Exit For
                    End If
                Next
                TracePrint "下架成功:" & card
 					
 					
                战车卡牌位置数组(zckpindex) = 0
                战车上卡牌升级统计(zckpindex) = 0
 					
                If tag = 1 Then 
                    TracePrint "指定位置操作，不后续处理、、、"
                    Exit Function
                End If
    	 			
 					
                If full = "满" or full = "不满" Then 
                    卡牌是否全部升满 = 0
                    If full = "满" Then 
                        Call 新增后期要升满的英雄(up)
                    End If
                End If
 					
                If card <> "无" Then 
                    Call 新增不上的卡牌(card)
                    Call 删除不满的卡牌(card)
                    Call 删除后期要升满的英雄(card)
                End If
 					
 					
                If up <> "无" Then 
                    Call 删除不上的卡牌(up)
                    If full = "不满"  Then 
                        Call 新增不满的卡牌(up)
                    End If

                    TracePrint card &":执行删除操作 ,"&up &":执行上架，顺序调整最前面"
                    If 中途换卡加速ck = 0 Then 
                        Call 调整卡牌顺序(up)
                    End If
						
                End If
                卡牌下架 = 1
                Exit For
 					
            Else 
                TracePrint "识别删除图标失败！下架失败："& card
                dm.Delay 40
                If 卡牌在战车方向 = "右" and zckpindex = 0 Then 
                    TracePrint "右边第一个位置，不进行连续点击"
                    If forCount >= 20 and forCount < 21 and 删除英雄图标() = 0 Then 
                        Call MoveToFcn(Int(坐标数组(0))+获取随机数(3), Int(坐标数组(1))+获取随机数(3))
                        dm.Delay 40
                        dm.LeftClick 
                        TracePrint "右边第一个位置，一直识别失败，再次点击"
                        dm.Delay 20
                    End If
                Else 
                    Call MoveToFcn(Int(坐标数组(0))+获取随机数(5), Int(坐标数组(1))+获取随机数(5))
                    dm.Delay 40
                    dm.LeftClick 
                    dm.Delay 20
                End If
 					
            End If
        Next
			
    End If
End Function

Function getBossOcr(boss)
    getBossOcr = - 1 
    If 当前合作关卡 >= 290 and 当前合作关卡 <= 299 Then 
        dm_ret = UseDictFun(2)
        getBossOcr = dm.FindStrFast(831, 48, 936, 74, boss, "f0f0f0-101010|d4d4d4-101010", 0.80, intX, intY)
        dm_ret = UseDictFun(0)
    Else
        dm_ret = remoteFindPic(boss&".tif", "934,55,1009,130", 0.8, 1)
        If len(dm_ret) > 0 Then
            getBossOcr = 1
        End If
    End If
  
End Function


Function 合作boss(boss)
    合作boss = -1
    If boss = "无" Then 
        合作boss = 1
    Else 
        For 2
            dm.Delay 30
            合作boss = getBossOcr(boss)
            TracePrint "当前boss为：" & boss & "，识别的boss为："&合作boss &"，当前关卡为：" & 当前合作关卡
            If 合作boss >= 0 Then 
                TracePrint "识别成功boss:" & boss
                Exit For
            End If
        Next	
    End If
End Function

Function 补星(a, b, boss)
    a = Int(a)
    b = Int(b)
    If 当前合作关卡 >= a and 当前合作关卡 <= b Then 
        If 合作boss(boss) > -1 Then 
            TracePrint "满足补星条件"
            是否补星 = 1
        End If	
    End If		

End Function


Function 合作寒冰喊话(a, b, boss, text,index)
    a = Int(a)
    b = Int(b)
    If 当前合作关卡 >= a and 当前合作关卡 <= b Then 
        If 合作boss(boss) > -1 Then 
            For 2
                dm.Delay 500
                Call 关闭通讯()
            Next
			
   			
            //点击世界
            dm.Delay 200
            Call MoveToFcn(991,501)
            dm.Delay 200
            dm.LeftClick 
            dm.Delay 200
            dm.LeftClick 
											
            //点击输入框
            dm.Delay 200
            Call MoveToFcn(817,580)
            dm.Delay 200
            dm.LeftClick 
            dm.Delay 200
            dm.LeftClick 
            Call 喊话输入(text)
			
            //发送
            dm.Delay 200
            Call MoveToFcn(968,584)
            dm.Delay 200
            dm.LeftClick 
            dm.Delay 500
            dm.LeftClick 
   			
   			
            For 2
                dm.Delay 500
                Call 关闭通讯()
            Next
            合作中要喊话的关卡(index) = "无"
        End If	
    End If		
							
End Function

Function 特定的关卡上下卡牌(a, b, boss, downCard, upCard, full)
    特定的关卡上下卡牌 = 0
    downCardi = 卡牌是否已上战车(downCard)
    If downCardi = 1 or downCard = "无" Then 
        a = Int(a)
        b = Int(b)
		
        If 当前合作关卡 >= a and 当前合作关卡 <= b Then 
            If 合作boss(boss) > -1 Then 
                If 开启日志 = 0 Then  
                    TracePrint "卡牌开始下架，当前关卡为：" & 当前合作关卡 & "，要下架的卡牌为：" & downCard & ",要上的卡牌为： " & upCard & ",要下架的关卡为："& a &"-" & b
                    Call 战车卡牌数组按顺序输出()
                    TracePrint downCard & "下架执行"
                End If
				
                特定的关卡上下卡牌 = 卡牌下架(downCard, upCard, full, 0,1)
                
                If 开启日志 = 0 Then 
                    TracePrint downCard & "下架结束"
                    Call 战车卡牌数组按顺序输出()
                End If
				
            End If	
	
        End If		
    End If	
End Function


Function 合作中特定的关卡切换装备(a, b, boss, equ)
    合作中特定的关卡切换装备 = 0
    a = Int(a)
    b=Int(b)	
    If 当前合作关卡 >= a and 当前合作关卡 <= b Then 
        If 合作boss(boss) > - 1  Then 
            默认初始装备 = equ
            Call 装备识别(6)
            TracePrint "当前boss："&boos&",要切换的装备为：" & "equ=" & equ & ",当前装备为："& 当前装备 & ",当前合作关卡为：" & 当前合作关卡 &  "，配置的关卡：" & a & "-" & b
            If 当前装备 <> 默认初始装备 Then 
                装备切换 = 0
            End If
            合作中特定的关卡切换装备 = 1	
        End If
    End If		
End Function


Sub 装备优先级调整()
    If 卡牌是否全部升满 = 1 Then 
        TracePrint "卡牌升满，幻精灵顺序调整最前面 "
        Call 调整卡牌顺序("幻精灵")
    Else 
        TracePrint "卡牌升满，幻精灵顺序动态调整 "
        If 合作换装备优先ck = 1 and 寒冰ck = 0  Then 
            Call 调整卡牌顺序("幻精灵")
            TracePrint "合作已选择幻精灵优先"
        ElseIf 寒冰换装备优先ck = 1 and 寒冰ck = 1 Then 
            Call 调整卡牌顺序("幻精灵")
            TracePrint "寒冰已选择幻精灵优先"
        Else
            //Call 卡牌阵容排序("幻精灵",kpzxMax)
        End If
    End If		
End Sub


Function 合作中精灵使用判断(a, b, boss,精灵,t)
    If 当前合作关卡 >= a and 当前合作关卡 <= b Then 
        If 合作boss(boss) > - 1  Then 
            TracePrint "可以使用精灵："&精灵 & " 当前关卡："&当前合作关卡
            Call add合作中可使用精灵(精灵,t)
			
            If 中途换卡加速ck = 0 Then 
                If 卡牌是否全部升满 = 1 Then 
                    TracePrint 精灵&"：卡牌全部升满合,顺序调整最前面 "
                    Call 调整卡牌顺序(精灵)	
                Else 
                    TracePrint 精灵&"卡牌未全满，优先级调为低"
                    Call 卡牌阵容排序(精灵,kpzxMax)
                End If
            End If

        End If	

    End If	
   
End Function

Function 合作要升满的英雄判断(a, b, boss, card)
    合作要升满的英雄判断 = 0
    TracePrint "进入合作要升满的英雄判断a"
    If getCard(card) = 1 Then 
        a = Int(a)
        b = Int(b)
        If 当前合作关卡 >= a and 当前合作关卡 <= b Then 
            If 合作boss(boss) > - 1  Then 
                TracePrint "进入合作要升满的英雄判断d"
                Dim is满足升满英雄
                is满足升满英雄 = 0
                If 是否带了光精灵 = 1 Then 
                    For zcsj = 0 To 6
                        战车上的card = 战车卡牌位置数组(zcsj)
                        If 战车上的card = card Then 
                            If 满星检查(zcsj) = 0 Then 
                                is满足升满英雄 = 1
                            Else 
                                TracePrint "后期升满的英雄已被光精灵升满，不做后续处理：" & 战车上的card
                            End If
                            Exit For
                        End If
                    Next
                ElseIf 卡牌是否已上战车(card) = 1 Then 
                    is满足升满英雄 = 1
                End If
						
                If is满足升满英雄 = 1 Then 

                    If 扩展次数 < 5 and Int(扩建控制) < 5 Then
                        扩建控制 = 5
                    End If

                    Call 删除不满的卡牌(card)
                    Call 新增后期要升满的英雄(card)
                    TracePrint card & ":合作要升满的英雄判断顺序调整"
                    If 中途换卡加速ck = 0 Then 
                        If UBound(Filter(精灵类数组, 当前卡牌阵容(0))) = 0 Then 
                            TracePrint  当前卡牌阵容(0)&"：当前卡牌阵容第一的位置是精灵，合作要升满的英雄可以排序到最前面"
                            Call 调整卡牌顺序(card)
                        ElseIf 战车上卡牌升级统计(战车卡牌位置下标((当前卡牌阵容(0)))) >= 4  Then
                            TracePrint "当前卡牌阵容第一的位置已满级，合作要升满的英雄可以排序到最前面"
                            Call 调整卡牌顺序(card)
                        Else 
                            TracePrint "当前卡牌阵容第一的位置没满级，合作要升满的英雄可以排序到第二的位置"
                            Call 卡牌阵容排序(card,1)
                        End If
                    End If
							
                    卡牌是否全部升满 = 0
                    TracePrint "合作要升满的英雄：" & card & " 当前关卡：" & 当前合作关卡
                End If
                合作要升满的英雄判断 = 1
            End If	
				
        End If	
    End If	
End Function


Sub 卡牌面板关闭
    dm.Delay 10
    dm_ret = remoteFindPic("红叉.tif", "787, 120, 816, 139", 0.8, 1) 
    If len(dm_ret) > 0 Then  
        Call MoveToFcn(799, 126)
        dm.Delay 50
        dm.LeftClick
    End If
End Sub



Sub 卡牌面板关闭dm
    dm_ret = dm.FindColorBlock(787,120,816,139,"e9a681-050505",0.84,120,29,19,intX,intY)
    If intX>0 and intY>0 Then  
        Call MoveToFcn(799, 126)
        dm.Delay 50
        dm.LeftClick
