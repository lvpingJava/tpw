        Call MoveToFcn( 926, 590)
        dm.Delay 200
        dm.LeftClick 
        dm.Delay 5000
        dm.LeftClick 
   		
        //关闭
   		 
        dm.Delay 5000
        Call 返回关闭()
        dm.LeftClick 
        dm.Delay 200
        Call MoveToFcn(804, 116)
        dm.Delay 200
        dm.LeftClick 
    End If
End Sub


