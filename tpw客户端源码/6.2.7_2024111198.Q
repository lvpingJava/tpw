        dm.Delay 100	
        //dm_ret = dm.FindPic(934,341,1028,445,"联盟图标.bmp","303030",0.85,0,intX,intY)
        dm_ret = dm.FindColorBlock(967,380,991,394,"8ee2f8-050505|08ace4-050505",0.85,130,24,14,intX,intY)
        If intX > 0 and intY > 0 Then 
            dm.Delay 1000
            Call MoveToFcn(intX, intY)
            dm.Delay 100
            dm.LeftClick 
            dm.Delay 3000 
           
            dm_ret = dm.FindStrFast(459, 124, 596, 152, "联盟商店", "ffffff-202020", 0.89, intXgb, intYgb)
            dm_ret2 = remoteFindPic("联盟商店.bmp", "460,118,574,167", 0.8, 1)
            If dm_ret >= 0 or len(dm_ret2) > 0  Then 
                Call MoveToFcn(504, 138)
                dm.Delay 100
                dm.LeftClick 
