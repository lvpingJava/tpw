Sub 传奇赛季()
    dm.Delay 50
    dm_ret = dm.FindColor(127,551,145,569,"ff2727-292929",0.90,0,intX,intY)
    If dm_ret = 1 Then
        Call MoveToFcn(88, 584)
        dm.Delay 100
        dm.LeftClick
   		
        //一键领取
        dm.Delay 3000
        For 3
            Call MoveToFcn(907, 580)
            dm.Delay 1000
            dm.LeftClick  
        Next
   		
        //赛季挑战
        dm_ret = remoteFindPic("奖励提示.bmp", "306,551,355,594", 0.8, 1)
        If len(dm_ret) > 0 Then 
            For 3
                Call MoveToFcn(255, 588)
                dm.Delay 50
                dm.LeftClick  
            Next
        	
            For 20
                dm.Delay 500
                dm_ret = remoteFindPic("奖励提示.bmp", "408,150,881,200", 0.8, 1)
                If len(dm_ret) > 1 Then 
                    dm.Delay 1000
                    Dim res
                    res = Split(dm_ret, "|")
                    For 3
                        Call MoveToFcn(Int(res(0)) - 40, int(res(1)) + 10)
                        dm.Delay 100
                        dm.LeftClick 
                    Next
					
                    dm.Delay 1000
                    Call MoveToFcn(848,236)
                    dm.Delay 50
                    dm.LeftClick 
            		
                    dm.Delay 1000
                    For 3
                        Call MoveToFcn(Int(res(0)) - 40, int(res(1)) + 10)
                        dm.Delay 100
                        dm.LeftClick 
                    Next

                End If
            Next
        	
            If len(全局红叉()) > 1 Then 
                For 3
                    Call MoveToFcn(926,141)
                    dm.Delay 50
                    dm.LeftClick 
                Next
            End If	
        End If
   		
   		
        //传奇殿堂
        dm_ret = dm.FindColor(145,557,165,573, "ff2727-292929", 0.89, 0, intX, intY)
        If dm_ret = 1 Then 
            dm.Delay 1500
            For 3
                Call MoveToFcn(89, 580)
                dm.Delay 1000
                dm.LeftClick 
            Next
   				
            //金币1
            dm.Delay 1500
            For 3
                Call MoveToFcn(340, 458)
                dm.Delay 1000
                dm.LeftClick 
            Next
   			
   			
            //金币2
            dm.Delay 1000
            For 3
                Call MoveToFcn(524, 444)
                dm.Delay 500
                dm.LeftClick 
            Next
   			
   			
            //金币3
            dm.Delay 1000
            For 3
                Call MoveToFcn( 709, 458)
                dm.Delay 500
                dm.LeftClick 
            Next
   		
            //关闭
            dm.Delay 1000
            Call MoveToFcn( 795, 191)
            dm.Delay 200
            dm.LeftClick 
            dm.Delay 1000
        End If
        
        dm_ret = remoteFindPic("红叉.tif", "734,161,785,194", 0.8, 1) 
        If len(dm_ret) > 0 Then 
            Call MoveToFcn(761,176)
            dm.Delay 50
            dm.LeftClick 
        End If
   		
        dm.Delay 3000
        Call 返回关闭()
		
        dm.Delay 200
        Call MoveToFcn(804, 116)
        dm.Delay 200
        dm.LeftClick 
    End If
End Sub


Function 光精灵(tag)

    If 战车是否有英雄() = 1 Then 
    
        If get合作标志() = 1 and 开局优先满战将 = 1 and 卡牌全部升满记录 = 0 Then 
            光精灵暂时不使用 = 0
            TracePrint "进入开局优先满战将策略"
            Dim 悟空index,战将index
            悟空index = 战车卡牌位置下标("悟空")
            战将index = 战车卡牌位置下标("战将")
            If Int(悟空index) > - 1  and 战将index > - 1  Then 
                If 满星检查(战将index) = 0 and  满星检查(悟空index) = 0 Then 
                    TracePrint "存在悟空，删除悟空使用光精灵"
                    Call 卡牌下架("悟空", "无", "无", 0,0)
                    Delay 500
                    Call 卡牌下架("无", "悟空", "不满", 0,0)
                End If
            End If
        End If
	
        If 卡牌是否全部升满 = 0 and 对战卡牌是否全部升满 = 0  Then 
            If 光精灵暂时不使用 = 0 Then 
                TracePrint("光精灵使用")
                Call 卡牌执行处理("光精灵", tag, 0, 0)
            End If	
        End If
    Else 
        刷出合作卡牌限制上战场 = 刷出合作卡牌限制上战场 + 1
    End If
	

End Function

Function 暗精灵(tag)	
    If 战车上卡牌升级统计(1) > 0 Then 
        Call 卡牌执行处理("暗精灵", tag, 0, 0)
    Else 
        刷出合作卡牌限制上战场 = 刷出合作卡牌限制上战场 + 1
    End If
End Function
	


Function 木精灵(tag)

    If get合作标志() = 0 Then 
        卡牌识别成功次数临时 = 0
        If 卡牌识别成功次数 > 0 Then 
            卡牌识别成功次数临时 =卡牌识别成功次数 - 刷出合作卡牌限制上战场
        End If
		
        If 卡牌识别成功次数临时 <= 0 or 对战木精灵使用 = 1 or 扩展次数 >= 5 Then 
            Call 卡牌执行处理("木精灵", tag, 0, 0)
            Call 卡牌阵容排序("木精灵", 9)
        Else 
            If 卡牌识别成功次数 > 0 Then 
                卡牌识别成功次数临时 =卡牌识别成功次数 - 刷出合作卡牌限制上战场
            End If
            If 卡牌识别成功次数临时 <= 0  Then 
                Call 卡牌执行处理("木精灵", tag, 0, 0)
                Call 卡牌阵容排序("木精灵", 9)
            End If
        End If
    Else 
        Call 卡牌执行处理("木精灵",tag,0,0)  	
    End If
End Function


Function 魂精灵(tag)

    If get合作标志() = 0 Then 
        卡牌识别成功次数临时 = 0
        If 卡牌识别成功次数 > 0 Then 
            卡牌识别成功次数临时 =卡牌识别成功次数 - 刷出合作卡牌限制上战场
        End If
		
        If 卡牌识别成功次数临时 <= 0 or 对战魂精灵使用 = 1 or 扩展次数 >= 5 Then 
            Call 卡牌执行处理("魂精灵", tag, intX, intY)
            Call 卡牌阵容排序("魂精灵",9)
        End If
    Else 
        Call 卡牌执行处理("魂精灵",tag,intX,intY)  	
    End If
		
End Function

Function 土精灵(tag)
    If 扩展次数 < 5 Then 
        If 战车上卡牌升级统计(4) > 0 Then 
            TracePrint "第四个位置强制上土精灵"
            Call 精灵上卡("土精灵")
            卡牌识别成功次数 = 卡牌识别成功次数 + 4
            已有英雄多次判断 = 0
            卡牌已删除 = 0
            对战建筑未满是否升级一次满足条件 = 0
        Else 
            Call 卡牌执行处理("土精灵", tag, 0, 0)
        End If	
    End If
End Function


Function 魔精灵(tag)
    If get合作标志() = 1 Then 
        Call 卡牌执行处理("魔精灵", tag, 0, 0)
    Else
        If 战车上卡牌升级统计(1) > 0 Then 
            Call 卡牌执行处理("魔精灵", tag, 0, 0)
        Else 
            刷出合作卡牌限制上战场 = 刷出合作卡牌限制上战场 + 1
        End If
    End If
   
	

End Function

Function 幻精灵(tag)

    TracePrint "幻精灵识别成功，默认初始装备=" & 默认初始装备 & ",当前装备=" & 当前装备
	
    If 默认初始装备 = "无" Then 
        TracePrint "默认初始装备为无，不进行切换"
        刷出合作卡牌限制上战场 = 刷出合作卡牌限制上战场 + 1
        Exit Function
    End If
	
    If 当前装备 = 默认初始装备 Then 
        装备切换 = 1
    End If
	
    is执行幻精灵 = 0
    If 刷出合作卡牌限制上战场 >= 2 and 扩展次数 < 5 Then 
        is执行幻精灵 = 1
    End If
	
    幻精灵扩建使用要求 = 0
	
    If get合作标志() = 1  Then 
        If 扩展次数 >= 扩建控制-4 Then 
            幻精灵扩建使用要求 = 1
        End If
    Else 
        If 扩展次数 >= 1 Then 
            幻精灵扩建使用要求 = 1
        End If
    End If
	
    If 幻精灵扩建使用要求 = 1  and 当前装备 <> 默认初始装备 or is执行幻精灵 = 1  Then 
        TracePrint "幻精灵满足条件：" & 默认初始装备 & ",当前装备=" & 当前装备
        qhbool = 1
		
        If get合作标志() = 0 Then 	
            If  扩展次数 < 5 Then 
                dm.Delay 30
                dm_ret = remoteFindPic("无装备.bmp", "16,548,83,615", 0.8, 1)
                If len(dm_ret) > 0 Then 
                    TracePrint "当前装备没掉落"
                    qhbool = 0
                Else 
                    Call 装备识别(6)
                End If
            ElseIf 扩展次数 >= 5 Then 
                Call 装备识别(6)	
            End If
        Else 
            If  扩展次数 < 5 Then 
                dm.Delay 30
                dm_ret = remoteFindPic("无装备.bmp", "16,548,83,615", 0.8, 1)
                If len(dm_ret) > 0 Then 
                    TracePrint "当前装备没掉落"
                    qhbool = 0
                Else 
                    Call 装备识别(6)
                End If
            ElseIf  扩展次数 >= 5 Then 
                Call 装备识别(6)
            End If
        End If

		
        If qhbool = 1 Then 
            坐标数组 = Split(Trim(获取识别到的英雄坐标("幻精灵")), ",")
            For 2
                Call MoveToFcn(Int(坐标数组(0))+获取随机数(4), Int(坐标数组(1))+获取随机数(4))
                dm.Delay 40
                dm.LeftClick 
            Next
            TracePrint "幻精灵点击了，默认初始装备=" & 默认初始装备 & ",当前装备=" & 当前装备
            卡牌识别成功次数 = 卡牌识别成功次数 + 4
            卡牌已删除 = 0
        Else 
            刷出合作卡牌限制上战场 = 刷出合作卡牌限制上战场 + 1
    		
        End If
    Else
        刷出合作卡牌限制上战场 = 刷出合作卡牌限制上战场 + 1
    End If
	
End Function


Function 装备识别(count)
    装备识别 = 0
    For count
        If count > 1 Then 
            dm.Delay 150
        Else 
            dm.Delay 100
        End If
		
        dm_ret = remoteFindPic("强袭4-1.bmp|龙心4_1.bmp|烟斗4_1.bmp|圣剑4_1.bmp|圣剑1_1.bmp|烟斗2_1.bmp|龙心1_1.bmp|强袭1_1.bmp", "16,548,83,615", 0.83, 1)
        If len(dm_ret) > 0 Then 
            dm.Delay 50
            dm_ret1 = remoteFindPic("强袭4-1.bmp|龙心4_1.bmp|烟斗4_1.bmp|圣剑4_1.bmp|圣剑1_1.bmp|烟斗2_1.bmp|龙心1_1.bmp|强袭1_1.bmp", "16,548,83,615", 0.83, 1)
            If dm_ret1 = dm_ret Then 
                TracePrint "装备识别成功"
                Dim res, 装备str
                装备str = ""
                res = Int(Split(dm_ret, "|")(2))
                If res = 1 or res = 8 Then 
                    装备str = "强袭"
                ElseIf res = 2 or res = 7  Then
                    装备str = "龙芯"
                ElseIf res = 3 or res = 6  Then
                    装备str = "烟斗"
                ElseIf res = 4 or res = 5  Then 
                    装备str = "圣剑"	
                End If
                当前装备 = 装备str
                TracePrint "识别到装备：" & 装备str
                If 默认初始装备 = 装备str Then 
                    dm.Delay 500
                    dm_ret2 = remoteFindPic("强袭4-1.bmp|龙心4_1.bmp|烟斗4_1.bmp|圣剑4_1.bmp|圣剑1_1.bmp|烟斗2_1.bmp|龙心1_1.bmp|强袭1_1.bmp", "16,548,83,615", 0.83, 1)
                    If dm_ret2 = dm_ret1 Then 
                        qhbool = 0
                        装备切换 = 1
                        当前装备 = 装备str
                        装备识别 = 1
                    Else 
                        TracePrint "再次确认，装备没有识别成功"	
                    End If
                End If
                Exit For
            End If	
        End If
    Next				
End Function


Function 侏儒射线(tag)
    If 战车上是否有工程类英雄("侏儒射线") = 0 Then 
        刷出合作卡牌限制上战场 = 刷出合作卡牌限制上战场 + 1
        Exit Function
    End If
    Call 卡牌执行处理("侏儒射线", tag, 0, 0)
		
End Function


Function 地精宝库(tag)
    If 战车上是否有工程类英雄("地精宝库") = 0 Then 
        刷出合作卡牌限制上战场 = 刷出合作卡牌限制上战场 + 1
        Exit Function
    End If
    Call 卡牌执行处理("地精宝库", tag, 0, 0)	
		
End Function


Function 工程类英雄(card)
    工程类英雄 = 0
    For gc = 0 To 2
        If card = 工程类的英雄(gc) Then 
            工程类英雄 = 1
            Exit For
        End If
    Next
End Function

Function 战车上是否有工程类英雄(card)
    战车上是否有工程类英雄 = 1
	
    If 卡牌是否已上战车(card) = 1 Then 
        Exit Function
    End If
	
    For gc = 0 To 2
        If 卡牌是否已上战车(工程类的英雄(gc)) = 1 Then 
            战车上是否有工程类英雄 = 0
            Exit For
        End If
    Next

	
End Function

Function 当前卡牌是否有工程类英雄()
    当前卡牌是否有工程类英雄 = 0
    For gc = 0 To 2
        If getCard(工程类的英雄(gc)) = 1 Then 
            当前卡牌是否有工程类英雄 = 1
            Exit For
        End If
    Next
End Function

Function 精灵上卡(card)
    坐标数组 = Split(Trim(获取识别到的英雄坐标(card)), ",") 
    intX = Int(坐标数组(0))
    intY = Int(坐标数组(1))
    For 1
        dm.Delay 1
        dm.MoveTo intX, intY
        dm.Delay 2
        dm.MoveTo intX, intY
        dm.Delay 3
        dm.MoveTo intX, intY
        dm.Delay 50
        dm.LeftClick 
        dm.LeftClick 
        dm.LeftClick 
        dm.Delay 100
    Next	
End Function


Function 点击处理(ddx, ddy, cardx)
    isOk1 = 0
    is精灵 = 0
    is不记录位置的 = 0
    If 卡牌是否已上战车(cardx) = 1 Then 
        isOk1 = 1
        TracePrint "已有英雄存在:" & cardx	
    ElseIf 战车上卡牌升级统计(0) = 0  and 扩展次数 = 0  and get合作标志() = 0 Then 
        isOk1 = 1
        If UBound(Filter(精灵类数组, cardx)) = 0 Then 
            is精灵 = 1
            is不记录位置的 = 1
        End If
        TracePrint "当前第一次:" & cardx
    ElseIf 工程类英雄(cardx) = 1 Then
        TracePrint "我是工程类英雄，不用做后续处理" & cardx
        isOk1 = 1
        is不记录位置的 = 1
    ElseIf cardx = "光精灵" Then 
        光精灵使用次数 = 光精灵使用次数 + 1
        isOk1 = 1
        is精灵 = 1
        is不记录位置的 = 1
        TracePrint "识别到光精灵"
    ElseIf UBound(Filter(精灵类数组, cardx)) = 0 Then 
        TracePrint "我是精灵类，不用做后续处理:" & cardx
        isOk1 = 1
        is精灵 = 1
        is不记录位置的 = 1
    ElseIf 扩展次数 < 5 Then
        If 卡牌是否已上战车(cardx) = 0 Then 
            If 战车上卡牌的数量() >= 扩展次数 + 1 Then 
                TracePrint "我是新来的卡牌， 没在战车，准备尝试扩建战车：" & cardx
                If get合作标志() = 1 Then 
                    For 3
                        If 扩建战车() = 1 Then 
                            isOk1 = 2
                            TracePrint "上英雄前扩建成功！"
                            Exit For
                        End If
                        dm.Delay 150
                    Next
                Else 
                    If 当轮识别第一个英雄 = 0 Then 
                        For 3
                            If 扩建战车() = 1 Then 
                                isOk1 = 2
                                TracePrint "对战当轮识别第一个英雄，扩建成功！"
                                Exit For
                            End If
                            dm.Delay 150
                        Next
                    End If
                End If
				
            End If	
        End If		
      
    End If
	
    If get合作标志() = 1 and  is精灵 = 0 and 卡牌在战车方向是否已确认 = 1  Then 
        For forCount = 0 To 5
            If 战车上卡牌升级统计(forCount) = 0 Then 
                Call 快速卡牌下架(forCount)
                Exit For
            End If
        Next
    End If
	
    卡牌已删除 = 0
    Call 合作指定英雄位置(cardx)
	
    坐标数组 = Split(Trim(获取识别到的英雄坐标(cardx)), ",")
    intX = Int(坐标数组(0))
    intY = Int(坐标数组(1))
    If 骰子识别开始 = 1 Then 
        dm.MoveTo intX, intY
        dm.Delay 5
        dm.MoveTo intX, intY
        dm.MoveTo intX, intY
        dm.Delay 30
        dm.LeftClick 
        dm.LeftClick
    Else
    	If get合作标志() = 1 and  卡牌全部升满记录 = 0 Then 
        	For 1
            	dm.MoveTo intX, intY
            	dm.Delay 5
            	dm.MoveTo intX, intY
            	dm.Delay 5
            	dm.MoveTo intX, intY
            	dm.Delay 50
            	dm.LeftClick 
            	dm.LeftClick 
            	dm.LeftClick 
        	Next
    	Else 
        	For 1
            	dm.Delay 1
            	dm.MoveTo intX, intY
            	dm.Delay 2
            	dm.MoveTo intX, intY
            	dm.Delay 3
            	dm.MoveTo intX, intY
            	dm.Delay 50
            	dm.LeftClick 
            	dm.LeftClick 
            	dm.LeftClick 
        	Next	
    	End If
    End If	


    If isOk1 <> 1 Then 
    		
   		
        If get合作标志() = 1 Then 
            TracePrint "进入合作上卡牌防补偿判断"
            If 寒冰ck = 1 Then 
                If 当前合作关卡 > 20 and 扩展次数 >= 5 Then 
                    isOk1 = 1
                    TracePrint "寒冰20关之后不进行卡牌防补偿判断"
               
                End If
            Else 
                If 当前合作关卡 > 240 and 扩展次数 >= 5 Then 
                    isOk1 = 1
                    TracePrint "合作240关之后不进行卡牌防补偿判断"
               
                End If
            End If
   				
            If isOk1 <> 1 Then 
                For 10
                    dm.Delay 100 
                    If 英雄判断是否存在(cardx) = 0 Then 
                        If 当前线程 = 1 Then 
                            dm.Delay 2500
                        ElseIf 当前线程 = 2 Then
                            dm.Delay 4500
                        Else 
                            dm.Delay 3500
                        End If
                        If 英雄判断是否存在(cardx) = 0 and 判断当前是否在战场中() = 1 Then 
                            isOk1 = 1
                            TracePrint "确定合作上卡牌防补偿判断a"
                            Exit For
                   
                        End If    
                    End If
                    dm.Delay 100
                Next
            End If
        Else 
            TracePrint "进入对战上卡牌防补偿判断:" & cardx
            forCount = 3
            If cardx = "小鹿" or cardx = "冰法" Then 
                If get对战要卖的卡牌(cardx) = 1 Then 
                    forCount = 5
                End If
            End If
            
            For forCount
                dm.Delay 40
                If 英雄判断是否存在(cardx) = 0 Then 
                    dm.Delay 20
                    If 英雄判断是否存在(cardx) = 0 Then 
                        isOk1 = 1
                        TracePrint "确定对战上卡牌防补偿判断:" & cardx
                        Exit For
                    End If
                End If
                dm.Delay 30
            Next
   				
        End If
   	
    End If
   	
    If isOk1 = 1 Then 
	
        If is精灵 = 0 Then 
            //这个必须放在战车卡牌位置添加前
            Call 对战只升级一次的卡牌(cardx)
            TracePrint "满足添加:" & cardx
            Call 战车卡牌位置添加(cardx,is不记录位置的)
    		 
    		 
            //            If 对战是否有要买卡牌的英雄(cardx) = 1 Then  
            //                对战卡牌是否全部升满 = 0
            //            End If	
        End If
    	
        Call 骰子英雄数量判断()
    	
    	
        卡牌识别成功次数 = 卡牌识别成功次数 + 4
        已有英雄多次判断 = 0
        卡牌已删除 = 0
        对战建筑未满是否升级一次满足条件 = 0
        TracePrint "上卡结束："&cardx
    Else 
        已有英雄多次判断 = 1
        TracePrint "未满足添加:" & cardx
    End If
End Function

Function 是否满足核心英雄(card)
    是否满足核心英雄 = 1
	
    //		If 获取核心英雄优先数组(card) = 0 Then 
    //			Exit Function
    //		End If
		
    If 获取核心英雄优先数组(card) = 1 and 卡牌是否已上战车(card) = 0 Then 
        Exit Function
    End If
		
    If 扩展次数 >= 5 and 是否等待核心英雄上战车 = 0 Then 
        If 战车上卡牌数量Filter() = 6 Then 
            是否等待核心英雄上战车 = 1
        End If
    End If
		
    //这里判断当前刷出的卡牌是否有核心英雄
    If  是否等待核心英雄上战车 = 0 Then
        For tji = 0 To 6
            tjcard = 核心英雄优先数组(tji)
            If tjcard <> "0" and tjcard <> "光精灵" Then 
                If 卡牌是否已上战车(tjcard) = 0  Then 
                    If 获取识别到的英雄(tjcard) = 1 Then 
                        是否满足核心英雄 = 0
                        Exit For
                    End If
                End If
            End If	
        Next
    End If
End Function


Function 是否满足紫卡(card)
    是否满足紫卡 = 0
    If 对战有紫卡优先升级ck = 1 and get合作标志() = 0 Then 
        If 获取紫卡数组中卡牌(card) = 1 Then 
            是否满足紫卡 = 1
        End If
    End If
End Function

Function 控制英雄要上的格子(knum)
    If 对战指定第六格子ck = 1 Then 
        If 卡牌是否已上战车(对战控制英雄格子) = 0 Then 
            If 战车上卡牌升级统计(knum) > 0 Then 
                TracePrint "进入第六格子英雄"
                //If card = Trim(Form1.InputBox32.text) Then 
                If getCard(对战控制英雄格子) = 1 Then 
                    TracePrint "满足第六格子英雄"
                    Call 新增核心英雄优先数组(对战控制英雄格子)
                    Call 删除对战不上的卡牌(对战控制英雄格子)
                End If
                //End If
			
            End If
			
        End If	
		
    End If
End Function

Function 提前刷出英雄(card)
    提前刷出英雄 = 0
    识别结果count = 快速英雄识别Test(1, card, 11, 0.85)
    If 识别结果count > 1 Then 
        TracePrint "提前刷出英雄-等待一段时间识别到了aaaa"
        Dim zki,zkCard
        For zki = 0 To 2
            zkCard = 识别到的英雄数组(zki)
            If IsNumeric(zkCard) <> - 1  Then 
                If card = zkCard Then 
                    TracePrint zki&"：位置，提前刷出英雄-快速手牌没识别成功，正常手牌识别成功:" & zkCard
                    提前刷出英雄 = 1
                    Exit Function
                End If
            End If
        Next
    End If
	 	
		
    If 识别结果count = 1 Then 
        提前刷出英雄 = 1
        Exit Function
    End If
		
    Call 快速刷新(0)
    dm.Delay 100	
End Function

Function 刷出精灵等待执行(card)
    Dim 是否需要刷新,timeInfo,oldTime
    //12秒
    timeInfo = 12
    oldTime = Now
    dm.Delay 400
    For 20
        快速英雄识别结果 = 0
        是否需要刷新= 0
        识别结果count = 快速英雄识别Test(1, card, 10, 0.85)
        If 识别结果count > 1 Then 
            TracePrint "等待一段时间识别到了aaaa"
            等待刷新次数 = 0
            Dim zki,zkCard,isYes
            isYes = 0	
         
            For zki = 0 To 2
                zkCard = 识别到的英雄数组(zki)
                If IsNumeric(zkCard) <> - 1  Then 
                    If card = zkCard Then 
                        TracePrint zki&"：位置，快速手牌没识别成功，正常手牌识别成功:" & zkCard
                        isYes = 1
                        识别到的英雄数组 =  Array(0, 0, 0)
                        识别到的英雄数组(zki) = zkCard
                        Exit For
                    End If
                End If
            Next
            If isYes = 1 Then 
                快速英雄识别结果 = 1
                Exit For
            End If
    		
            If isYes = 0 Then 
                等待刷新次数 = 0
                是否需要刷新 = 1
                TracePrint "后补刷新aaaa...."
            Else 
                快速英雄识别结果 = 1
                Exit For	
            End If
        End If
		
        If 计时器(oldTime) >= 4 Then 
            TracePrint "时间到了，还没刷出木精灵， 就结束刷新a"
            快速英雄识别结果 = 1
            Exit For
        End If
		
        If 识别结果count = 0 Then 
            Call 快速刷新(识别结果count)
            If 对战结束确定a() = 1 Then 
                当前在战斗 = 0
                Exit For
            End If
        End If
		
        If 识别结果count = 1 Then 
            快速英雄识别结果 = 1
            Exit For	
        End If
		
        If 是否需要刷新 = 1 Then 	
            Call 快速刷新(识别结果count)
        End If
        
        If 计时器(oldTime) >= 4 Then 
            TracePrint "时间到了，还没刷出木精灵， 就结束刷新a"
            快速英雄识别结果 = 1
            Exit For
        End If

    Next
    timeInfo =	timeInfo-计时器(oldTime)
    TracePrint "识别结束，耗时：" & timeInfo
    If 快速英雄识别结果 = 1 and timeInfo > 0 Then 
        Dim 是否加过血
        是否加过血 = 0 
        timeInfo = timeInfo*10	
        For timeInfo
            TracePrint "刷出木精灵，等待加血"
            If  是否加过血 = 0 Then 
                If 合作血条判断(4) = 1 Then  
                    TracePrint "刷出木精灵，满足加血"
                    For kpzxi = 0 To 2
                        If IsNumeric(识别到的英雄数组(kpzxi)) = 0 and 识别到的英雄数组(kpzxi) = card Then 
                            TracePrint "执行识别结果："  &  识别到的英雄数组(kpzxi)
                            Call 卡牌执行(识别到的英雄数组(kpzxi), 1)
                            是否加过血 = 1
                            Exit For
                        End If
                    Next
                End If	
            End If
            If len(get船长点名()) > 0 Then 
                TracePrint "检测到船长点名，立即停止循环"
                Exit Function
            End If
            If 获取关卡() >= 131 Then 
                TracePrint "检测到船长点名关卡已过，停止循环"
                Exit Function
            End If
            dm.Delay 100
        Next
    End If
	
    If 是否加过血 = 1 Then 
        TracePrint "加过血了，提前刷新"
        dm.Delay 1200
        Call 快速刷新(0)
    End If	

End Function

Function cardFilter()
    Dim nowCardi,nowCard,bool,cardIndex,cardStrs,temCardStrs,bskpi,不满cardStrsa,不满cardStrsb,bool木精灵,bool魂精灵
    cardStrs = ""
    temCardStrs = ""
    不满cardStrsa = ""
    不满cardStrsb = ""
    bool木精灵 = 0
    bool魂精灵 = 0
    If 是否带了幻精灵 = 1 and 装备切换 = 0 Then	
        temCardStrs = temCardStrs & "幻精灵" & "|"
    End If

    If 是否带了光精灵 = 1 and 骰子识别开始 = 0 Then 
        If 卡牌是否全部升满 = 0 Then 
            If 光精灵暂时不使用 = 0 Then 
                temCardStrs = temCardStrs & "光精灵" & "|"
            End If	
        End If
    End If
    
    If 自动补木 = 1 and 卡牌是否全部升满 = 0 and 扩展次数 >= 5 Then 
        temCardStrs = temCardStrs & "木精灵" & "|"
        bool木精灵 = 1
    End If
    
    If 自动补魂 = 1 and 卡牌是否全部升满 = 0 and 扩展次数 >= 5 Then 
        temCardStrs = temCardStrs & "魂精灵" & "|"
        bool魂精灵 = 1
    End If
      
  
     
    For nowCardi = 0 To 9
        nowCard = 当前卡牌阵容(nowCardi)
        If nowCard = "光精灵" or nowCard = "幻精灵" Then 
    	
        ElseIf  nowCard = "木精灵" and bool木精灵 = 1 Then 
    	
        ElseIf  nowCard = "魂精灵" and bool魂精灵 = 1  Then
    		
        ElseIf 获取不上的卡牌(nowCard, 0) = 1 Then 
        
        ElseIf get合作中可使用精灵(nowCard) = 1 Then 
            TracePrint "我是受控制的精灵可以使用：" & nowCard
            temCardStrs = nowCard & "|" & temCardStrs & "|"

        ElseIf 获取不满的卡牌(nowCard) = 1 Then 
            cardIndex = 战车卡牌位置下标(nowCard)
            If cardIndex = - 1  Then 
                不满cardStrsa = 不满cardStrsa & nowCard & "|"
            Else 
                If 战车上卡牌升级统计(cardIndex) > 2 Then 
                    TracePrint "当前英@@@雄不能升满1：" & nowCard
                Else 
                    不满cardStrsb = 不满cardStrsb & nowCard & "|"
                End If			
            End If

        End If
    Next
    
    
    TracePrint "AtemCardStrs:" & temCardStrs
    
    TracePrint "不满cardStrsa:" & 不满cardStrsa
    
    TracePrint "不满cardStrsb:" & 不满cardStrsb
    
    If len(不满cardStrsb) > 0 Then 
        temCardStrs = temCardStrs & 不满cardStrsb
    End If
    
    If len(不满cardStrsa) > 0 Then 
        temCardStrs = 不满cardStrsa & temCardStrs
    End If 
     
    TracePrint "BtemCardStrs:" & temCardStrs
    
    For nowCardi = 0 To 6
        nowCard = 后期要升满的英雄(nowCardi)
        If nowCard <> "0" Then 
            cardStrs = cardStrs & nowCard & "|"
        End If
    Next
    
    TracePrint "cardStrs:"&cardStrs
    
    卡牌阵容str = cardStrs & temCardStrs
    TracePrint "合作速刷的卡牌：" & 卡牌阵容str
End Function


Function 卡牌执行处理(card,tag,x,y)
    If tag = 1 Then 
        卡牌执行处理bool = 0
        If get合作标志() = 1 Then 
            If 快速英雄识别结果 = 1 Then 
                卡牌执行处理bool = 1
                TracePrint "快速英雄识别结果："& card
            Else 
                If 获取不上的卡牌(card, 1) = 0 and 是否不升满的英雄(card) = 0 Then
                    If get合作中可使用精灵(card) = 1 Then 
                        卡牌执行处理bool = 1
                        TracePrint "我是受控制的精灵可以使用：" & card
                    Else
                        卡牌执行处理bool = 1
                        If 卡牌全部升满记录 = 0 Then 
                            If 是否满足核心英雄(card) = 0 Then 
                                TracePrint "合作满足-满足核心英雄："&card 
                                卡牌执行处理bool = 0
                            End If
                        End If
                    End If
                End If
            End If	
        Else 
            If 获取对战不上的卡牌(card) = 1 Then
                卡牌执行处理bool = 0
                If 对战某个英雄升满切换() = 1 Then 
                    卡牌执行处理bool = 1
                End If
            ElseIf 是否满足紫卡(card) = 1 Then 
                卡牌执行处理bool = 1
            Else 
                If 对战建筑未满英雄升级控制(card) = 0 Then 
                    If 对战核心英雄是否要判断 = 1 Then 
					 	
                        If 扩展次数 >= 5 Then 
                            If 战车上是否已全部上了英雄(card) = 1 Then 
                                卡牌执行处理bool = 1
                                对战核心英雄是否要判断 = 0
                                TracePrint "对战不需要核心英雄判断了...."
                            End If
                        End If
					 	
                        If 卡牌执行处理bool = 0 Then 
                            If 是否满足核心英雄(card) = 1 Then 
                                卡牌执行处理bool = 1
                            End If
                        End If
					 	
					 	
                    Else 
                        卡牌执行处理bool = 1
                    End If
		
                End If
            End If
			
        End If	
	
        If 卡牌执行处理bool = 1  Then	
            Call 点击处理(x,y,card)
        End If			
    End If
End Function

Function 只升级一次的卡牌数组初始化()
    If 对战ck = 1 Then 
        //or 对战强制只升一级ck = 1
        If 对战只升一级ck = 1  Then 
            If len(Trim(对战只升级一次的卡牌Str)) > 0 Then 
                对战只升级一次的卡牌Str = 字符串竖杠处理(对战只升级一次的卡牌Str)
                只升级一次的卡牌数组 = Split(对战只升级一次的卡牌Str, "|")
                只升级一次的卡牌数组已执行 = 只升级一次的卡牌数组
            End If
        End If
    End If
End Function


Function 查询只升级一次的卡牌(card)
    Dim 只升级一次的卡牌数组Size
    只升级一次的卡牌数组Size =UBound(只升级一次的卡牌数组) 
    For zsjyci = 0 To 只升级一次的卡牌数组Size
        If 只升级一次的卡牌数组(zsjyci) = card Then 
            查询只升级一次的卡牌 = 1
            Exit For 
        End If
    Next	
End Function

Function 对战只升级一次的卡牌(card) 
    If 对战只升一级ck = 1 and 扩展次数 < 5 and 对战ck = 1 Then 
        If 卡牌是否已上战车(card) = 0 Then 
            zsjyciMax = UBound(只升级一次的卡牌数组)
            For zsjyci = 0 To zsjyciMax
                If 只升级一次的卡牌数组(zsjyci) = card and 只升级一次的卡牌数组已执行(zsjyci)  <> "yes" Then 
                    只升级一次的卡牌数组已执行(zsjyci) = "no"
                    TracePrint "当前是只升级一次的英雄：" & card
                    Exit For
                End If
            Next	
        End If
       
    End If
End Function


Function 对战只升级一次的卡牌排序() 
    If 对战只升一级ck = 1 and 扩展次数 < 5 Then 
        Dim get只升级一次的卡牌, 是否有添加
        是否有添加 = 0	
        zsjyciMax = UBound(只升级一次的卡牌数组)
        For zsjyci = 0 To zsjyciMax
            If 只升级一次的卡牌数组已执行(zsjyci) = "no" Then 
                get只升级一次的卡牌 = 只升级一次的卡牌数组(zsjyci)
                只升级一次的卡牌数组已执行(zsjyci) = "yes"
                TracePrint "只升级一次的卡牌排序到最后：" & get只升级一次的卡牌
                Call 对战只升一级英雄排序数组添加(get只升级一次的卡牌)
                是否有添加 = 1
            End If
        Next
        
        If 是否有添加 = 1 Then 
            Call 对战只升一级英雄排序()
            For zsjyci = 0 To 6
                If IsNumeric(对战只升一级英雄数组排序(zsjyci)) <> - 1  Then 
                    Call 卡牌阵容排序(对战只升一级英雄数组排序(zsjyci),9)
                End If
            Next
		
        End If	
    End If
End Function


Function 对战建筑未满英雄升级控制(card)
    对战建筑未满英雄升级控制 =  建筑未满是否升级一次(card)
End Function



Function 建筑未满是否升级一次(card)
    建筑未满是否升级一次 = 0
    If 对战只升一级ck = 1 and 扩展次数 < 5 Then 
        If 卡牌是否已上战车(card) = 1 Then 
            If 查询只升级一次的卡牌(card) = 1 Then 
                Dim 卡牌识别成功次数临时
                卡牌识别成功次数临时 = 0
                TracePrint "卡牌识别成功次数: " & 卡牌识别成功次数
                If 卡牌识别成功次数 > 0 Then 
                    卡牌识别成功次数临时 = 卡牌识别成功次数 - 刷出合作卡牌限制上战场
                End If
                TracePrint "卡牌识别成功次数临时:"&卡牌识别成功次数临时
                If 卡牌识别成功次数临时 <= 0  Then 
                    建筑未满是否升级一次 = 0
                Else 
                    建筑未满是否升级一次 = 1
                End If
            End If
        	
        End If	
    End If
End Function





Function 建筑未满强制只升一级(card)
    建筑未满强制只升一级 = 0
    If 对战只升一级ck  and 扩展次数 < 5 Then 
        If 卡牌是否已上战车(card) = 1 Then 
