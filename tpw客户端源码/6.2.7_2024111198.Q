Sub 子线程1
    当前线程 = 0
    If Form1.Label98.Caption = "yes" Then 
        当前线程 = 1
    ElseIf Form1.Label99.Caption = "yes" 
        当前线程 = 2
    End If
    //记录日志开始
    Delay 10000
    If Form1.CheckBox117.Value = 0 Then 
        LogStart "C:\test_game\tfjlChild1.log" 
    End If
	
  	
    TracePrint "子线程1已启动 ...."
    Delay 500	
    Set dm = createobject("dm.dmsoft")
    Delay 500
    Call 塔防精灵句柄(0,0)
    Delay 500
    dm.SetPath "c:\test_game"
    Delay 500
    dm_ret = dm.SetDict(0, "字库.txt")
    Dim dzhzbool,返回主页面按钮i,残忍拒绝字体i,子窗口hwnd,游戏断线重连ck,联盟自动抢房间ck,红叉i,返回主页面按钮iInfo,寒冰ck
    寒冰ck = Form1.CheckBox46.Value
    返回主页面按钮iInfo = 2
    If 寒冰ck = 1 Then 
        返回主页面按钮iInfo = 10000
    End If
    返回主页面按钮i = 0
    残忍拒绝字体i = 0
    红叉i = 0 
    子窗口hwnd = Plugin.Window.FindEx(hwnd, 0, "Chrome_RenderWidgetHostHWND", 0)   
    TracePrint "子线程塔防精灵子窗口句柄：" & 子窗口hwnd
    游戏断线重连ck = Form1.CheckBox39.Value
    联盟自动抢房间ck = Form1.CheckBox62.Value
    Set fpost = CreateObject("Msxml2.ServerXMLHTTP.3.0")
    强制合作ck = Form1.CheckBox28.Value
    等待凌晨切换对战ck = Form1.CheckBox43.Value
    oldDate = Now
    Do
        TracePrint "子线程1运行中...."
        If get合作标志() = 1 and get合作抢房间变量() >= 0 Then 
            TracePrint "合作标志...."
            dm.Delay 200
            dzhzbool= 判断当前是否在战场中()
            If dzhzbool = 1 Then 
                TracePrint "合作子程序判断了再战斗中了"
                Call 合作抢房间变量Handle()
                dm.Delay 15000
                返回主页面按钮i = 0
                残忍拒绝字体i = 0
                红叉i = 0
            End If
				
				
            第二天凌晨 = 是否是第二天凌晨(35)
            If 第二天凌晨 = 1 and 强制合作ck = 0 and  等待凌晨切换对战ck = 1 Then 
                Call 合作抢房间变量Handle()
                TracePrint "到第二天了，结束合作"
            End If
				
            If dzhzbool = 0 Then
                If 合作匹配对手没进来() <> "0" Then 
                    dm.Delay 60000   
                    坐标 = 合作匹配对手没进来()
                    If 坐标 <> "0" Then 
                        获得坐标数组 = Split(Trim(坐标), ",")
                        Call MoveToFcn(Int(获得坐标数组(0)), Int(获得坐标数组(1)))
                        dm.Delay 50
                        dm.LeftClick 
                    End If
                End If
						
                dm.Delay 200
                If 对战结束确定() = 1 Then 
                    dm.Delay 60000
                    If  对战结束确定() = 1 Then 
                        Call  合作标志Handle(0)
                        TracePrint "合作子程序判断了对战结束确定"
                        Call MoveToFcn(515,535)
                        dm.Delay 50
                        dm.LeftClick 
                    End If
                End If
    					
                //未读消息
                dm.Delay 200
                dm_ret = remoteFindPic("未读消息.tif", "873,526,910,558", 0.8, 1)
                If len(dm_ret) > 0 Then 
                    TracePrint "合作子程序判断了未读消息"
                    Call MoveToFcn(926, 542)
                    dm.Delay 100
                    dm.LeftClick 
                End If
                dm.Delay 50
            		
                If 社交频道入口(0) = 1 Then 
                    dm.Delay 1000
                    Call MoveToFcn(977, 477)
                    dm.Delay 100
                    dm.LeftClick 
                End If
    					
                dm.Delay 50
            		 
                dm_ret = remoteFindPic("关闭红叉标志.tif", "776,102,828,136", 0.8, 1)
                If len(dm_ret) > 0 Then 
                    dm.Delay 10000
                    dm_ret = remoteFindPic("关闭红叉标志.tif", "776,102,828,136", 0.8, 1)
                    If len(dm_ret) > 0 Then 
                        Call MoveToFcn(804,119)
                        dm.Delay 200
                        dm.LeftClick 
                        TracePrint "检查到头像红叉"
                    End If
    						
                End If
						
                If 输入对话框完成坐标() <> "0" Then 
                    dm.Delay 10000
                    对话框完成坐标 = 输入对话框完成坐标()
                    If 对话框完成坐标 <> "0" Then 
                        //点击完成
                        Call MoveToFcn(Int(获得坐标数组(0)), Int(获得坐标数组(1)))
                        dm.Delay 50
                        dm.LeftClick 
                        TracePrint "检测到输入框弹窗完成"
                    End If
                End If
            End If		 	
        End If		
    
        If 对战结束确定() = 1 or 主界面对战按钮a() = 1 or 判断当前是否在主界面() = 1 or 判断当前是否在战场中() = 0 or 返回主页面按钮() = 1 Then  

            If get对战标志() = 1 and get合作标志() = 0 Then

                For 3
                    dm.Delay 10000
                Next
                TracePrint "对战标志 = 1 and 合作标志 = 0...."
            ElseIf get对战标志() = 0 and get合作标志() = 0 Then
                For 3
                    If get合作标志() = 1 Then 
                        Exit For	
                    End If
                    dm.Delay 10000
                Next
                Call 英雄助力弹窗关闭()
					
                dm.Delay 100   
                dm_ret = remoteFindPic("关闭红叉标志.tif", "776,102,828,136", 0.8, 1)
                If len(dm_ret) > 0 Then 
                    dm.Delay 10000
                    dm_ret = remoteFindPic("关闭红叉标志.tif", "776,102,828,136", 0.8, 1)
                    If len(dm_ret) > 0 Then 
                        Call MoveToFcn(804,119)
                        dm.Delay 100
                        dm.LeftClick 
                        TracePrint "检查到头像红叉"
                    End If
                End If
					
                If 主界面对战按钮() = 0 and 返回主页面按钮() = 0 and 残忍拒绝字体() = 0 and get对战标志() = 0 and get合作标志() = 0 Then 
                    dm_ret = dm.FindStrFast(548, 436, 581, 460, "分", "fafafa-151515", 0.83, intX, intY)
                    dm.Delay 6000
                    If dm_ret <= -1 and get对战标志() = 0 and get合作标志() = 0 and 输入对话框完成坐标() = "0" and 主界面对战按钮() = 0 and 返回主页面按钮() = 0 and 残忍拒绝字体() = 0 Then 
                        dm.Delay 30000
                        子窗口hwnd = Plugin.Window.FindEx(hwnd, 0, "Chrome_RenderWidgetHostHWND", 0)   
                        Call Plugin.Bkgnd.LeftClick(子窗口hwnd,  588, 406)
                        TracePrint "检测出广告提前关闭"
                    End If	
                End If
					
					
                dm_ret = dm.FindStrFast(481,528,566,562, "确|定", "ffffff-151515", 0.85, intX, intY)
                If dm_ret >= 0 Then 
                    dm.Delay 5000
                    dm_ret = dm.FindStrFast(481, 528, 566, 562, "确|定", "ffffff-151515", 0.85, intX, intY)
                    If dm_ret >= 0 Then 
                        Call MoveToFcn(intX,intY)
                        dm.Delay 50
                        dm.LeftClick 
                        TracePrint "检查到试炼的确定"
                    End If
                End If
					
                TracePrint "对战标志 = 0 and 合作标志 = 0...."
            Else 
                TracePrint "其它标志...."
                For 3
                    If get合作标志() = 1 Then 
                        Exit For	
                    End If
                    dm.Delay 10000
                Next
            End If

            If 返回主页面按钮() = 1 Then 
                返回主页面按钮i = 返回主页面按钮i + 1
            End If
        	
            dm.Delay 50
            dm_ret = 全局红叉()
            If len(dm_ret) > 0 Then 
                TracePrint "全局红叉计数:" & 红叉i
                红叉i = 红叉i + 1
                If 红叉i > 2 Then 
                    Dim res
                    res = Split(dm_ret, "|")
                    dm.Delay 10000
                    Call MoveToFcn(Int(res(0)),int(res(1)))
                    dm.Delay 100
                    dm.LeftClick 
                    红叉i = 0
                    TracePrint "关闭红叉"
                End If
            End If
    	
            If 残忍拒绝字体() = 1 Then 
                残忍拒绝字体i = 残忍拒绝字体i + 1
            End If
				
								
            If 战车界面() = 1 Then 
            	 dm.Delay 15000
            	 If 战车界面() = 1 Then 
                	Call MoveToFcn(826,111)
                	dm.Delay 100
                	dm.LeftClick 
                	TracePrint "检测战车界面， 子线程进行关闭"
                 End If	
            End If
				
            If 残忍拒绝字体i > 2 Then 
                Call crjj()
                残忍拒绝字体i = 0
                TracePrint "检测到多次残忍拒绝， 子线程进行关闭"
            End If
				
            If get商店标志() = 1 Then 
                If 返回主页面按钮i > 10 Then 
                    //Call 返回关闭()
                    返回主页面按钮i = 0
                    sdjllq = 0
                    TracePrint "检测进入商店标志按钮， 子线程进行关闭"
                End If
                TracePrint "进入商店标志......"
            Else 
                If 联盟自动抢房间ck = 1 or get试炼场标志() = 1 Then 
                    If get试炼场标志() = 1 Then 
                        dm_ret = dm.FindStrFast(824, 432, 853, 462, "已", "ff3a3a-101010", 0.87, intX, intY)
                        If dm_ret >= 0 Then 
                            Call 返回关闭()
                            dm.Delay 1500
                            Call 试炼场()
                        End If
                    End If
                    If 返回主页面按钮i > 返回主页面按钮iInfo Then 
                        dm.Delay 15000
                    End If
                    If 返回主页面按钮i > 返回主页面按钮iInfo Then 
                        Call 返回关闭()
                        返回主页面按钮i = 0
                    End If
                Else
                    If 返回主页面按钮i > 返回主页面按钮iInfo Then 
                        If get合作标志() = 1 and get合作抢房间变量() > 0 Then 
                        Else 
                            Call 返回关闭()
                        End If
							
                        返回主页面按钮i = 0
                        TracePrint "检测到多次返回按钮， 子线程进行关闭"
                    End If
                    TracePrint "非商店标志......"
                End If
            End If
				

				
            dm.Delay 50
            dm_ret = dm.FindStrFast(431,584,492,619, "点|击", "ffffff-303030", 0.85, intX, intY)
            If intX > 0 and intY > 0 Then 
                Call MoveToFcn(intX+5,intY+5)
                dm.Delay 50
                dm.LeftClick 
            End If
	
            dm.Delay 50
            dm_ret = remoteFindPic("得.tif", "526,145,655,240", 0.75, 1)
            If len(dm_ret) > 0 Then 
                TracePrint "检测到得"
                Call MoveToFcn(intX+5,intY+5)
                dm.Delay 50
                dm.LeftClick 
            End If
				
            If 无广告可看() = 1 Then
                Call MoveToFcn(1018,49)
                dm.Delay 100
                dm.LeftClick 
                TracePrint "检测到暂无广告！"
            End If
				
            If 广告视频已() = 1 Then 
                TracePrint "子线程漏网之鱼的广告"
                dm.Delay 50
                Call MoveToFcn(995,74)
                dm.Delay 100
                dm.LeftClick 
                If get合作标志() = 0 Then 
                    dm.Delay 2000
                    Call MoveToFcn(936,44)
                    dm.Delay 100
                    dm.LeftClick 	
                End If
            End If
            	
            dm.Delay 50
            dm_ret = remoteFindPic("红叉.tif", "811,164,835,181", 0.8, 1)
            If len(dm_ret) > 0 and get合作标志() = 0 Then 
                dm.Delay 15000
                dm_ret = remoteFindPic("红叉.tif", "811,164,835,181", 0.8, 1) 
                If len(dm_ret) > 0 Then 
                    Call MoveToFcn(822,170)
                    dm.Delay 50
                    dm.LeftClick 
                    TracePrint "检查到广告红叉"
                End If
            	
            End If
						
            dm.Delay 50
            dm_ret =remoteFindPic("红叉.tif", "810,197,840,221", 0.8, 1)
            If len(dm_ret) > 0 and  get合作标志() = 0  Then
                dm.Delay 15000
                dm_ret = remoteFindPic("红叉.tif", "810,197,840,221", 0.8, 1)
                If len(dm_ret) > 0 Then 
                    Call MoveToFcn(824,209)
                    dm.Delay 50
                    dm.LeftClick 
                    TracePrint "检查到直冲云霄红叉"
                End If	
            End If
        	    					
            dm.Delay 50  
            dm_ret =  remoteFindPic("红叉.tif", "797,145,819,166", 0.8, 1)
            If len(dm_ret) > 0  Then
                dm.Delay 15000
                dm_ret =  remoteFindPic("红叉.tif", "797,145,819,166", 0.8, 1)
                If len(dm_ret) > 0 Then 
                    Call MoveToFcn(808,155)
                    dm.Delay 50
                    dm.LeftClick 
                    TracePrint "检测到合作弹窗界面未关闭"
                End If	
            End If
        	
            dm.Delay 50 
            dm_ret = remoteFindPic("红叉.tif", "689,212,710,229", 0.8, 1)
            If len(dm_ret) > 0  Then
                dm.Delay 30000
                dm_ret = remoteFindPic("红叉.tif", "689,212,710,229", 0.8, 1)
                If len(dm_ret) > 0 Then 
                    Call MoveToFcn(698,218)
                    dm.Delay 50
                    dm.LeftClick 
                    TracePrint "检测到合作弹窗界面未关闭2"
                End If	
            End If
        	
            dm.Delay 50 					    					
            If 输入对话框完成坐标() <> "0" Then 
                dm.Delay 10000
                对话框完成坐标 = 输入对话框完成坐标()
                If 对话框完成坐标 <> "0" Then 
                    //点击完成
                    Call MoveToFcn(Int(获得坐标数组(0)), Int(获得坐标数组(1)))
                    dm.Delay 50
                    dm.LeftClick 
                    TracePrint "检测到输入框弹窗完成"
                End If
            End If
 			 	
            dm.Delay 50 					    					
            dm_ret = remoteFindPic("活动返回.tif", "5,51,89,95", 0.8, 1)
            If len(dm_ret) > 0 Then 
                Call MoveToFcn(38,72)
                dm.Delay 50
                dm.LeftClick 
                TracePrint "检测到守护地球返回"
            End If
 			
            dm.Delay 50
            dm_ret = remoteFindPic("看广告图标.tif", "424,487,494,556", 0.8, 1)
            If len(dm_ret) > 0 Then 
                dm.Delay 15000
                dm_ret = remoteFindPic("看广告图标.tif", "424,487,494,556", 0.8, 1)
                If len(dm_ret) > 0 Then 
                    Call MoveToFcn(533,521)
                    dm.Delay 50
                    dm.LeftClick 
                    TracePrint "检测到对战欣然接受"
                End If
            End If
 			
            dm.Delay 50
            dm_ret = remoteFindPic("试炼结束.bmp", "383,135,663,256", 0.8, 1)
            If len(dm_ret) > 0 Then 
                dm.Delay 10000
                dm_ret = remoteFindPic("试炼结束.bmp", "383,135,663,256", 0.8, 1)
                If len(dm_ret) > 0 Then 
                    Call MoveToFcn(678,544)
                    dm.Delay 50
                    dm.LeftClick 
                    TracePrint "检测到试炼结束"
                End If
            End If
 			
 			
            dm.Delay 50
            If 游戏断线重连ck = 1 Then 
                Call 重新登录()
            End If
 			
 			
            //对战另一名玩家没进入对战
            dm_ret = dm.FindStrFast(281,396,797,524, "确|定", "ffffff-151515", 0.84, intX, intY)
            If dm_ret >= 0 Then 
                dm.Delay 5000
                dm_ret = dm.FindStrFast(281,396,797,524, "确|定", "ffffff-151515", 0.84, intX, intY)
                If dm_ret >= 0 Then
                    Call MoveToFcn(intX+5,intY+5)
                    dm.Delay 50
                    dm.LeftClick 
                    TracePrint "检查到试炼的确定"
                End If
            End If
            
            //对战奖励防止卡死问题
            If get合作标志() = 0 Then 
                TracePrint "对战奖励防止卡死问题"
                Call MoveToFcn(1033,47)
                dm.Delay 60
                dm.LeftClick
            End If
 		
        Else 
			
            dm.Delay 2000
            If 游戏断线重连ck = 1 Then 
                Call 重新登录()
            End If
            dm.Delay 2000
            If 判断当前是否在战场中() = 1 Then 
                TracePrint "返回主页面按钮i and 残忍拒绝字体i 红叉i 重制了"
                红叉i = 0
                返回主页面按钮i = 0
                残忍拒绝字体i = 0
    			
                dm_ret = remoteFindPic("红叉.tif", "787, 120, 816, 139", 0.8, 1) 
                If len(dm_ret) > 0 Then 
                    dm.Delay 5000
                    dm_ret = remoteFindPic("红叉.tif", "787, 120, 816, 139", 0.8, 1) 
                    If len(dm_ret) > 0 Then 
                        Call MoveToFcn(799, 126)
                        dm.Delay 50
                        dm.LeftClick 
                    End If	
                End If
            End If
        End If			
    Loop
   
    
    If Form1.CheckBox117.Value = 0 Then 
        LogStop 
    End If

End Sub 
 
 
 
Sub 主线程()
    //加个判断请求
    Set fpost = CreateObject("Msxml2.ServerXMLHTTP.3.0")
    Dim respost
    respost = post_url("", "http://127.0.0.1:"& pyport & "/getIslogin")
    TracePrint "respost:" & respost
    If  len(respost) <= 0 Then 
        MessageBox "服务端异常，请检查服务端是否已登录：请先注册再启动！"
        Set fpost = Nothing
        ExitScript
    End If

    开启日志 = Form1.CheckBox117.Value
    //记录日志开始
    If 开启日志 = 0 Then 
        LogStart "C:\test_game\tfjlChild.log" 
    End If



    Call 大漠插件()
    hwnd = 0
    Call 塔防精灵句柄(0, 0)

    Plugin.Msg.Tips "脚本已启动成功，请耐心等待。。。"

    If Form1.CheckBox89.Value = 1 Then 	
        Delay 500
        Plugin.lxj_Plug.lxj_TopWindow hwnd, 1
    Else 
	
        Plugin.lxj_Plug.lxj_TopWindow hwnd, 1
        Delay 500
        Plugin.lxj_Plug.lxj_TopWindow hwnd, 0
    End If

    If Form1.Label98.Caption = "yes" or Form1.Label99.Caption = "yes" Then 
	
    Else
        Delay 50
        dm.MoveWindow hwnd, 0, 0
    End If

    //此函数调用以后，并不会更改系统电源设置. 
    If Form1.CheckBox32.Value = 1 Then 
        //dm.DisablePowerSave 
        TracePrint "此函数调用以后，并不会更改系统电源设置"
    End If

    //设置当前的电源设置，禁止关闭显示器，禁止关闭硬盘，禁止睡眠，禁止待机. 不支持XP. 
    If Form1.CheckBox33.Value = 1 Then 
        //dm.DisableCloseDisplayAndSleep 
        TracePrint "禁止关闭显示器，禁止关闭硬盘，禁止睡眠，禁止待机"
    End If
 
  
    当前线程=0
    合作抢房间变量=0
    If Form1.Label98.Caption = "yes" Then 
        当前线程 = 1
    ElseIf Form1.Label99.Caption = "yes" Then
        当前线程 = 2
    End If
    TracePrint "当前线程:" & 当前线程
    
    Call setHwnd(hwnd)
   
    
    寒冰ck = Form1.CheckBox46.Value
    对战ck = Form1.CheckBox27.Value
    降杯ck =  Form1.CheckBox14.Value
    //合作刷金币
    是否合作刷金币 = Form1.CheckBox16.Value

    //If 对战ck = 1
    对战阵容英雄str = Trim(Form1.InputBox14.Text)
    对战核心英雄ck= Form1.CheckBox23.Value
    对战核心英雄优先str = Trim(Form1.InputBox18.Text)
    对战要卖的英雄ck = Form1.CheckBox20.Value
    对战要卖的卡牌str = Trim(Form1.InputBox16.Text)
    对战有紫卡优先升级ck = Form1.CheckBox22.value
    对战只升一级ck  = Form1.CheckBox24.Value
    //对战只升一级ck = Form1.CheckBox96.Value
    对战只升级一次的卡牌Str = Trim(Form1.InputBox24.Text)
    对战血量判断ck = Form1.CheckBox74.Value
    对战魂精灵判断ck = Form1.CheckBox80.Value
    对战血量判断1index = Form1.ComboBox42.ListIndex
    对战魂精灵判断1index = Form1.ComboBox43.ListIndex
    
    对战胜利看广告ck = Form1.CheckBox9.Value
    对战失败看广告ck = Form1.CheckBox29.Value
    对战结束不看广告ck = Form1.CheckBox40.Value
    对战指定第六格子ck = Form1.CheckBox72.Value
    对战控制英雄格子 = Trim(Form1.InputBox32.text)
    对战前期不上的英雄ck = Form1.CheckBox71.Value 
    对战前期不上的英雄str = Trim(Form1.InputBox30.Text)
    对战核心英雄加入1ck = Form1.CheckBox64.Value
    对战核心英雄加入1index = Form1.ComboBox21.ListIndex
    对战核心英雄加入1hindex =Form1.ComboBox22.ListIndex
    对战核心英雄加入2ck = Form1.CheckBox69.Value
    对战核心英雄加入2index = Form1.ComboBox27.ListIndex
    对战核心英雄加入2hindex = Form1.ComboBox28.ListIndex
    对战核心英雄加入3ck = Form1.CheckBox70.Value
    对战核心英雄加入3index = Form1.ComboBox29.ListIndex
    对战核心英雄加入3hindex = Form1.ComboBox30.ListIndex
    对战5Buffck = Form1.CheckBox95.Value
    对战满星英雄判断str = Trim(Form1.InputBox12.Text)
    对战满星英雄后强制加入核心栏str = Trim(Form1.InputBox44.Text)
    对战扩建控制index = Form1.ComboBox2.ListIndex
    对战默认装备index = Form1.ComboBox12.ListIndex
	
    对战英雄全满级时英雄切换ck = Form1.CheckBox98.Value
    对战英雄全满级时英雄切换str = Trim(Form1.InputBox45.Text)
    对战英雄全满级时英雄切换数组 = Array()
