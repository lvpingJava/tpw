Function 获取识别到的英雄(card)
    获取识别到的英雄 = 0
    Dim sbi
    For sbi = 0 To 2
        If 识别到的英雄数组(sbi) = card Then 
            获取识别到的英雄 = 1
            Exit For
        End If
    Next
End Function


Function 获取识别到的英雄坐标(card)
    获取识别到的英雄坐标 = "无"
    Dim sbi
    For sbi = 0 To 2
        If 识别到的英雄数组(sbi) = card Then
            获取识别到的英雄坐标 = 识别到的英雄坐标数组(sbi)
            Exit For
        End If
    Next
End Function

Function 英雄判断是否存在(card)
    英雄判断是否存在 = 0
    dm.Delay 30
    dm_ret = remoteFindPic(card,"400,517,640,608",0.81,0)
    If len(dm_ret) > 1  Then
        英雄判断是否存在 = 1	
    End If
End Function


Function 识别到的英雄(card,x,y)
    识别到的英雄 = add识别到的英雄(card, x, y)
End Function

Function add识别到的英雄(识别card, x, y)
    add识别到的英雄 = 0
    Dim isAdd,iia
    isAdd = 1
    For iia = 0 To 2
        If 识别到的英雄数组(iia) = 识别card Then 
            isAdd = 0
            Exit Function
        End If
    Next
	
    If isAdd = 1 Then 
        For iia = 0 To 2
            If IsNumeric(识别到的英雄数组(iia)) = -1 Then 
                识别到的英雄数组(iia) = 识别card
                识别到的英雄坐标数组(iia) = x & "," & y
                add识别到的英雄 = 1
                Exit For
            End If
        Next
    End If
End Function

//初始化卡组选择
Function 卡组选择()
    If 对战ck = 1 Then
       Call 选择出战卡组(1)
       Call 战车选择(对战卡组战车)
    ElseIf 是否合作刷金币 = 1 and 寒冰ck = 0 Then
       Call 选择出战卡组(3)
       Call 战车选择(合作卡组战车)
    ElseIf 降杯ck = 1 Then
       Call 选择出战卡组(2)
    ElseIf 寒冰ck = 1 Then
       Call 选择出战卡组(4)
       Call 战车选择(寒冰卡组战车)
    End If
    
End Function
 
Sub 战车选择(index)
	If index > 0
		dm.Delay 1000
    	dm_ret = remoteFindPic("关闭红叉标志.tif", "776,102,828,136", 0.8, 1)
    	If len(dm_ret) > 0  Then
        	Call MoveToFcn(804,119)
        	dm.Delay 50
        	dm.LeftClick 
        	TracePrint " 战车选择-检查到头像红叉1"
    	End If
    	
    	For 5
    		dm.Delay 1000
    		dm_ret = remoteFindPic("打开战车.bmp", "616,458,656,493", 0.8, 1)
    		If len(dm_ret) > 0 Then 
    			Call MoveToFcn(637,471)
        		dm.Delay 50
        		dm.LeftClick 
        		TracePrint "检查到打开战车界面"
    			Exit For
    		End If
    		
    		dm_ret = remoteFindPic("关闭红叉标志.tif", "776,102,828,136", 0.8, 1)
    		If len(dm_ret) > 0  Then
        		Call MoveToFcn(804,119)
        		dm.Delay 50
        		dm.LeftClick 
        		TracePrint " 战车选择-检查到头像红叉2"
    		End If
    	Next
    	
    	For 5
    		dm.Delay 1000
    		If 战车界面() = 1  Then 
    			TracePrint "检查到已打开战车界面"
        		Exit For
    		End If
    	Next
    	
    	
    	
		Dim 战车号,战车坐标index,maxi,战车坐标Str,获得坐标数组,dm_ret1,dm_ret2
		战车号 = index
		战车坐标index = 0
		
		Call 战车滚动初始化()
		
		If 战车号 <= 7 Then 
			战车坐标index = 战车号 - 1
		Else 
			maxi = 战车号 - 8
			For i= 0 to maxi
				Call 战车滚动()
				dm.Delay 50
				dm.WheelUp 
				If i > 1 and i< 7 Then 
					dm.WheelUp 
				End If
				dm.Delay 350
			Next
			战车坐标index = 6
		End If
		
		For 3
			dm.Delay 500
			战车坐标Str=战车坐标(战车坐标index)
			获得坐标数组 = Split(Trim(战车坐标Str), ",")
			Call MoveToFcn(Int(获得坐标数组(0)), Int(获得坐标数组(1)))
			dm.Delay 50
			dm.LeftClick 
		Next
		

    	For 5
    		dm.Delay 500
    		If 战车界面() = 1 Then 
    			Call MoveToFcn(826,111)
            	dm.Delay 100
            	dm.LeftClick 
        		TracePrint "战车选择确定"
            	Exit For
    		End If
    	Next
		
		For 3
			dm.Delay 500
			dm_ret1 = remoteFindPic("对话框确定.bmp", "595,445,697,485", 0.8, 1)
			dm_ret2 = dm.FindStrFast(595,445,697,485, "确|定", "ffffff-303030", 0.83, intX, intY)
			If len(dm_ret1) > 0 or  dm_ret2 >= 0 Then
   				Call MoveToFcn(689,464)
        		dm.Delay 50
        		dm.LeftClick 
        		Exit For
			End If
		Next

	End If		
End Sub

Sub 战车滚动()
	Call MoveToFcn(223, 484)
	For 10
		dm.WheelUp
		dm.Delay 50
	Next
End Sub


Sub 战车滚动初始化()
	Call MoveToFcn(223,484)
	For 300
		dm.WheelDown
		dm.Delay 5
	Next
End Sub

Function 获取合作中要喊话的关卡()
    //合作中要卖的英雄
    If 合作喊话ck = 1 and 是否合作刷金币 = 1 and 寒冰ck = 0 Then 
        If len(Trim(合作喊话str)) > 0 Then 
            合作喊话str = Replace(合作喊话str, vbcrlf, "")
            合作喊话str = 字符串竖杠处理(合作喊话str)
            合作中要喊话的关卡 = Split(Trim(合作喊话str), "|")
            Dim hzmyxi,合作中要卖英雄关卡Str, 合作中要卖英雄关卡数组,合作中要卖英雄关卡数组长度
            For hzmyxi = 0 To UBound(合作中要喊话的关卡)
                合作中要卖英雄关卡Str = Trim(合作中要喊话的关卡(hzmyxi))
                合作中要卖英雄关卡Str = Replace(合作中要卖英雄关卡Str, vbcrlf, "")
                If len(Trim(合作中要卖英雄关卡Str)) > 0 Then
                    合作中要卖英雄关卡数组 = Split(Trim(合作中要卖英雄关卡Str), "-")
                    合作中要卖英雄关卡数组长度 = UBound(合作中要卖英雄关卡数组)
                    If 合作中要卖英雄关卡数组长度 <> 3 Then 
                        TracePrint "合作中要喊话的关卡配置错误:" & 合作中要卖英雄关卡Str
                        MessageBox "合合作中要喊话的关卡配置错误！请检查格式！"
                        ExitScript
                    Else 
						
                    End If
                End If
            Next

        End If
		
    End If
End Function


