Function 合作血条判断(血量值)
    合作血条判断 = 0
    dm_ret = dm.FindColor(107,77,422,85, "e43320-101010", 0.83,3, intX, intY)
    If dm_ret = 1 Then 
        血量 = 421 - Int(intX)
        If 血量值 = -1 Then
            If 血量 < 100 Then 
                合作血条判断 = 1
                TracePrint "血量高于75%不用加血"
            End If	
        ElseIf 血量值 = 0 Then 
            If 血量 >= 240  Then
                TracePrint "血量小于10%了"
                合作血条判断 = 1 
            End If     
        ElseIf 血量值 = 1 Then
            If 血量 >= 215 Then
                TracePrint "血量小于20%了"
                合作血条判断 = 1
            End If     
        ElseIf 血量值 = 2 Then
            If 血量 >= 195  Then
                TracePrint "血量小于30%了"
                合作血条判断 = 1
            End If   
        ElseIf 血量值 = 3 Then
            If 血量 >= 175  Then
                TracePrint "血量小于35%了"
                合作血条判断 = 1
            End If  
        ElseIf 血量值 = 4 Then
            If 血量 >= 155 Then
                TracePrint "血量小于50%了"
                合作血条判断 = 1
            End If   	
        ElseIf 血量值 = 5 Then
            If 血量 >= 135   Then
                TracePrint "血量小于60%了"
                合作血条判断 = 1
            End If   
        ElseIf 血量值 = 6 Then
            If 血量 >= 120   Then
                TracePrint "血量小于70%了"
                合作血条判断 = 1
            End If 
        ElseIf 血量值 = 7 Then 
            If 血量 >= 84   Then
                TracePrint "血量小于80%了"
                合作血条判断 = 1
            End If
        ElseIf 血量值 = 8 Then
            If 血量 >= 45  Then 
                TracePrint "血量小于90%了"
                合作血条判断 = 1
            End If
        End If		
    End If	
End Function

Function 对战核心英雄动态调整()
    If 对战核心英雄加入1ck = 1  Then 
        TracePrint "已进入对战核心英雄动态调整1"
        card = 对战要加入的核心英雄(0)
        If 获取核心英雄优先数组(card) = 1 Then 
            Exit Function
        End If
		
        card1 = 对战对手英雄(0)
        If card1 <> "0" and card <> "0" Then 
            If getCard(card) = 1 Then 
                TracePrint "当前要动态加入的英雄为：" & card
                If card1 = "萌萌" Then 
                    If 对战萌萌标识() = 1 Then 
