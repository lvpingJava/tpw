Function 是否带了要买卡牌的英雄()
    Dim abc1, abc2, abc3, abc4
    abc2 = UBound(当前卡牌阵容)
    abc3 = UBound(对战要卖的卡牌数组)
    For abc1 = 0 To abc2
        For abc4 = 0 To abc3
            If 当前卡牌阵容(abc1) = 对战要卖的卡牌数组(abc4) Then 
                是否有要买卡牌的英雄 = 1
                TracePrint "当前阵容有要买卡牌的英雄"
                Exit For
            End If
        Next
    Next
End Function


Function 对战是否有要买卡牌的英雄(card)
    If 对战要卖的英雄ck = 1 and 对战ck = 1 Then 
        For mki = 0 To 对战要卖的卡牌数组max
            If 对战要卖的卡牌数组(mki) = card Then 
                对战是否有要买卡牌的英雄 = 1
                Exit For
            End If
        Next
    End If
End Function

Function 删除对战要卖的卡牌英雄(card)
    If 对战要卖的英雄ck = 1 and 对战ck = 1 Then 
        For mki = 0 To 对战要卖的卡牌数组max
            If 对战要卖的卡牌数组(mki) = card Then 
                对战要卖的卡牌数组(mki) = 0
                Exit For
            End If
        Next
    End If
End Function


