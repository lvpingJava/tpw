Function 当前卡牌排序()     
    当前卡牌排序 = ""
    For zzz1 = 0 To 9
        当前卡牌排序 = 当前卡牌排序 & 当前卡牌阵容(zzz1) & ","
    Next
    TracePrint 当前卡牌排序
End Function


//调整卡牌任意位置
Function 卡牌阵容排序(card, index)
    If 当前卡牌阵容(index) = card Then 
        TracePrint card &":已在目标位置不需要排序"
        Exit Function
    End If
    
    Dim tzmax,aval,aindex,i	
    tzmax = 9
    aval = 0
    aindex = 0
    For i = 0 To tzmax
        If aindex <= tzmax Then 
            aval = 当前卡牌阵容(aindex)
        End If 
   		
        If aval = card and aindex <> tzmax Then 
            aindex = aindex+1
            aval = 当前卡牌阵容(aindex)
        End If
   		
   		
        if i = index Then
            卡牌阵容临时数组(index) = card
        Else
            卡牌阵容临时数组(i) = aval
            aindex = aindex+1
        End If
   		
      
    Next
    当前卡牌阵容 = 卡牌阵容临时数组
 	
    If 开启日志 = 0 Then 
        TracePrint card &":调整卡牌顺序为："& index
        Call 当前卡牌排序()
    End If	
End Function

//调整卡牌顺序（插入最后面）
Function 调整卡牌顺序后(card)
    Dim 变量,tz,tzmax
    tzmax = UBound(当前卡牌阵容)
    If 当前卡牌阵容(tzmax) = card Then 
        TracePrint card &":已在目标位置不需要排序"
        Exit Function
    End If
  
    变量 = 0
    For tz = 0 To tzmax
        If tz = tzmax Then
            卡牌阵容临时数组(tz) = card
        ElseIf card = 当前卡牌阵容(tz) Then
            变量 = 1
            卡牌阵容临时数组(tz) = 当前卡牌阵容(tz+1)
        ElseIf 变量 = 1 Then
            卡牌阵容临时数组(tz) = 当前卡牌阵容(tz+1)    
        Else 
            卡牌阵容临时数组(tz) = 当前卡牌阵容(tz) 
        End If
    Next
    当前卡牌阵容 = 卡牌阵容临时数组
   
    
  
    If 开启日志 = 0 Then 
        TracePrint card &":调整卡牌顺序后："
        Call 当前卡牌排序()
    End If
   
End Function


//调整卡牌顺序（插入最前面）
Function 调整卡牌顺序(card)
    If 当前卡牌阵容(0) = card Then 
        TracePrint card &":已在目标位置不需要排序"
        Exit Function
    End If	
    //tzmax = UBound(当前卡牌阵容)
    Dim 变量,tz
    变量 = 0
    For tz = 0 To 9
        If tz = 0 Then
            卡牌阵容临时数组(tz) = card
        ElseIf card = 当前卡牌阵容(tz-1) Then
            变量 = 1
            卡牌阵容临时数组(tz) = 当前卡牌阵容(tz)
        ElseIf 变量 = 1 Then
            卡牌阵容临时数组(tz) = 当前卡牌阵容(tz)    
        Else 
            卡牌阵容临时数组(tz) = 当前卡牌阵容(tz-1) 
        End If
    Next
    当前卡牌阵容 = 卡牌阵容临时数组
   
   
    If 开启日志 = 0 Then 
        TracePrint card &":调整卡牌顺序最前面："
        Call 当前卡牌排序()
    End If
   
   
End Function

Sub 紫卡统计顺序输出
    zcstr = ""
    For i2=0 To 6
        dds = 当前紫卡数组(i2)
        zcstr =zcstr & dds & ","
    Next
    TracePrint "紫卡统计顺序输出为：" & zcstr
End Sub	

