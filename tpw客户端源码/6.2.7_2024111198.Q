Function 关闭好友头像()
    关闭好友头像 = 0
    dm_ret = remoteFindPic("好友头像叉1.bmp", "599,93,732,116", 0.8, 1)
    If len(dm_ret) > 0 Then 
        Dim res
        res = Split(dm_ret, "|")
        Call MoveToFcn(int(res(0)+3),int(res(1))+3)
        dm.Delay 50
        dm.LeftClick 
        TracePrint "关闭好友头像成功"
        关闭好友头像 = 1
    End If
End Function
Function 好友房间合作(tag)
    If 好友房间自动识别ck = 1 Then
        TracePrint "好友合作来了"
        If tag = 1 Then 
            Goto 好友房间直接执行
        End If
        //聊天窗口
        If 1 = 1 Then 
            Do	
                dm.Delay 60
                If 社交频道入口(0) = 1 Then 
                    Call MoveToFcn(976,470)
                    dm.Delay 200
                    dm.LeftClick 
                    dm.Delay 2000
					
                    If 世界频道社交() = 1 Then 
                        //点击好友
                        Call MoveToFcn(785,65)
                        dm.Delay 200
                        dm.LeftClick 
                        dm.Delay 1500
                        dm.LeftClick 	
                        dm.Delay 500
   
                       
                        dm.Delay 200  
                        dm_ret = remoteFindPic("暂无好友聊天.tif", "750,316,786,354", 0.8, 1)
                        If len(dm_ret) > 0 Then 
                            Do
								
                                dm.Delay 200      
                                dm_ret = remoteFindPic("暂无好友聊天.tif", "750,316,786,354", 0.8, 1)
                                If len(dm_ret) > 0 Then 
								
                                Else 
                                    Exit Do
                                End If    
                                TracePrint "等待好友中....."
                                dm.Delay 8000
								
                            Loop	
							
                        End If
							
                        If tag = 1 Then 
                            Rem 好友房间直接执行
                            //点击好友
                            Call MoveToFcn(785,65)
                            dm.Delay 200
                            dm.LeftClick 
                            dm.Delay 1500
                            dm.LeftClick 	
                            dm.Delay 500
                        End If	
							
   						
   						
                        //点击第一个好友头像
                        Call MoveToFcn(643,136)
                        dm.Delay 500
                        dm.LeftClick 
                        dm.Delay 500
                        dm.LeftClick 
   						
                        好友房间号 = 获取好友房间号()
                        TracePrint "得到最终房间号： " & 好友房间号
   						
                        dm.Delay 500
                        If tag = 1 Then 
                            Call 关闭好友头像()
                        Else 
                            //点击好友头像的叉
                            Call MoveToFcn(667,107)
                            dm.Delay 100
                            dm.LeftClick 
                        End If
   						
   						
                        If 好友房间自动识别ck = 1 and 好友房间号 = 0 Then 
                            If 社交喊话ck = 1 or 世界喊话ck = 1 Then 
                                If 好友消息通知() = 1 Then 
                                    Do	While 好友房间号 = 0
                                        //点击第一个好友头像
                                        Call MoveToFcn(643,136)
                                        dm.Delay 500
                                        dm.LeftClick 
                                        dm.Delay 500
                                        dm.LeftClick 
                                        好友房间号 = 获取好友房间号()
                                        dm.Delay 500
                                        //点击好友头像的叉
                                        If tag = 1 Then 
                                            Call 关闭好友头像()
                                        Else 
                                            //点击好友头像的叉
                                            Call MoveToFcn(667,107)
                                            dm.Delay 100
                                            dm.LeftClick 
                                        End If
                                        If 好友消息通知() = 0 Then 
                                            Exit Do
                                        End If
                                    Loop
   			
                                End If
                            End If
                        End If
   						
                        dm.Delay 500
                        Call 关闭通讯()
   						
                        If 好友房间号 > 0 Then 
                            TracePrint "拿到最终房间号：" & 好友房间号
                            //打开助战
                            is合作次数 = 1
                            For 5
                                If 合作助战() = 1 Then 
                                    is合作次数 = 0
                                    Exit For 
                                End If
                                dm.Delay 600
                                Call 关闭通讯()
                            Next
                            If is合作次数 = 0 Then 
   										   								
                                Call MoveToFcn(629,571)
                                dm.Delay 200
                                dm.LeftClick 
                                dm.Delay 1000
                                is合作次数 = 1
                                For 5
                                   
                                    If 合作助战弹窗() = 1 Then 
                                        TracePrint "助战合作"
                                        //点击输入框
                                        Call MoveToFcn(504,358)
                                        dm.Delay 100
                                        dm.LeftClick 
                                        dm.Delay 1000
                                        Call 喊话输入(好友房间号)
   										
                                        //确定助战
                                        dm.Delay 1000
                                        For 1
                                            Call MoveToFcn(524,430)
                                            dm.Delay 50
                                            dm.LeftClick 
                                            dm.Delay 100	
                                        Next
                                        For 8
                                            dm.Delay 300
                                            If 加入房间失败() = 1 Then 
                                                好友房间号 = 0
                                                Exit For
                                            End If
                                        Next
                                        If 好友房间号 > 0 Then 
                                            dm.Delay 5000
                                        End If
                                        //关闭助战
                                        Call 关闭助战()
   										
                                        is合作次数 = 0
                                        Exit For
                                    End If
                                    dm.Delay 500	
                                Next
   								
                                If 判断当前是否在战场中() = 1 and 好友房间号 > 0 Then 
                                    当前在战斗 = 1
                                    TracePrint "进入好友战场了"
                                    dm.Delay 100
                                    //变量初始化
                                    Call paramInit()
                                    If getCard("幻精灵") = 0 Then 
                                        装备切换 = - 1 
                                    ElseIf 默认初始装备 = "无" Then
                                        装备切换 = 1			
                                    End If
                                    //合作标志 = 1
                                    Call 合作标志Handle(1)
                                    扩建控制 = 合作前期扩建允许次数
                                    TracePrint "已进入好友房间，开始合作"
                                    Exit Do
                                End If

                            End If

   							

                            If is合作次数 = 1 Then 
                                Call MoveToFcn(629,571)
                                dm.Delay 100
                                dm.LeftClick 
                                dm.Delay 2000
   								
                                For 3
                                    dm.Delay 500
                                    //dm_ret = dm.FindPic(296,463,395,523, "与好友一起1.bmp|与好友一起2.bmp|与好友一起3.bmp", "30", 0.80, 0, intX, intY)
                                    If 合作未打完弹窗() = 1 Then 
                                        //点击与好友一起
                                        Call MoveToFcn(337,516)
                                        dm.Delay 200
                                        dm.LeftClick 
                                        dm.Delay 1500
                                        dm.LeftClick 
                                        dm.Delay 1500
   										
                                        //确定加入
                                        Call MoveToFcn(598,430)
                                        dm.Delay 200
                                        dm.LeftClick 
                                        dm.Delay 1500
                                        dm.LeftClick 
                                        dm.Delay 1500
   										
   										
                                        //点击输入框
                                        Call MoveToFcn(504,358)
                                        dm.Delay 100
                                        dm.LeftClick 
                                        dm.Delay 2000
   										
   										
                                        Call 喊话输入(好友房间号)
   										
                                        //确定助战
                                        dm.Delay 1000
                                        For 1
                                            Call MoveToFcn(524,430)
                                            dm.Delay 50
                                            dm.LeftClick 
                                            dm.Delay 100
                                        Next
                                        For 8
                                            dm.Delay 300
                                            If 加入房间失败() = 1 Then 
                                                好友房间号 = 0
                                                Exit For
                                            End If
                                        Next
                                        If 好友房间号 > 0 Then 
                                            dm.Delay 2500
                                        End If
                                        //关闭助战
                                        Call 关闭助战()
   											
                                        is合作次数 = -1
                                        Exit For
                                    End If
                                Next
                            End If
							
                            //合作看广告判断
                            If is合作次数 = 1 Then 
                                Call MoveToFcn(629,571)
                                dm.Delay 100
                                dm.LeftClick 
                                dm.Delay 1000
   								
                                For 3
                                    dm.Delay 500
                                    dm_ret = dm.FindColorBlock(430,421,448,438,"ffffff-050505|f89738-050505",0.85,170,18,17,intX,intY)
                                    If dm_ret = 1 Then 
                                        //点击看广告
                                        Call MoveToFcn(522,432)
                                        dm.Delay 50
                                        dm.LeftClick 
                                        dm.Delay 2000
                                			
                                        dm_ret = remoteFindPic("合作看广告界面.tif", "416,406,462,450", 0.8, 1)
                                        If len(dm_ret) > 0 Then 
                                            Call MoveToFcn(522,432)
                                            dm.Delay 50
                                            dm.LeftClick 
                                            dm.Delay 2000
                                        End If
   										
   										
                                        Call MoveToFcn(936,44)
                                        dm.Delay 100
                                        dm.LeftClick 
    									
                                        If 是否有免广告特权ck = 1 Then 
                                            For 30
                                                dm.Delay 1000
                                                Call MoveToFcn(936,44)
                                                dm.Delay 100
                                                dm.LeftClick 
                                                If 主界面对战按钮() = 1 or 返回主页面按钮() = 1 Then 
    												
                                                    Exit For
                                                End If
                                            Next
                                        Else	
   										
                                            广告卡r = 0
                                            无广告可看r = 0
                                            For 6
                                                dm.Delay 1000
                                                If 广告卡r = 0 Then 
                                                    广告卡r= 广告卡()
                                                End If
   			 									
                                                If 广告卡r = 2 Then 
                                                    Exit For
                                                Else
                                                    dm.Delay 1000
                                                    无广告可看r = 无广告可看()
                                                    If 无广告可看r = 1 Then 
                                                        Exit For
                                                    End If
                                                End If
   			 									
                                            Next
   		    								
                                            Call MoveToFcn(936,44)
                                            dm.Delay 100
                                            dm.LeftClick 
                                            dm.Delay 100
                                            dm.LeftClick
                                            If 主界面对战按钮() = 1 or 返回主页面按钮() = 1 Then 
                                                广告卡r = 2
                                            End If
   		    								
   		    								
                                            If 广告卡r <> 2 Then 
                                                If 无广告可看r <> 1 Then 
                                                    Call 关闭广告()
                                                End If
                                            End If			
                                        End If
                                        //点合作
                                        dm.Delay 3000
                                        Call MoveToFcn(629,571)
                                        dm.Delay 200
                                        dm.LeftClick 
                                        dm.Delay 2000
                    							
                                        For 3
                                            dm.Delay 1000
                                            //dm_ret = dm.FindPic(296,463,395,523, "与好友一起1.bmp|与好友一起2.bmp|与好友一起3.bmp", "30", 0.80, 0, intX, intY)
                                            If 合作未打完弹窗() = 1 Then 
                                                //点击与好友一起
                                                Call MoveToFcn(337,516)
                                                dm.Delay 200
                                                dm.LeftClick 
                                                dm.Delay 1500
                                                dm.LeftClick 
                                                dm.Delay 1500
   												
                                                //确定加入
                                                Call MoveToFcn(598,430)
                                                dm.Delay 200
                                                dm.LeftClick 
                                                dm.Delay 1500
                                                dm.LeftClick 
                                                dm.Delay 1500
   												
   												
                                                //点击输入框
                                                Call MoveToFcn(504,358)
                                                dm.Delay 100
                                                dm.LeftClick 
                                                dm.Delay 2000
   												
                                                Call 喊话输入(好友房间号)
   												
                                                //确定助战
                                                dm.Delay 1000
                                                For 1
                                                    Call MoveToFcn(524,430)
                                                    dm.Delay 50
                                                    dm.LeftClick 
                                                    dm.Delay 100
                                                Next 
                                                For 8
                                                    dm.Delay 300
                                                    If 加入房间失败() = 1 Then 
                                                        好友房间号 = 0
                                                        Exit For
                                                    End If
                                                Next
                                                If 好友房间号 > 0 Then 
                                                    dm.Delay 2500
                                                End If
                                                //关闭助战
                                                Call 关闭助战()
   													
                                                is合作次数 = -1
                                                Exit For
                                            End If
                                        Next
   										
   										
                                        Exit For
                                    End If
                                Next
                            End If
							
							
                        Else 
                            TracePrint "当前好友没房间号：" & 好友房间号
                        End If
                    Else
                        TracePrint "没找到社交"
                        dm.Delay 500
                        Call 关闭通讯()	 
                    End If
                Else 
                    Call 关闭通讯()	
                End If
				
                If 好友房间号 > 0 Then 
                    //变量初始化
                    Call paramInit()
                    If getCard("幻精灵") = 0 Then 
                        装备切换 = - 1 
                    ElseIf 默认初始装备 = "无" Then
                        装备切换 = 1			
                    End If
                    //合作标志 = 1
                    Call 合作标志Handle(1)
                    扩建控制 = 合作前期扩建允许次数
                    
                    For 40
                        dm.Delay 1000
                        If 判断当前是否在战场中() = 1 Then 
                            TracePrint "进入战场了"
                            当前在战斗 = 1
                            TracePrint "已进入好友房间，开始合作"
                            Exit Do
                        End If
                        If 对战结束确定() = 1 Then 
                            当前在战斗 = 0
                            TracePrint "好友合作子程序判断了对战结束确定"
                            Call MoveToFcn(515,535)
                            dm.Delay 100
                            dm.LeftClick 
                            好友房间号 = 0
                            Exit For
                        End If
       
                    Next
                    
                    dm.Delay 200
                    If 对战结束确定() = 1 Then 
                        当前在战斗 = 0
                        TracePrint "好友合作子程序判断了对战结束确定"
                        Call MoveToFcn(515,535)
                        dm.Delay 100
                        dm.LeftClick 
                        好友房间号 = 0
                    End If
                End If
                TracePrint "当前是否从社交喊话进入：" & tag
                If tag = 1 Then 
                    TracePrint "好友房间号:" & 好友房间号
                    If 好友房间号 = 0 Then 
                        TracePrint "进入社交喊话..."
                        For 5
                            dm.Delay 500
                            If 社交频道入口(0) = 1 Then 
                                Exit For
                            End If	
                        Next
                        Call 世界社交喊话()
                    End If
                    Exit Do
                End If		
            Loop
        End If
    End If
End Function

Function 进入寒冰主界面()
    进入寒冰主界面 = 0
    Dim  寒冰界面1,寒冰界面2, 活动, res
    Do
        If 世界频道社交() = 1 Then 
            Call MoveToFcn(620,586)
            dm.Delay 50
            dm.LeftClick 
            dm.Delay 1000
        End If
		
        For 3
            dm.Delay 500
            dm_ret = remoteFindPic("红叉.tif", "69,73,962,528", 0.85, 1)
            If len(dm_ret) > 1 Then 
                TracePrint "自动6次合作开局检查到红叉"
                res = Split(dm_ret, "|")
                Call MoveToFcn(Int(res(0)),int(res(1)))
                Delay 100
                dm.LeftClick
                红叉i = 0
                TracePrint "关闭红叉"
                Exit For
            End If
        Next

 	
        寒冰界面2 = remoteFindPic("寒冰堡.bmp", "470,126,502,157", 0.83, 1)
        If len(寒冰界面2) > 0 Then 
            进入寒冰主界面 = 1
            Exit Do
        Else 
            If 世界频道社交() = 1 Then 
                Call MoveToFcn(620,586)
                dm.Delay 50
                dm.LeftClick 
                dm.Delay 1000
            End If
		
            For 3
                dm.Delay 500
                dm_ret = remoteFindPic("红叉.tif", "69,73,962,528", 0.85, 1)
                If len(dm_ret) > 1 Then 
                    TracePrint "自动6次合作开局检查到红叉"
                    res = Split(dm_ret, "|")
                    Call MoveToFcn(Int(res(0)),int(res(1)))
                    Delay 100
                    dm.LeftClick
                    红叉i = 0
                    TracePrint "关闭红叉"
                    Exit For
                End If
            Next
		
            Call 返回关闭()
		
            活动 = remoteFindPic("活动.bmp", "31,362,93,408", 0.83, 1)
            If len(活动) > 0 Then 
                Call MoveToFcn(64,406)
                dm.Delay 50
                dm.LeftClick 
                dm.Delay 1000
			
                For 3
                    Call 鼠标向左滑动()
                Next
			
                For 10
                    dm.Delay 2000
                    寒冰界面1 = remoteFindPic("寒冰.bmp", "17,470,1016,511", 0.83, 1)
                    If len(寒冰界面1) > 0 Then 
                        TracePrint "寒冰界面1:" & 寒冰界面1
                        res = Split(寒冰界面1, "|")
                        Call MoveToFcn(Int(res(0))+136,int(res(1))-49)
                        dm.Delay 100
                        dm.LeftClick
                        Exit For
                    Else 
                        Call 鼠标向左滑动()
                    End If
                Next
        	
            End If
    	
        End If
        dm.Delay 2000
    Loop
End Function


Function 好友房间寒冰()
    TracePrint "好友寒冰来了"
    Dim 好友房间号, res, 寒冰社交好友
    好友房间号 = -1
    Do
		
        If 进入寒冰主界面() = 1 Then 
            If 社交频道入口("929,453,1001,513") = 1 Then 
                Call MoveToFcn(960,486)
                dm.Delay 200
                dm.LeftClick 
                dm.Delay 2000
            End If
            
			
            寒冰社交好友 = remoteFindPic("寒冰社交好友.bmp", "666,48,749,84", 0.81, 1)
            If len(寒冰社交好友) > 0 Then 
                //点击好友
                Call MoveToFcn(705,63)
                dm.Delay 200
                dm.LeftClick 
                dm.Delay 1500
                dm.LeftClick 	
                dm.Delay 500

               
                dm.Delay 200  
                dm_ret = remoteFindPic("暂无好友聊天.tif", "750,316,786,354", 0.8, 1)
                If len(dm_ret) > 0 Then 
                    Do
						
                        dm.Delay 200      
                        dm_ret = remoteFindPic("暂无好友聊天.tif", "750,316,786,354", 0.8, 1)
                        If len(dm_ret) > 0 Then 
						
                        Else 
                            Exit Do
                        End If    
                        TracePrint "等待好友中....."
                        dm.Delay 8000
						
                    Loop	
					
                End If
					
   				
                //点击第一个好友头像
                Call MoveToFcn(643,136)
                dm.Delay 500
                dm.LeftClick 
                dm.Delay 500
                dm.LeftClick 
   				
                好友房间号 = 获取好友房间号()
                TracePrint "得到最终房间号： " & 好友房间号
   				
                dm.Delay 1000
                Call 关闭好友头像()
                dm.Delay 1000
                Call 关闭通讯()
					
                If 好友房间号 > 0 Then 
                    TracePrint "拿到最终房间号：" & 好友房间号
                    //打开助战
                    is合作次数 = 1
                    //判断寒冰是否有次数
                    If is合作次数 = 1 Then 
   										   						
                        For 100
                            //加入房间......
                            dm.Delay 1000
                            Call 关闭通讯()
                            //单击冰堡挑战
                            Call MoveToFcn(840,567)
                            dm.Delay 50
                            dm.LeftClick 
                            dm.Delay 2000
							
                            寒冰未打完助战 = remoteFindPic("寒冰未打完助战.bmp", "353,443,433,486", 0.8, 1)
                            If len(寒冰未打完助战) > 0 Then 
                                Call MoveToFcn(387,463)
                                dm.Delay 50
                                dm.LeftClick 
                                dm.Delay 1500
                            End If
    						
                            与好友一起 = remoteFindPic("与好友一起.bmp", "286,462,395,515", 0.83, 1)
                            If len(与好友一起) > 0 Then 
                                Call MoveToFcn(333,514)
                                dm.Delay 50
                                dm.LeftClick 
                                dm.Delay 1500
                            End If
    						
                            加入房间 = remoteFindPic("加入房间.bmp", "554,408,658,453", 0.80, 1)
                            If len(加入房间) > 0 Then 
                                Call MoveToFcn(605,430)
                                dm.Delay 50
                                dm.LeftClick 
                                dm.Delay 1500
                                出现房间号 = 1
                            End If
    						
                            寒冰购买助战 = remoteFindPic("寒冰购买助战.bmp", "341,442,443,488", 0.80, 1)
                            If len(寒冰购买助战) > 0 Then 
                                res = Split(寒冰购买助战, "|")
                                Call MoveToFcn(Int(res(0)),int(res(1)))
                                dm.Delay 50
                                dm.LeftClick 
                                dm.Delay 1500
                                出现房间号 = 1
                            End If
    						
                            For 5
                                加入 = remoteFindPic("加入.bmp|合作寒冰助战.bmp", "491,416,547,452", 0.80, 1)
                                If len(加入) > 0  Then 
                                    //点击输入框
                                    Call MoveToFcn(504,358)
                                    dm.Delay 100
                                    dm.LeftClick 
                                    Call 喊话输入(好友房间号)
   									
                                    //确定助战
                                    dm.Delay 1000
                                    Call MoveToFcn(524,430)
                                    dm.Delay 50
                                    dm.LeftClick 
                                    dm.Delay 100
                        			
                                    For 8
                                        dm.Delay 300
                                        If 加入房间失败() = 1 Then 
                                            好友房间号 = -1
                                            Exit For
                                        End If
                                    Next
                                    If 好友房间号 > 0 Then 
                                        dm.Delay 5000
                                    End If
                        			
                                    //关闭助战
                                    Call 关闭助战()
   									
                                    is合作次数 = 0
                                    Exit For
                                End If
                                dm.Delay 500
                            Next
    						
                            Exit For
                        Next
                    End If
                Else 
                    好友房间号 = -1		
                End If
            
            End If
                        
            If 好友房间号 > 0 Then 
                好友房间号 = -1
                For 40
                    dm.Delay 1000
                    If 判断当前是否在战场中() = 1 Then 
                        当前在战斗 = 1
                        TracePrint "进入战场了"
                        dm.Delay 50
                        //变量初始化
                        Call paramInit()
                        If getCard("幻精灵") = 0 Then 
                            装备切换 = - 1 
                        ElseIf 默认初始装备 = "无" Then
                            装备切换 = 1			
                        End If
                        //合作标志 = 1
                        Call 合作标志Handle(1)
                        扩建控制 = 合作前期扩建允许次数
                        好友房间号 = 1
                        TracePrint "已进入好友房间，开始合作"
                        Exit For
                    End If
                Next
            End If 
        End If	
    		
        dm.Delay 200
        If 对战结束确定() = 1 Then 
            当前在战斗 = 0
            TracePrint "好友合作子程序判断了对战结束确定"
            Call MoveToFcn(515,535)
            dm.Delay 100
            dm.LeftClick 
             	
        End If
       	
        If 好友房间号 <> -1 Then
            Exit Do
        End If
    	
    Loop

End Function
 
Function get好友房间号Ocr(w,sir)
    get好友房间号Ocr = ""
    If 小程序旧版 = 1 Then 
        dm_ret = UseDictFun(1)
        If w = 1 Then 		 	
            get好友房间号Ocr = dm.Ocr(703, 470, 776, 533, "2f2d24-202020|000000-202020", sir)	
        ElseIf w = 2 Then			
            get好友房间号Ocr = dm.Ocr(700, 437, 775, 500, "2f2d24-202020|000000-202020", sir)	
        ElseIf w = 3 Then			
            get好友房间号Ocr = dm.Ocr(710, 338, 768, 391, "2f2d24-202020|000000-202020", sir)	
        ElseIf w = 4 Then 			
            get好友房间号Ocr = dm.Ocr(701, 229, 783, 304, "2f2d24-202020|000000-202020", sir)	
        End If
        dm_ret = UseDictFun(0)
    ElseIf 小程序新版 = 1 Then
        dm_ret = UseDictFun(4)
         
        If w = 1 Then 
            get好友房间号Ocr = dm.Ocr(703, 470, 776, 533, "2f2d24-202020|000000-202020", 0.89)	
        ElseIf w = 2 Then	
            get好友房间号Ocr = dm.Ocr(700, 437, 775, 500, "2f2d24-202020|000000-202020", 0.89)	
        ElseIf w = 3 Then			
            get好友房间号Ocr = dm.Ocr(710, 338, 768, 391, "2f2d24-202020|000000-202020", 0.89)	
        ElseIf w = 4 Then 		
            get好友房间号Ocr = dm.Ocr(701, 229, 783, 304, "2f2d24-202020|000000-202020", 0.89)	
        End If
        dm_ret = UseDictFun(0)
    End If
End Function
 
Function UseDictFun(num)
    dm_ret = dm.UseDict(num)
    If dm_ret = 0 Then 
        For 10
            dm.Delay 200
            TracePrint "字库切换失败，再次切换a"
            dm_ret = dm.UseDict(num)
            If dm_ret = 1 Then 
                Exit For
            End If
        Next
    End If
End Function
 
Function 获取好友房间号()
    获取好友房间号 = 0
		
    For 2
        dm.Delay 500
        房间号 = get好友房间号Ocr(1,0.85)
