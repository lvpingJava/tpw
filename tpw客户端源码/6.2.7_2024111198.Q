            End If
           
        End If
    End If 
End Function

Function 退出试炼()
    退出试炼 = 0
    dm_ret = dm.FindStrFast(670,522,721,561, "试", "ffffff-202020", 0.83, intX, intY)
    If dm_ret >= 0 Then 
        退出试炼 = 1
    End If
End Function

Function 试炼场()
    If 试炼场完成 = 0 Then 
        //试炼
        dm.Delay 100
        Call MoveToFcn(62, 403)
        dm.Delay 100
        dm.LeftClick 
        For 10
            dm.Delay 1000
            dm_ret = dm.FindStrFast(434,471,478,505, "试", "ffe04c-202020", 0.83, intX, intY)
            If intX >= 0 and intY >= 0 Then 
                //增加试炼场标志
                //Call GlobalArrayDo(6,1)
                Call 试炼场标志Handle(1)
                //判断次数
                dm.Delay 1000

                dm_ret = remoteFindPic("参与试炼1.bmp|参与试炼2.bmp", "719,412,782,453", 0.8, 1)
                If len(dm_ret) > 0 Then 
                    //参与
                    dm.Delay 100
                    Call MoveToFcn(585, 427)
                    dm.Delay 100
                    dm.LeftClick 
                    dm.Delay 100
                    Call MoveToFcn(585, 427)
                    dm.Delay 100
                    dm.LeftClick 
    					
                    For 10
                        //加入试炼
                        dm.Delay 1000
                        dm_ret = dm.FindStrFast(848,545,887,578, "试", "ffffff-202020", 0.83, intX, intY)
                        If intX >= 0 and intY >= 0 Then 
                            dm.Delay 100
                            Call MoveToFcn(846, 559)
                            dm.Delay 100
                            dm.LeftClick 
                            dm.Delay 100
                            Call MoveToFcn(846, 559)
                            dm.Delay 100
                            dm.LeftClick 
                            Exit For 
                        End If
                    Next
    					
                    dm.Delay 1000
                    Call 卡牌阵容初始化()
						
                    dm.Delay 1000
                    //变量初始化
                    Call paramInit()
    					
                Else 
                    试炼场完成 = 1
                    For 3
                        Delay 1000
                        If 返回主页面按钮() = 1 Then 
                            dm.Delay 3000
                            Call 返回关闭()
                            //去除试炼场标志
                            //Call GlobalArrayDo(6, 0)
                            Call 试炼场标志Handle(0)
                            Exit For
                        End If
                    Next
	 		
                End If
				
                Exit For
            End If
        Next
    End If

	
End Function

Function 返回关闭()
    dm.Delay 1000
    If 返回主页面按钮() = 1 Then 
        //返回 关闭	 	
        Call MoveToFcn(46,76)
        dm.Delay 100
        dm.LeftClick 
    End If
End Function


Function 联盟宝箱领取()
    If 联盟宝箱是否领取 = 0 Then 
        dm.Delay 100
        dm_ret = dm.FindColor(1005,384,1020,398,"ff2727-292929",0.90,0,intX,intY)
        If dm_ret = 1 Then 
            //dm_ret = dm.FindPic(934,341,1028,445,"联盟图标.bmp","30",0.80,0,intXbx,intYbx) 
            //联盟入口
            dm_ret = dm.FindColorBlock(967,380,991,394,"8ee2f8-050505|08ace4-050505",0.85,130,24,14,intXbx,intYbx)
            dm.Delay 1000
            Call MoveToFcn(intXbx + getNum(), intYbx + getNum())
            dm.Delay 100
            dm.LeftClick 
            dm.Delay 3000
            dm_ret2 = remoteFindPic("联盟宝箱.bmp", "650,120,758,157", 0.8, 1)
            dm_ret = dm.FindStrFast(632,115,760,156,"联盟宝箱","0.0.100-0.0.9",0.85,intXbx1,intYbx1)
            If dm_ret = 1 or len(dm_ret2) > 0 Then 
                dm.Delay 1000
                Call MoveToFcn(intXbx1, intYbx1)
                dm.Delay 100
                dm.LeftClick 
                dm.Delay 3000
                dm_ret = dm.FindStrFast(809, 520, 955, 576, "一键领取", "0.0.100-0.0.21", 0.85, intXbx2, intYbx2)
                dm_ret2 = remoteFindPic("联盟宝箱领取.bmp", "833,533,935,569", 0.8, 1)
                If dm_ret = 1 or len(dm_ret2) > 0 Then 
                    dm.Delay 1000
                    Call MoveToFcn(intXbx2, intYbx2)
                    dm.Delay 100
                    dm.LeftClick 
                    dm.Delay 2000
                    dm.LeftClick 
                    dm.Delay 100
                    dm.Delay 4000
                    Call 返回关闭()
                End If
				
            End If
            联盟宝箱是否领取 = 1
        End If 
    End If
End Function


Function getNum()
    Randomize 
    num = Int((5 - 1 + 1) * Rnd + 1)
    getNum=num
End Function


Function MoveToFcn(intXX, intYY)
 	dm.MoveTo intXX, intYY
    dm.Delay 5
    dm.MoveTo intXX, intYY
    dm.Delay 5
    dm.MoveTo intXX, intYY
End Function
	
Function 任务奖励弹窗()
    dm.Delay 50
    dm_ret = remoteFindPic("红叉.tif", "746, 167, 772, 186", 0.8, 1) 
    If len(dm_ret) > 0 Then 
        Call MoveToFcn(758,175)
        dm.Delay 100
        dm.LeftClick 
    End If
	
End Function
	
	
