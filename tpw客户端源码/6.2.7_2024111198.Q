Function 输入对话框完成坐标()
    输入对话框完成坐标 = "0"
    dm.Delay 100
    dm_ret = remoteFindPic("完成.tif|完成1.tif", "152, 135, 910, 415", 0.82, 1)
    If len(dm_ret) > 0 Then 
        Dim res
        res = Split(dm_ret, "|")
        输入对话框完成坐标 = res(0) & "," & res(1)
    End If	
End Function


Function 喊话输入(htext)
    //输入文字对话框
    
    For 20	
        对话框完成坐标 = "0"
        对话框完成坐标 = 输入对话框完成坐标()
        If 对话框完成坐标 <> "0" Then 
            TracePrint "识别到对话框"
            获得坐标数组 = Split(Trim(对话框完成坐标), ",")
			
            //点击输入框
            For 5
                Call MoveToFcn(Int(获得坐标数组(0)), Int(获得坐标数组(1))-57)
                dm.Delay 100
                dm.LeftClick 
            Next
		    
            TracePrint "点击输入框"
	  		
            dm.Delay 50
            dm.SendString hwnd, htext
   			
            For 20
                dm.Delay 1000
                TracePrint "查看完成"
                If 输入对话框完成坐标() <> "0" Then 
                    //点击完成
                    Call MoveToFcn(Int(获得坐标数组(0)), Int(获得坐标数组(1)))
                    dm.Delay 100
                    dm.LeftClick 
                    dm.Delay 100
                    Exit For
                End If
            Next
            Exit For
        End If
        dm.Delay 500	
    Next
	
End Function




