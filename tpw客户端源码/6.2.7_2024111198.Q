Sub 卡牌升满统计()
    Call 卡牌在战车方向确定()
    If 卡牌在战车方向是否已确认 = 1 Then 
        zcsjSize = 0
        If 卡牌是否全部升满 = 0 or 当前合作关卡 < 检测关卡  or 是否补星 = 1 or 是否带了光精灵 = 1 Then  
            TracePrint "进入卡牌升满统计方法"
            卡牌升满后执行刷新 = 0
            升满计数 = 0
           
            If 是否有工程类英雄 = 0 Then 
                zcsjSize = 5
                TracePrint "没工程类英雄"
            Else 
                zcsjSize = 6
            End If
				
            Dim 检测关卡
            检测关卡 = 120
            //寒冰
            If 寒冰ck = 1 Then 
                检测关卡 = 19
            End If
				
            For zcsj = 0 To zcsjSize
                is满足升满条件 = 0
                If  战车上卡牌升级统计(zcsj) > 0
                    战车上的card = 战车卡牌位置数组(zcsj)
                    If IsNumeric(战车上的card) <> -1 Then 
                        If 获取不满的卡牌(战车上的card) = 1  Then 
                            is满足升满条件 = 1
                            TracePrint "当前英雄不用升满："& 战车上的card
                        End If
                    End If
	 		
                    If is满足升满条件 = 1 Then 
                        升满计数 = 升满计数 + 1
                    Else 
                        If 战车上卡牌升级统计(zcsj) < 10 and 战车上卡牌升级统计(zcsj) > 0 and 当前合作关卡 < 检测关卡  or 是否补星 = 1 or 是否带了光精灵 = 1 Then
                            If 战车上卡牌升级统计(zcsj) < 10   or 是否补星 = 1 Then 
                                If 满星检查(zcsj) = 1 Then
                                    TracePrint "检查出满了：" & 战车上的card
                                    战车上卡牌升级统计(zcsj) = 10	
                                Else 
                                    TracePrint "检查出未满：" & 战车上的card
                                    If 是否补星 = 1 Then
                                        TracePrint "检查出未满-是否补星:" & 战车上的card
                                        If 战车上卡牌升级统计(zcsj) >= 4 Then 
                                            战车上卡牌升级统计(zcsj) = 3
                                        End If
                                    
                                        卡牌是否全部升满 = 0
                                        If 中途换卡加速ck = 0 Then 
                                            Call 调整卡牌顺序(战车上的card)	
                                        End If
                                    End If
                                End If
                            End If
                        End If
							
                        If 	战车上卡牌升级统计(zcsj) >= 4 Then
                            升满计数 = 升满计数 + 1
                        End If	
                    End If
                End If	
            Next
				
				
	
            If 是否有工程类英雄 = 0 and 升满计数 = 6 Then 
                TracePrint "我满了1"
                卡牌是否全部升满 = 1
                卡牌全部升满记录 = 1
            ElseIf 升满计数 = 7 Then 
                卡牌是否全部升满 = 1
                卡牌全部升满记录 = 1
                TracePrint "我满了2"
            End If
				
            If 卡牌是否全部升满 = 0 Then 
                If 要上的卡牌数量() = 升满计数 Then 
                    TracePrint "要上的卡牌数量等于升满计数"
                    卡牌是否全部升满 = 1
                    卡牌全部升满记录 = 1
                End If
            End If

        End If
        
        If 卡牌是否全部升满 = 1 and zcsjSize > 0 Then 
            是否补星 = 0
            For zcsj = 0 To zcsjSize
                If  战车上卡牌升级统计(zcsj) < 10 Then
                    战车上的card = 战车卡牌位置数组(zcsj)
                    If IsNumeric(战车上的card) <> -1  Then 
                        If 获取后期要升满的英雄(战车上的card) = 1  Then 
                            TracePrint 战车上的card& "：再次英雄确定是否满星"
                            If  满星检查(zcsj) = 1  Then 
                                战车上卡牌升级统计(zcsj) = 10
                                Call 删除后期要升满的英雄(战车上的card)
                                TracePrint 战车上的card& "：英雄确定满星"
                            Else
                                TracePrint 战车上的card & "：检测其实未满，改成未满"
                                战车上卡牌升级统计(zcsj) = 3
                                卡牌是否全部升满 = 0
                            End If
                        End If
                    End If
                End If	
            Next
           
        End If
        TracePrint "是否全部升满=" & 升满计数
    End If	
End Sub



Function 合作卡牌升满统计(tag)
	
    If tag = 1 Then 
        是否补星 = 0
    End If	
    Call 卡牌在战车方向确定()
    If 卡牌在战车方向是否已确认 = 0 Then 
        TracePrint "合作卡牌升满统计,卡牌没确认退出"
        Exit Function
    End If
		
    TracePrint "进入合作卡牌升满统计：" & 卡牌是否全部升满
	
    zcsjSize = 0
    检测关卡 = 120
    //寒冰
    If 寒冰ck = 1 Then 
        检测关卡 = 19
    End If
    
    If 卡牌是否全部升满 = 0 or 当前合作关卡 < 检测关卡 or 是否补星 = 1 or 是否带了光精灵 = 1 Then 
        Dim 检测关卡,满星检查结果	 
        卡牌升满后执行刷新 = 0
        升满计数 = 0
        
        If  是否有工程类英雄 = 0 Then 
            zcsjSize = 5
            TracePrint "没工程类英雄"
        Else 
            zcsjSize = 6
        End If

       
				
        For zcsj = 0 To zcsjSize
            is满足升满条件 = 0 
            If  战车上卡牌升级统计(zcsj) > 0
                战车上的card = 战车卡牌位置数组(zcsj)
                If IsNumeric(战车上的card) <> -1 Then 
                    If 获取不满的卡牌(战车上的card) = 1 Then 
                        is满足升满条件 = 1
                        TracePrint "进入合作卡牌升满统计-当前英雄不用升满："& 战车上的card
                    End If
                End If
					
                If is满足升满条件 = 1 Then 
                    升满计数 = 升满计数 + 1
                Else 
                    If 战车上卡牌升级统计(zcsj) < 4 and 战车上卡牌升级统计(zcsj) > 0 or 当前合作关卡 < 检测关卡 or 是否补星 = 1 or 是否带了光精灵 = 1 Then 
                        If 战车上卡牌升级统计(zcsj) < 4 or 是否补星 = 1 Then 
                            满星检查结果 = 不弹窗满星检查("F1BC12-0E0B10",zcsj)
                            If 满星检查结果 > 0 Then 
                                If 满星检查结果 = 1 Then 
                                    TracePrint "检查出满了：" & 战车上的card
                                    战车上卡牌升级统计(zcsj) = 4
                                ElseIf 满星检查结果 = 2 Then
                                    TracePrint "检查出确定满了：" & 战车上的card
                                    战车上卡牌升级统计(zcsj) = 10
                                    Call 删除后期要升满的英雄(战车上的card)
                                End If
                                
                            Else 
                                TracePrint "检查出未满：" & 战车上的card
                                If 是否补星 = 1 Then 
                                    TracePrint "检查出未满-补星:" & 战车上的card
                                    If 战车上卡牌升级统计(zcsj) >= 4 Then 
                                        战车上卡牌升级统计(zcsj) = 3
                                    End If
                                    
                                    卡牌是否全部升满 = 0
                                    If 中途换卡加速ck = 0 Then 
                                        Call 调整卡牌顺序(战车上的card)
                                    ElseIf 中途换卡加速ck = 1 Then
                                        卡牌阵容s = split(卡牌阵容str, "|")
                                        If UBound(Filter(卡牌阵容s, 战车上的card)) = -1 Then 
                                            卡牌阵容str = 卡牌阵容str & 战车上的card & "|"
                                            TracePrint "补星后的卡牌阵容：" & 卡牌阵容str
                                        End If
                                        Call 新增后期要升满的英雄(战车上的card)
                                    End If
                                   
                                End If
                            End If
                        End If
					
                    End If
						
                    If 	战车上卡牌升级统计(zcsj) >= 4  Then
                        升满计数 = 升满计数 + 1
                    End If
					
                End If
            End If
        Next	
    End If

    If 是否有工程类英雄 = 0 and 升满计数 = 6 Then 
        TracePrint "我满了1"
        卡牌是否全部升满 = 1
        //卡牌全部升满记录 = 1
    ElseIf 升满计数 = 7 Then 
        卡牌是否全部升满 = 1
        //卡牌全部升满记录 = 1
        TracePrint "我满了2"
    End If
		
    If 卡牌是否全部升满 = 0 and tag = 0 Then 
        If 要上的卡牌数量() = 升满计数 Then 
            TracePrint "要上的卡牌数量等于升满计数"
            卡牌是否全部升满 = 1
            //卡牌全部升满记录 = 1
        End If
    End If
    
  
		
    If 卡牌是否全部升满 = 1 and zcsjSize > 0 Then 
        是否补星 = 0
        //Call 后期要升满的英雄输出()
        TracePrint "zcsjSize :"& zcsjSize
        For zcsj = 0 To zcsjSize
            If 战车上卡牌升级统计(zcsj) < 10 and 战车上卡牌升级统计(zcsj) > 0 Then 
                战车上的card = 战车卡牌位置数组(zcsj)
                is满足升满条件 = 1
                If 卡牌全部升满前期记录 = 0 Then 
                    If 获取不满的卡牌(战车上的card) = 1  Then 
                        is满足升满条件 = 0
                        TracePrint "当前英雄不用升满："& 战车上的card
                    End If
                End If
                If IsNumeric(战车上的card) <> -1 and is满足升满条件 = 1 Then 
                    If 获取后期要升满的英雄(战车上的card) = 1 or 卡牌全部升满前期记录 = 0 Then 
                        TracePrint 战车上的card& "：再次英雄确定是否满星"
                        If  满星检查(zcsj) = 1  Then 
                            战车上卡牌升级统计(zcsj) = 10
                            Call 删除后期要升满的英雄(战车上的card)
                            TracePrint 战车上的card& "：英雄确定满星"
                        Else
                            TracePrint 战车上的card & "：检测其实未满，改成未满"
                            战车上卡牌升级统计(zcsj) = 3
                            卡牌是否全部升满 = 0
                        End If
                    End If
                End If
            End If
				
        Next
			
        If 卡牌是否全部升满 = 1 Then 
            卡牌全部升满前期记录 = 1
            卡牌全部升满记录 = 1
        End If
        //Call 后期要升满的英雄输出() 
    End If
	
End Function


