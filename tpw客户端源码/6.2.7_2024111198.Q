Sub 卡牌紫卡统计()
    For zcsj = 0 To 6
        If 战车上卡牌升级统计(zcsj) = 3 and 当前已排序过紫卡数组(zcsj) = 0 Then 
            英雄坐标 = 对战战车上卡牌坐标(zcsj)
            TracePrint  zcsj & "号下标位置有紫卡，进行点击查看"
            Call 当前紫卡数据添加(战车卡牌位置数组(zcsj))
            //战车上卡牌升级统计(zcsj) = 1
            TracePrint "紫卡加入完毕..."
            //Call 紫卡统计顺序输出()
            Call 对战卡牌顺序调整()
 			 
            当前已排序过紫卡数组(zcsj) = 1

        End If
			
    Next
			
	
End Sub


Function 对战卡牌升级识别()
    If 一号金 < 2 and 战车上卡牌升级统计(0) > 0 Then 
        TracePrint "进入1号"
        For 3
            dm.Delay 5
            dm_ret2 = remoteFindPic("jinsexx.bmp", "83,456,102,473", 0.85, 2)
            TracePrint "dm_ret2:" & dm_ret2
            If  len(dm_ret2) > 0 Then 
                一号金 = 一号金 + 1
                TracePrint "1满金一次"
                If 一号金 = 2 Then 
                    TracePrint "1满金二次"
                    对战升满计数 = 对战升满计数 + 1
                    //调整位置
                    TracePrint "1号位置金色了，调整位置最后"
                    //Call 卡牌阵容排序(战车卡牌位置数组(0),对战阵容数量)
                    战车上卡牌升级统计(0) = 10
                    If 是否带了光精灵 = 1 Then 
                        If 当前是否全部升满() = 1 Then 
                            对战卡牌是否全部升满 = 1
                        End If
                    End If
    			
                    If 对战有紫卡优先升级ck = 1 Then 
                        TracePrint "删除紫卡数据"
                        Call 删除紫卡(战车卡牌位置数组(0))
                    End If
    				
                    Call 满金核心英雄加入核心栏(战车卡牌位置数组(0))
    			
                End If
            Else 
                Exit For
            End If
        Next
    End If
    Dim is土精灵
    is土精灵 = 0
    is土精灵 = getCard("土精灵")
	
    TracePrint "扩展次数:" & 扩展次数
    TracePrint "is土精灵:" & is土精灵
    If (is土精灵 = 1 or 战车上卡牌升级统计(1) > 0) and 二号金 < 2 Then 
        TracePrint "进入2号"
        For 3
 
            dm.Delay 5
            dm_ret2 = remoteFindPic("jinsexx.bmp", "39,455,58,473", 0.85, 2)
            TracePrint "dm_ret2:" & dm_ret2
            If  len(dm_ret2) > 0 Then  
                二号金 = 二号金 + 1
                TracePrint "2满金一次"
                If 二号金 = 2 Then 
                    TracePrint "2满金二次"
                    对战升满计数 = 对战升满计数 + 1
                    //调整位置
                    TracePrint "2号位置金色了，调整位置最后"
                    //Call 卡牌阵容排序(战车卡牌位置数组(1),对战阵容数量)
                    战车上卡牌升级统计(1) = 10
                    If 是否带了光精灵 = 1 Then 
                        If 当前是否全部升满() = 1 Then 
                            对战卡牌是否全部升满 = 1
                        End If
                    End If
    				
                    If 对战有紫卡优先升级ck = 1 Then 
                        TracePrint "删除紫卡数据"
                        Call 删除紫卡(战车卡牌位置数组(1))
                    End If
    				
                    Call 满金核心英雄加入核心栏(战车卡牌位置数组(1))
 
                End If
            Else 
                Exit For
            End If
        Next
    End If
	
	
    If (is土精灵 = 1 or 战车上卡牌升级统计(2) > 0) and 三号金 < 2 Then 
        TracePrint "进入3号"
        For 3
            dm.Delay 5
            dm_ret2 = remoteFindPic("jinsexx.bmp", "81,381,98,397", 0.85, 2)
            TracePrint "dm_ret2:" & dm_ret2
            If  len(dm_ret2) > 0 Then  
                三号金 = 三号金 + 1
                TracePrint "3满金一次"
                If 三号金 = 2 Then 
