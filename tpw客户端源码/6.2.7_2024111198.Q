Function 对战木精灵血条()
    If 对战血量判断ck = 1 Then 
        If getCard("木精灵") = 1 Then 
            dm_ret = dm.FindColor(107,77,422,85, "e43320-101010", 0.83,3, intX, intY)
            If dm_ret = 1 Then 
		 	
                血量 = 421 - Int(intX)
                If 血量 < 45 Then 
                    对战木精灵使用 = 0
                    TracePrint "血量高于90%不用加血"
                ElseIf 对战血量判断1index = 0 Then 
                    If 血量 >= 240  Then
                        TracePrint "血量小于10%了"
                        Call 调整卡牌顺序("木精灵")
                        对战木精灵使用 = 1 
