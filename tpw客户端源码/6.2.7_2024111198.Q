                TracePrint "战士上卡数组：" & dqkplogStr
            End If
            TracePrint "龙王点名战士装备Index :" & 龙王点名战士装备Index
        End If	
        If 龙王点名召唤ck = 1  Then
            If len(Trim(召唤下卡Str )) > 0 Then 
                召唤下卡Str  = 字符串竖杠处理(召唤下卡Str )
                核心英雄优先数组临时 = Split(召唤下卡Str , "|")
                召唤下卡数组  = 核心英雄优先数组临时
                dqkplogStr=""
                For dqkplogi = 0 To UBound(召唤下卡数组 )
                    dqkplogStr =dqkplogStr &  召唤下卡数组 (dqkplogi) & "|"
                Next
                TracePrint "召唤下卡数组 ：" & dqkplogStr
            End If
            If len(Trim(召唤上卡Str)) > 0 Then 
                召唤上卡Str = 字符串竖杠处理(召唤上卡Str)
                核心英雄优先数组临时 = Split(召唤上卡Str, "|")
                召唤上卡数组 = 核心英雄优先数组临时
                dqkplogStr=""
                For dqkplogi = 0 To UBound(召唤上卡数组)
                    dqkplogStr =dqkplogStr &  召唤上卡数组(dqkplogi) & "|"
                Next
                TracePrint "召唤上卡数组：" & dqkplogStr
            End If
            TracePrint "龙王点名召唤装备Index :" & 龙王点名召唤装备Index 
        End If
	
    End If
End Sub

