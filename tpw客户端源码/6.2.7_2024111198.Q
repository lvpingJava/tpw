Function 合作刷新判断()
    合作刷新判断 = 0
    If 装备切换 = 0 or 卡牌是否全部升满 = 0 or IsNumeric(合作中可使用精灵(0)) = 0 Then 
        合作刷新判断 = 1
    End If
End Function

Function 刷新()
    dm_ret = dm.FindColor(703,581,752,609,"E50000-1A0000",0.85,0,intX,intY)
    If intX > 0 and intY > 0 Then 
        刷新 = 1
        TracePrint "刷新时，金币不够"
    Else 
   		Call MoveToFcn(729,571)
        If 判断当前是否在战场中() = 1 Then 
            刷新 = 0
            已有英雄多次判断 = 0
            TracePrint "刷新成功"
            If get合作标志() = 1 and 中途换卡加速ck = 1 Then 
               	dm.Delay 20
            Else 
                dm.Delay 5
            End If
            Call MoveToFcn(729,571)
            dm.LeftClick
        End If	
    End If
End Function


Function 快速刷新(val)
    Call MoveToFcn(729, 571)
    If val > 1 Then 
        dm.Delay 10
    Else 
        dm.Delay 40
    End If
  	
    TracePrint "快速刷新成功"
    dm.LeftClick 
End Function

 
Function 扩建战车()
    If 卡牌已删除 = 0 and 扩展次数 < 5 and 扩展次数 < Int(扩建控制) Then 
		
        扩建战车 = -1
        For 2
            dm.Delay 5
            dm_ret = dm.FindColor(295, 582, 341, 610, "E50000-1A0000", 0.85, 0, intX, intY)
            If dm_ret = 1  Then 
                TracePrint "扩展时识别金币不足"
                扩建战车 = 0
                Exit Function
            End If
        Next
		
        If 扩建战车 = - 1  Then 
            Call MoveToFcn(318,578)
            If 判断当前是否在战场中() = 1 Then 
                Call MoveToFcn(318,578)
                dm.Delay 50
                dm.LeftClick 
                扩展次数 = 扩展次数 + 1
                TracePrint "执行扩展次数加1,当前扩展次数为：" & 扩展次数
                已有英雄多次判断 = 0
                扩建战车 = 1
                If 扩展次数 >= 5 Then 
                    dm.Delay 50
                    If 扩建是否满级() = 0 Then 
                        dm.Delay 200
                        If 扩建是否满级() = 0 Then 
                            扩展次数 = 扩展次数 - 1
                        End If
                    End If
                End If
            End If
        End If
	
    End If
	
End Function

Function 扩建是否满级()
    扩建是否满级 = 0

    dm.Delay 5
    dm_ret = dm.FindStrFast(272, 532, 364, 618, "已", "F6F6F6-090909", 0.86, intX, intY)
    If intX >= 0 and intY >= 0 Then 
        扩建是否满级 = 1
        Exit Function
    End If
    
    dm.Delay 5
    dm_ret = remoteFindPic("扩建已.bmp", "287,586,314,620", 0.81, 1) 
    If len(dm_ret) > 0 Then 
        扩建是否满级 = 1
        Exit Function
    End If
End Function


