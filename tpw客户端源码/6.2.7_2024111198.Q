Function 已超过对战次数继续(state)
    //If duiztz = 1 and state=0  Then
    If  state = 0  Then 
        dm.Delay 2000
        //dm_ret = dm.FindPic(557,427,751,501, "hggqd.bmp", "30", 0.80, 0, intX21, intY21)
        dm_ret = dm.FindStrFast(557,427,751,501,"确|定","ffffff-252525",0.83,intX21,intY21)
        If intX21 >= 0 and intY21 >= 0 Then 
            Call MoveToFcn(intX21 + 5, intY21 + 5)
            dm.Delay 50
            dm.LeftClick 	
        End If
    ElseIf state = 1 Then
        Dim i
        i = 次数已超()
        If i = 1 Then 
            dm.Delay 3000
            Call MoveToFcn(394, 462)
            dm.Delay 200
            dm.LeftClick 
            dm.Delay 3000
            Call MoveToFcn(809, 151)
            dm.Delay 200
            dm.LeftClick 
            dm.Delay 2000
            已超过对战次数 = 1
            已超过对战次数继续 = 1
        End If
    End If
End Function

Function 次数已超()
    dm.Delay 1500
    dm_ret = remoteFindPic("对战次数已超.tif", "439,283,467,322", 0.8, 1)
    If len(dm_ret) > 0 Then 
        次数已超 = 1
    End If
End Function

Function 重新登录()
    dm_ret = remoteFindPic("断线.bmp", "421,148,635,234", 0.8, 1)
    If len(dm_ret) > 0 Then 
        Call MoveToFcn(621,450)
        dm.Delay 50
        dm.LeftClick 
        Exit Function
    End If
End Function

Function 广告卡()
    广告卡 = 0
    For 3
        dm.Delay 200
        dm_ret = dm.FindStr(445,341,559,379,"广告卡","ffffff-050505|ffffff-303030",0.83,intXgb2,intYgb2)
        If intXgb2 >= 0 and intYgb2 >= 0 Then 
            If 使用广告卡看广告ck = 1 Then 
                //确定使用广告
                Call MoveToFcn(642, 462)
                dm.Delay 100
                dm.LeftClick 
                dm.Delay 2000
                广告卡 = 2
                Call MoveToFcn(936,44)
                dm.Delay 100
                dm.LeftClick 
                Exit For
            Else 
                //取消使用广告
                Call MoveToFcn(390, 462)
                dm.Delay 100
                dm.LeftClick 
                dm.Delay 2000
                广告卡 = 1
                Exit For
            End If
        End If
    Next
End Function


Function 字符串竖杠处理(str)
    字符串竖杠处理 = Trim(str)
    If Len(字符串竖杠处理) > 0 Then 
        For 3
            If Mid(字符串竖杠处理, Len(字符串竖杠处理)) = "|" Then 
                字符串竖杠处理 = Left(字符串竖杠处理, Len(字符串竖杠处理) - 1)
            End If
        Next    
    End If
End Function


