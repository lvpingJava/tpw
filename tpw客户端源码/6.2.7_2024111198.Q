//保存合作配置
Event Form1.Button4.Click

    Form1.Button4.Enabled = False
    Call 保存合作配置()
	 
    MessageBox "保存合作配置成功"
    Form1.Button4.Enabled = True	
End Event


Function 保存合作配置()
    合作配置选择 = 获取下拉框值(7)
    Call strAdd(1)
    path = "C:\test_game\合作配置"&合作配置选择&".txt"
    //删除配置
    Call Plugin.lxj_Plug.lxj_Recycle(path, 1)
    Delay 500
    Call Plugin.lxj_Plug.lxj_WriteTXT(path, 合作配置str, "ANSI")
End Function

//合作下拉配置
Event Form1.ComboBox7.SelectChange
    Call 合作下拉初始化()
End Event

Function 合作下拉初始化()
    合作配置选择 = 获取下拉框值(7)
    Call 配置回显("C:\test_game\合作配置"&合作配置选择&".txt",1)
End Function


//合作确定导入
Event Form1.Button6.Click
    If Form1.BrowseBox1.Path <> "" Then 
        Form1.Button6.Enabled = False
        Form1.Button6.Enabled = True
        txt = ""
        txt = Plugin.lxj_Plug.lxj_Txtline(Form1.BrowseBox1.Path)
        MessageBox txt
        If txt = "" Then 
            MessageBox "文件路径不存在！"
            TracePrint "文件路径不存在！"
        Else 
            Call 配置回显(Form1.BrowseBox1.Path,1)    	
            MessageBox "导入配置成功"
        End If	
    End If
End Event


//下载当前合作配置
Event Form1.Button5.Click
    Form1.Button5.Enabled = False
    合作配置选择 = 获取下拉框值(7)
    Call strAdd(1)
    //获取桌面路径	
    path = Plugin.lxj_Plug.lxj_GetSpecialPath(16)
    path = path & "\合作配置"&合作配置选择&"_"&Form1.Label8.Caption&".txt"
    //删除配置
    Call Plugin.lxj_Plug.lxj_Recycle(path, 1)
    Delay 500
    Call Plugin.lxj_Plug.lxj_WriteTXT(path, 合作配置str, "ANSI")
    Plugin.Msg.Tips "合作配置"&合作配置选择&"_"&Form1.Label8.Caption&".txt"
    Form1.Button5.Enabled = True
End Event



//保存对战配置
Event Form1.Button8.Click
    Form1.Button8.Enabled = False
    Call 保存对战配置()
    MessageBox "保存对战配置成功"
    Form1.Button8.Enabled = True	
End Event

Function 保存对战配置()
    对战配置选择 = 获取下拉框值(8)
    Call strAdd(2)
    path = "C:\test_game\对战配置"&对战配置选择&".txt"
    //删除配置
    Call Plugin.lxj_Plug.lxj_Recycle(path, 1)
    Delay 500
    Call Plugin.lxj_Plug.lxj_WriteTXT(path, 对战配置str, "ANSI")
   		
End Function


//对战下拉配置
Event Form1.ComboBox8.SelectChange
    Call 对战下拉初始化()
End Event

Function 对战下拉初始化()
    对战配置选择 = 获取下拉框值(8)
    Call 配置回显("C:\test_game\对战配置"&对战配置选择&".txt",2)
End Function


//对战确定导入
Event Form1.Button10.Click
    If Form1.BrowseBox3.Path <> "" Then 
        Form1.Button10.Enabled = False
        Form1.Button10.Enabled = True	
        txt =""
        txt = Plugin.lxj_Plug.lxj_Txtline(Form1.BrowseBox3.Path)
        If txt = "" Then 
            MessageBox "文件路径不存在！"
            TracePrint "文件路径不存在！"
        Else 
            Call 配置回显(Form1.BrowseBox3.Path,2)    	
            MessageBox "导入配置成功"
        End If
		
		
    End If
End Event


//下载当前对战配置
Event Form1.Button9.Click
    Form1.Button9.Enabled = False
    对战配置选择 = 获取下拉框值(8)
    Call strAdd(2)
    //获取桌面路径	
    path = Plugin.lxj_Plug.lxj_GetSpecialPath(16)
    path = path & "\对战配置"&对战配置选择&"_"&Form1.Label8.Caption&".txt"
    //删除配置
    Call Plugin.lxj_Plug.lxj_Recycle(path, 1)
