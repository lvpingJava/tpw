Sub 删除英雄()
    If Form1.OptionBox1.Value = 1 Then 
        //删除
        For 2
            Delay 30
            Call Plugin.Bkgnd.LeftClick(Hwndkj, 317,455)
        Next
    Else
        //删除
        For 2
            Delay 30
            Call Plugin.Bkgnd.LeftClick(Hwndkj, 369,456)
        Next
    End If
End Sub


Function 下卡(index)
    If Form1.OptionBox1.Value = 1 Then 
        坐标 = 获取坐标(1,index)
    ElseIf Form1.OptionBox2.Value = 1 Then
        坐标 = 获取坐标(2,index)
    ElseIf Form1.OptionBox3.Value = 1 Then
        坐标 = 获取坐标(3, index)
    ElseIf Form1.OptionBox4.Value = 1 Then
        坐标 = 获取坐标(4,index)	
    End If
    得到坐标 = Split(Trim(坐标), ",")
    For 2
        Delay 30
        Call Plugin.Bkgnd.LeftClick(Hwndkj, Int(得到坐标(0))+获取随机数(4), Int(得到坐标(1))+获取随机数(4))
    Next
	
    Call 删除英雄()
	
End Function
