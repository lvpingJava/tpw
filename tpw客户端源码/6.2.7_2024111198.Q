End Sub

Sub 对战()
    //----------------------------------------------------对战
    dm.Delay 50
    If 主界面对战按钮() = 1 Then 
        Call MoveToFcn(886+获取随机数(5),560+获取随机数(5))
        dm.Delay 100
        dm.LeftClick 
        //等待一段时间
        dm.Delay 30
        //变量初始化
        Call paramInit()
        dm.Delay 1000
    End If  
End Sub

Function 是否出现快速匹配()
    是否出现快速匹配 = 0
    dm.Delay 30
    dm_ret = remoteFindPic("快速匹配.tif", "666,472,751,521", 0.8, 1)
    If len(dm_ret) > 0 Then 
        是否出现快速匹配 = 1
        Exit Function
    End If

	
End Function


Sub 装备初始化()
    If 是否合作刷金币 = 1 and 寒冰ck = 0 Then 
        默认初始装备Str = Form1.ComboBox4.List
        默认初始装备s = Split(默认初始装备Str,"|")
        默认初始装备 = 默认初始装备s(合作默认装备index)
    ElseIf 对战ck = 1 Then 
        默认初始装备Str = Form1.ComboBox12.List
        默认初始装备s = Split(默认初始装备Str,"|")
        默认初始装备 = 默认初始装备s(对战默认装备index)
    ElseIf 寒冰ck = 1 Then
        默认初始装备Str = Form1.ComboBox10.List
        默认初始装备s = Split(默认初始装备Str,"|")
        默认初始装备 = 默认初始装备s(寒冰默认装备index)
    End If
	
End Sub

Function 对战动态核心英雄初始化()
    If 对战核心英雄加入1ck = 1  Then
        下拉框Strs = Split(对战对手识别下拉框aStr,"|")
        下拉框值 = 下拉框Strs(对战核心英雄加入1index)
		
        Call 新增对战对手英雄(下拉框值,0)
		
		

        下拉框Strs = Split(对战对手识别下拉框a1Str,"|")
        下拉框值 = 下拉框Strs(对战核心英雄加入1hindex)
		
        Call 新增对战要加入的核心英雄(下拉框值,0)	
    End If
	
    If 对战核心英雄加入2ck = 1  Then
        下拉框Strs = Split(对战对手识别下拉框bStr,"|")
        下拉框值 = 下拉框Strs(对战核心英雄加入2index)
		
        Call 新增对战对手英雄(下拉框值,1)
		
		
        下拉框Strs = Split(对战对手识别下拉框b1Str,"|")
        下拉框值 = 下拉框Strs(对战核心英雄加入2hindex)
		
        Call 新增对战要加入的核心英雄(下拉框值,1)	
    End If
	
    If 对战核心英雄加入3ck = 1  Then
        下拉框Strs = Split(对战对手识别下拉框cStr,"|")
        下拉框值 = 下拉框Strs(对战核心英雄加入3index)
		
        Call 新增对战对手英雄(下拉框值,2)
		
        下拉框Strs = Split(对战对手识别下拉框c1Str,"|")
        下拉框值 = 下拉框Strs(对战核心英雄加入3hindex)
		
        Call 新增对战要加入的核心英雄(下拉框值,2)	
    End If	
End Function

Function 对战英雄全满切换初始化()
    If  对战ck = 1 and 对战英雄全满级时英雄切换ck = 1 Then 
        If len(Trim(对战英雄全满级时英雄切换str)) > 0 Then 
            对战英雄全满级时英雄切换str = Replace(对战英雄全满级时英雄切换str, vbcrlf, "")
            对战英雄全满级时英雄切换str = 字符串竖杠处理(对战英雄全满级时英雄切换str)
            对战英雄全满级时英雄切换数组 = Split(Trim(对战英雄全满级时英雄切换str), "|")
            Dim hzmyxi,合作中要卖英雄关卡Str, 合作中要卖英雄关卡数组,合作中要卖英雄关卡数组长度
            For hzmyxi = 0 To UBound(对战英雄全满级时英雄切换数组)
                合作中要卖英雄关卡Str = Trim(对战英雄全满级时英雄切换数组(hzmyxi))
                合作中要卖英雄关卡Str = Replace(合作中要卖英雄关卡Str, vbcrlf, "")
                If len(Trim(合作中要卖英雄关卡Str)) > 0 Then 
                    //TracePrint "满足的" & 合作中要卖英雄关卡Str
                    合作中要卖英雄关卡数组 = Split(Trim(合作中要卖英雄关卡Str), "-")
                    合作中要卖英雄关卡数组长度 = UBound(合作中要卖英雄关卡数组)
                    If 合作中要卖英雄关卡数组长度 <> 1 Then 
                        TracePrint "对战英雄全满级时英雄切换配置格式错误|:" & 合作中要卖英雄关卡Str
                        MessageBox "对战英雄全满级时英雄切换配置格式错误"
                        ExitScript
                    Else 
						
                    End If
                End If
            Next
        End If
    End If
End Function

Function 对战某个英雄全满切换初始化()
    If  对战ck = 1 and 对战某个英雄全满级时英雄切换ck = 1 Then 
        If len(Trim(对战某个英雄全满级时英雄切换str)) > 0 Then 
            对战某个英雄全满级时英雄切换str = Replace(对战某个英雄全满级时英雄切换str, vbcrlf, "")
            对战某个英雄全满级时英雄切换str = 字符串竖杠处理(对战某个英雄全满级时英雄切换str)
            对战某个英雄全满级时英雄切换数组 = Split(Trim(对战某个英雄全满级时英雄切换str), "|")
            Dim hzmyxi,合作中要卖英雄关卡Str, 合作中要卖英雄关卡数组,合作中要卖英雄关卡数组长度
            For hzmyxi = 0 To UBound(对战某个英雄全满级时英雄切换数组)
                合作中要卖英雄关卡Str = Trim(对战某个英雄全满级时英雄切换数组(hzmyxi))
                合作中要卖英雄关卡Str = Replace(合作中要卖英雄关卡Str, vbcrlf, "")
                If len(Trim(合作中要卖英雄关卡Str)) > 0 Then 
                    TracePrint "对战某个英雄全满切换初始化:" & 合作中要卖英雄关卡Str
                    合作中要卖英雄关卡数组 = Split(Trim(合作中要卖英雄关卡Str), "-")
                    合作中要卖英雄关卡数组长度 = UBound(合作中要卖英雄关卡数组)
                    If 合作中要卖英雄关卡数组长度 <> 1 Then 
                        TracePrint "当某个英雄升到满级时，英雄切换格式有误:" & 合作中要卖英雄关卡Str
                        MessageBox "当某个英雄升到满级时，英雄切换格式有误"
                        ExitScript
                    Else 
						
                    End If
                End If
            Next
        End If
    End If
End Function

Sub 骰子上卡下卡数据初始化()
    If 是否合作刷金币 = 1 and 识别骰子ck =1 Then 
        If 骰子随缘上卡ck = 1 Then 
            If len(Trim(可以上的卡Str)) > 0 Then 
                可以上的卡Str = 字符串竖杠处理(可以上的卡Str)
                核心英雄优先数组临时 = Split(可以上的卡Str, "|")
                可以上的卡牌数组 = 核心英雄优先数组临时
                dqkplogStr=""
                For dqkplogi = 0 To UBound(可以上的卡牌数组)
                    dqkplogStr =dqkplogStr & 可以上的卡牌数组(dqkplogi) & "|"
                Next
                TracePrint "可以上的卡牌数组" & dqkplogStr
            End If
        End If	

    End If
	
End Sub	

Sub 寒冰99点名数据初始化()
    If 寒冰ck = 1 and 寒冰99识别ck = 1 Then 
        If 龙王点名牧师ck = 1  Then 
            If len(Trim(牧师下卡Str)) > 0 Then 
                牧师下卡Str = 字符串竖杠处理(牧师下卡Str)
                核心英雄优先数组临时 = Split(牧师下卡Str, "|")
