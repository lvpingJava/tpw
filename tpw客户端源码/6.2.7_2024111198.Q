//End Function

Function 骰子识别()
    TracePrint "进入骰子识别操作"
    骰子识别 = 0
	
    If 识别骰子ck = 0 or 骰子识别结束 = 1 or 卡牌是否全部升满 = 0 Then
        TracePrint "卡牌没完全操作完， 退出骰子识别"
        Exit Function
    End If

    If 当前合作关卡 >= 307 and 当前合作关卡 < 309 and 合作刷新判断() = 0 Then 
        Dim icount
        icount = 0
        For 30
            当前合作关卡 = 获取关卡()
            TracePrint "骰子当前合作关卡:" & 当前合作关卡
            If 当前合作关卡 >= 309 Then
                TracePrint "骰子提前等待到309"
                Exit For
            End If
            dm.Delay 350
        Next
    End If
	
    If 当前合作关卡 >= 309 and 当前合作关卡 <= 310  Then 
		
        If 骰子开始时间 = "" Then 
            骰子开始时间 = Now
            骰子识别开始 = 1
            Call 骰子识别上卡初始化()
        End If
		
        If 第一轮骰子硬抗ck = 1 and 骰子轮数 = 1 Then 
            骰子轮数 = 骰子轮数 + 1
            TracePrint "第一轮骰子硬抗"
            Exit Function
        End If
        Dim 秒数, forCount, 等待次数
        等待次数 = 1
        forCount = 5
        If 合作刷新判断() = 0 Then 
            TracePrint "当前上卡下卡动作完成，可以等待骰子3秒"
            forCount = 100
            等待次数 = 200
        End If
		
        For 等待次数
            If 对战结束确定a() = 1 Then 
                当前在战斗 = 0
                Exit For
            End If
            秒数 = 计时器(骰子开始时间)
            If 秒数 > 骰子间隔时间 * (骰子轮数-1) and 合作刷新判断() = 0 or 骰子轮数 = 1 Then 
				
                If 骰子轮数 = 1 Then 
                    骰子间隔时间 = 8
                ElseIf 骰子轮数 = 2 Then
                    骰子间隔时间 = 7
                    dm.Delay 100
                ElseIf 骰子轮数 = 3 Then
                    骰子间隔时间 = 7
                    dm.Delay 1000
                ElseIf 骰子轮数 = 4 Then
                    骰子间隔时间 = 7
                    dm.Delay 850
                ElseIf 骰子轮数 = 5 Then
                    骰子间隔时间 = 7
                    dm.Delay 650
                ElseIf 骰子轮数 = 6 Then
                    骰子间隔时间 = 7
                    dm.Delay 550
                ElseIf 骰子轮数 = 7 Then
                    骰子间隔时间 = 7
                    dm.Delay 450
                ElseIf 骰子轮数 > 7 Then
                    骰子间隔时间 = 6
                    dm.Delay 400
                End If
				
                Dim 识别count,临时骰子,骰子
                临时骰子 = ""
                骰子 = ""
				
				
				
                TracePrint "秒数:" & 秒数
                TracePrint "骰子轮数:" & 骰子轮数
                For forCount
                    识别count = 0
                    For 8
                        If 对战结束确定a() = 1 Then 
                            当前在战斗 = 0
                            Exit For
                        End If
                        //dm_ret3 = dm.Capture(413,316,795,420, "veedf.bmp")
                        //dm.Delay 10
                        //dm.LoadPic ("veedf.bmp")
                        dm_ret = UseDictFun(5)
                        //骰子 = dm.OcrInFile(0, 0, 382, 104, "veedf.bmp", "ffffff-030303", 0.74)
                        //TracePrint "截图骰子识别。。。。" & 骰子
                        dm.Delay 30
                        骰子 = dm.Ocr(413,316,795,420, "ffffff-030303", 0.74)
                        TracePrint "ocr骰子识别。。。。" & 骰子
                        If Len(骰子) > 2 and Len(骰子) <> 上一轮骰子数 and 骰子 = 临时骰子 Then 
                            识别count = 识别count + 1
                            dm.Delay 10
                            //dm.FreePic ("veedf.bmp")
                            //                            Dim sj
                            //                            sj = 获取随机数(100)
                            //                            dm_ret3 = dm.Capture(413,316,795,420, sj &"_"&骰子轮数&"识别成功的骰子.bmp")
                            //                            TracePrint "骰子识别成功次数+1" & 骰子
                        Else 
                            识别count = 0
                        End If
                        //dm.FreePic ("veedf.bmp")
                        临时骰子 = 骰子
                        If 识别count > 1 Then 
                            Exit For
                        End If
                    Next
					
                    If 识别count > 1 Then 
                        If Len(骰子) > 2 Then 
                            TracePrint "骰子识别完成：" & 骰子
                            Exit For
                        Else 
                            TracePrint "识别骰子不对：" & 骰子
                        End If
			 			
                    Else 
                        TracePrint "骰子识别出错，再次识别：" & 骰子
                        If 计时器(骰子开始时间) > 35 Then 
                            TracePrint "计时器(骰子开始时间):" & 计时器(骰子开始时间)
                            dm.Delay 10
                            dm_ret = UseDictFun(0)
                            If 对战结束确定a() = 1 Then 
                                骰子识别结束 = 1
                                骰子识别开始 = 0
                                当前在战斗 = 0
                                TracePrint "骰子合作已结束。。。"
                                forCount = 0
                                等待次数 = 0
                                骰子识别 = 0
                                Exit For
                                //Exit Function
                            End If	
                        End If
                    End If
                    dm.Delay 10
                    
                    If 对战结束确定a() = 1 Then 
                        当前在战斗 = 0
                        Exit For
                    End If
                Next
				
                If 识别count > 1 Then 
                    骰子识别 = Len(骰子)
                    TracePrint "第" & 骰子轮数 & "轮骰子最终识别结果为：" & 骰子
                    骰子轮数 = 骰子轮数 + 1
                    上一轮骰子数 = 骰子识别
                    当前骰子数 = 骰子识别
                    dm_ret = UseDictFun(0)
                    Exit Function
                End If
				
				
            Else 
                TracePrint "骰子轮数:" & 骰子轮数
                TracePrint "不满足轮数时间：" & 秒数	
            End If
			
            If 骰子识别结束 = 1 Then 
                TracePrint "骰子识别结束"
                Exit For
            End If
			
            TracePrint "上卡动作已完成，进入循环持续等待中"
            dm.Delay 50
        Next
        dm.Delay 50
        dm_ret = UseDictFun(0)		
    End If
	
End Function

Sub 卡牌在战车方向确定()
	  
    If 卡牌在战车方向是否已确认 = 0 Then 
        Dim kdad,res
        kdad = 0
   		
        If 扩展次数 = 0 Then 
            TracePrint "卡牌在战车方向确定-检测到扩展次数等于尝试扩建b"
            Call 扩建战车()
        End If
        
        If Int(扩建控制) = 1 Then 
            If 战车上卡牌升级统计(0) > 0 and 扩展次数 >= 1  or 扩展次数 >= 5 or 扩建是否满级() = 1 Then 
                kdad = 1
            End If
        Else 
            If 战车上卡牌升级统计(0) > 0 and 战车上卡牌升级统计(1) > 0 or 扩展次数 >= 5 or 扩建是否满级() = 1  Then 
                kdad = 1
            End If
        End If
       
        
        If 当前合作关卡 > 10 and 战车上卡牌升级统计(0) > 0 Then 
            Call MoveToFcn(318+获取随机数(4), 578+获取随机数(4))
            dm.Delay 50
            dm.LeftClick 
            kdad = 1
            TracePrint "检查到第5关了，还没满足检查，则强制扩建，检查"
        End If
        
        If kdad = 1 Then 
            TracePrint "卡牌在战车方向确定"
            Dim 卡牌在战车方向左确定次数,卡牌在战车方向右确定次数
            卡牌在战车方向左确定次数 = 0
            卡牌在战车方向右确定次数 = 0
            For 3
                For 5
                    dm.Delay 100
                    //左边方向点击
                    Call MoveToFcn(154,441)
                    dm.Delay 50
                    dm.LeftClick 
                    dm.Delay 1500
 					
                    res = 删除英雄图标()
                    If res = 1 Then 
                        For 5
                            dm.Delay 100
                            If 删除英雄图标() = 0 Then 
                                res = 0
                                Exit For
                            End If
                        Next
                    End If
					
                    If res = 1 Then  
                        卡牌在战车方向 = "左"
                        Call 合作战车方向Handle(卡牌在战车方向)
                        卡牌在战车方向是否已确认 = 1
                        卡牌在战车方向左确定次数 = 卡牌在战车方向左确定次数 + 1
                        TracePrint "卡牌在战车方向是否已确认左边"
                        //Call dm.Capture(239,164,421,503,"bug卡牌在战车方向是否已确认左边.bmp")
                        dm.Delay 100
                        Call 卡牌面板循环关闭()
                        Exit For
                    Else 
                        dm.Delay 100
                        Call 卡牌面板循环关闭()
    	 				
                        //右边方向点击
                        Call MoveToFcn(275,446)
                        dm.Delay 50
                        dm.LeftClick 
                        dm.Delay 1500
 						
                        res = 删除英雄图标()
                        If res = 1 Then 
                            For 5
                                dm.Delay 100
                                If 删除英雄图标() = 0 Then 
                                    res = 0
                                    Exit For
                                End If
                            Next
                        End If
							
                        If res = 1 Then  
                            卡牌在战车方向 = "右"
                            Call 合作战车方向Handle(卡牌在战车方向)
                            卡牌在战车方向是否已确认 = 1
                            TracePrint "卡牌在战车方向是否已确认右边"
                            卡牌在战车方向右确定次数 = 卡牌在战车方向右确定次数 + 1
                            //Call dm.Capture(239,164,421,503,"bug卡牌在战车方向是否已确认右边.bmp")
                            dm.Delay 100
                            Call 卡牌面板循环关闭()
                            Exit For
                        End If
                    End If
                    dm.Delay 200
                    Call 卡牌面板循环关闭()		
                Next
                dm.Delay 200
                Call 卡牌面板关闭()
    			
                If 卡牌在战车方向右确定次数 >= 2 or 卡牌在战车方向左确定次数 >= 2 Then 
                    TracePrint "卡牌在战车方向确定成功"
                    Exit For
                Else 
                    TracePrint "卡牌在战车方向确定失败"
                    卡牌在战车方向是否已确认 = 0
                End If
                dm.Delay 1000
            Next
        End If
        
        If kdad = 1 and 卡牌在战车方向是否已确认 = 0 Then 
            TracePrint "检查一轮后，没结果，强行扩建"
            Call MoveToFcn(318+获取随机数(4), 578+获取随机数(4))
            dm.Delay 50
            dm.LeftClick 
        End If
        
    End If
End Sub

//判断战车上是否有英雄
Function 战车是否有英雄()
    战车是否有英雄 = 0
    For i = 0 To 6
        If 战车上卡牌升级统计(i) > 0 Then 
            战车是否有英雄 = 1
            Exit For
        End If
    Next
End Function


Function 要上的卡牌数量()
    要上的卡牌数量 = 10
    For 当前卡牌阵容i = 0 To 9
        当前阵容卡牌card =  当前卡牌阵容 (当前卡牌阵容i)
        If 获取不上的卡牌(当前阵容卡牌card,0) = 1 Then 
            要上的卡牌数量 = 要上的卡牌数量 - 1
            //TracePrint 当前卡牌阵容i&":要上的卡牌数量不是精灵:"& 当前阵容卡牌card
        End If
		
        If UBound(Filter(精灵类数组, 当前阵容卡牌card)) = 0 Then 
            要上的卡牌数量 = 要上的卡牌数量 - 1
            //TracePrint 当前卡牌阵容i&":要上的卡牌数量精灵:"& 当前阵容卡牌card
        End If
    Next
    //	If 获取不上的卡牌("邪能火炮") = 0 and getCard("邪能火炮") = 1 Then 
    //			要上的卡牌数量 = 要上的卡牌数量 - 1
    //	End If
    TracePrint "要上的卡牌数量:" & 要上的卡牌数量
End Function

Function 合作英雄属性面板金色星星()
    合作英雄属性面板金色星星 = 0
    //红叉
    dm_ret = remoteFindPic("关闭红叉标志.tif", "789, 119, 811, 136", 0.8, 1) 
    If len(dm_ret) > 0 Then 
        dm.Delay 5
        dm_ret = dm.FindMulColor(327, 351, 351, 376, "ffea86-151515|fff9e2-151515|ffb810-151515|fbad00-151515|ffd626-151515|ffe467-151515|ffd51a-151515", 0.85)
        dm.Delay 5
        dm_ret2 = remoteFindPic("tjinsxx.bmp", "317, 347, 362, 380", 0.84, 2)
        TracePrint "合作英雄属性面板金色星星："& dm_ret & "dm_ret2:" & dm_ret2
        If dm_ret = 1 or len(dm_ret2) > 0 Then 
            合作英雄属性面板金色星星 = 1
        End If
    End If
End Function



Function 满星检查(index)
    满星检查 = 0
    Call 卡牌在战车方向确定()
    If 卡牌在战车方向是否已确认 = 1  Then 
        英雄坐标 = "0,0"
        If 卡牌在战车方向 = "右" Then 
            英雄坐标=合作战车上卡牌坐标右(index)
        Else
            英雄坐标=合作战车上卡牌坐标左(index)
        End If
		
        TracePrint  index & "号下标位置没满，进行点击查看..."
        //处理坐标
        获得坐标数组 = Split(Trim(英雄坐标), ",")
        //TracePrint "坐标为：" & 获得坐标数组(0) & "," & 获得坐标数组(1)
        Call MoveToFcn(Int(获得坐标数组(0))+获取随机数(3), Int(获得坐标数组(1))+获取随机数(3))
        dm.Delay 30
        dm.LeftClick 
        For 6
            dm.Delay 10 
            If 合作英雄属性面板金色星星() = 1 Then 
                dm.Delay 10
                If 合作英雄属性面板金色星星() = 1 Then 
                    满星检查 = 1
                    Exit For
                End If	
            End If
            dm.Delay 100
        Next
 		
        Call 卡牌面板循环关闭()
    End If	
End Function


