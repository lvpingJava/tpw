    If (is土精灵 = 1 or 战车上卡牌升级统计(4) > 0) and 五号金 < 2 Then 
        TracePrint "进入5号"
        For 3
            dm.Delay 5
            dm_ret2 = remoteFindPic("jinsexx.bmp", "85,310,104,327", 0.85, 2)
            TracePrint "dm_ret2:" & dm_ret2
            If  len(dm_ret2) > 0 Then  
