                        Call 关闭广告()
                    End If
                End If
            End If	
        End If
   		 
        Call 任务奖励弹窗()
   		 
        If t = 0 Then 
		
            Call MoveToFcn(126, 248)
            dm.Delay 500
            dm.LeftClick 
   			
            //关闭
            dm.Delay 3000
            Call 返回关闭()
           	
            dm.Delay 200
            Call MoveToFcn(805,115)
            dm.Delay 200
            dm.LeftClick 
        End If
   		
        Rem 终止流程
    End If
End Sub


Sub 通行证()
