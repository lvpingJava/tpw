Sub win7模式()
    Dim dml, vers, i, ver, bool
    bool = 0
    Set dml = createobject("dm.dmsoft")
    ver = dml.GetOsType()
    vers = Array(3, 4, 5, 6)
    For i = 0 To 3
        If ver = vers(i) Then 
            bool = 1
            Exit For
        End If
    Next	
    If bool = 1 Then 
        Form1.ComboBox11.ListIndex = 3
    Else 
        Form1.ComboBox11.ListIndex = 1
    End If
    Set dml = Nothing
End Sub

