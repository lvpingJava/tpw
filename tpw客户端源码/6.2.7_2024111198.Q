//获取当前时间加30分钟是否到凌晨
Function 是否是第二天凌晨(m)
    dm.Delay 50
    是否是第二天凌晨 = 0
    Dim NewDate,newDay,oldDay
    oldDay = Day(oldDate)
	
    NewDate = DateAdd("n", m, Now)
    newDay = Day(NewDate)
	
    If m = 0 Then 
        newDay = Day(Now)
    End If
	
	
    If  newDay <> oldDay Then 
        是否是第二天凌晨 = 1
    End If
    TracePrint NowDate
End Function

Function 卡牌执行(card, tag)
    Select Case card
    Case "幻精灵" 
        卡牌执行 = 幻精灵(tag)
    Case "魔精灵" 
        卡牌执行 = 魔精灵(tag)
    Case "光精灵" 
        卡牌执行 = 光精灵(tag)
    Case "暗精灵" 
        卡牌执行 = 暗精灵(tag)    
    Case "土精灵" 
        卡牌执行 = 土精灵(tag)	
    Case "木精灵" 
        卡牌执行 = 木精灵(tag)
    Case "魂精灵" 
        卡牌执行 = 魂精灵(tag)
    Case "侏儒射线"
        卡牌执行 = 侏儒射线(tag)
    Case "地精宝库" 
        卡牌执行 = 地精宝库(tag)
    Case Else 
        Call 卡牌执行处理(card, tag, 0,0)		
    End Select
End Function

Function 快速英雄识别(tag,cards,recursion,sim)
    快速英雄识别 = 0
    dm_ret =  remoteFindPicS("400,517,640,608",sim,tag,cards,recursion)
    If Len(dm_ret) > 0 Then 
        识别到的英雄数组 = Array(0, 0, 0)
        识别到的英雄坐标数组 = Array(0, 0, 0)
        TracePrint "识别结果为：" & dm_ret
        Dim resultList,doi,doCounti,返回识别结果,resultListChild,card,intX,intY
        resultList = split(dm_ret,"|")
        doi = 0
        doCounti = UBound(resultList) + 1
        TracePrint "doCounti为：" & doCounti

    		
        返回识别结果 = 0
        Do While doi < doCounti
            resultListChild = split(resultList(doi),",")
            card = resultListChild(0)
            intX = int(resultListChild(1))
            intY = int(resultListChild(2))
            doi = doi + 1
            返回识别结果 = 返回识别结果 + 识别到的英雄(card, intX, intY)
  	
            If 返回识别结果 = 3 Then 
                doCounti = -1
            End If
            If tag = 1 Then 
                TracePrint "快速英雄识别成功"
            End If
        Loop
    End If
    快速英雄识别 = 返回识别结果
	
End Function


Function 快速英雄识别New(tag,cards,recursion,sim)
    快速英雄识别New = 0


    dm_ret =  remoteFindPicNewS("400,517,640,608",sim,tag,cards,recursion)
    If Len(dm_ret) > 0 Then 
        识别到的英雄数组 = Array(0, 0, 0)
        识别到的英雄坐标数组 = Array(0, 0, 0)
        TracePrint "识别结果为：" & dm_ret
        Dim resultList,doi,doCounti,返回识别结果,resultListChild,card,intX,intY
        resultList = split(dm_ret,"|")
        doi = 0
        doCounti = UBound(resultList) + 1
        TracePrint "doCounti为：" & doCounti
		
        If tag = 0 and doCounti < 3  Then 
            Exit Function 
        End If
    	
        返回识别结果 = 0
        Do While doi < doCounti
            resultListChild = split(resultList(doi),",")
            card = resultListChild(0)
            intX = int(resultListChild(1))
            intY = int(resultListChild(2))
            doi = doi + 1
            返回识别结果 = 返回识别结果 + 识别到的英雄(card, intX, intY)

            If 返回识别结果 = 3 Then 
                doCounti = -1
            End If
            If tag = 1 Then 
                TracePrint "快速英雄识别成功"
            End If
        Loop
    End If
    快速英雄识别New = 返回识别结果

End Function

