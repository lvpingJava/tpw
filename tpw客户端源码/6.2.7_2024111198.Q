    For zki = 0 To 6
        zkCard = 对战只升一级英雄数组排序(zki)
        If IsNumeric(zkCard) <> - 1  Then 
            临时数组(getIndex(zkCard)) = zkCard
        End If
    Next
    对战只升一级英雄数组排序 = Array(0, 0, 0, 0, 0, 0, 0)
    For zki = 0 To 9
        zkCard = 临时数组(zki)
        If IsNumeric(zkCard) <> - 1  Then 
            For zkia = 0 To 6
                If IsNumeric(对战只升一级英雄数组排序(zkia)) = - 1  Then 
                    对战只升一级英雄数组排序(zkia) = zkCard
                    Exit For
                End If
            Next
        End If
    Next
	
	
    zcstr = ""
    For i2=0 To 6
        dds = 对战只升一级英雄数组排序(i2)
        zcstr =zcstr & dds & ","
    Next
    TracePrint "对战只升一级英雄数组排序 ：" & zcstr
	
    TracePrint "对战只升一级英雄排序完成"
End Function



