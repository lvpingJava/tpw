//判断当前阵容是否存在该卡牌
Function getCard(isHaveCard)
    getCard = 0
    For getcardi = 0 To 9
        If isHaveCard = 当前卡牌阵容(getcardi) Then 
            getCard = 1
            Exit For
        End If
    Next
End Function

Function add合作中可使用精灵(card,t)
    Dim  booljlAdd,iz,z
    booljlAdd = 0
   
    For iz = 0 To 3
        If card = 合作中可使用精灵(iz)  Then 
            booljlAdd = 1
            Exit For
        End If
    Next
	
    If booljlAdd = 0 Then 
        For ix = 0 To 3
            z = 合作中可使用精灵(ix)
            If IsNumeric(z) = -1  Then 
                合作中可使用精灵(ix) = card
                合作中可使用精灵时间(ix) = t
                Exit For
            End If
        Next	
    End If	
		
End Function



Function 精灵控制执行()

    If 海妖换圣骑ck = 1 and 当前合作关卡 = 119 Then 
        TracePrint "海妖换圣骑情况,退出精灵执行a"
        Exit Function
    End If
  
    If 寒冰ck = 1 and 当前合作关卡 >= 127 and 当前合作关卡 <= 129 and 寒冰129点名自动上下卡ck = 1 Then 
        TracePrint "检测到船长点名，退出精灵执行e"
        Exit Function
    End If
    
    If 当前合作关卡 >=145 and 当前合作关卡 < 150  and  get寒冰149统计() <= 6 and 寒冰149红篮球上下魇ck = 1 Then 
        TracePrint "识别到149球,退出精灵执行a"
        Exit Function	
    End If
        
    
    TracePrint "精灵控制执行开始"	
    oldTime = Now
    Dim 精灵count
    For 10
        精灵count = 0
        If 装备切换 = 0 or 卡牌是否全部升满 = 0 Then 
            TracePrint "不满足精灵控制执行，退出循环"
            Exit For
        End If 
		
        精灵Cards = ""
        For i = 0 To 3
            If IsNumeric(合作中可使用精灵(i)) = 0 Then 
                精灵Cards = 精灵Cards & 合作中可使用精灵(i) & "|"
                精灵count = 精灵count + 1
            End If
        Next
		
        If 精灵count = 2 Then 	
            If 合作中可使用精灵时间(0) < 合作中可使用精灵时间(1) Then 
                精灵Cards = 合作中可使用精灵(0) & "|" & 合作中可使用精灵(1)
            Else 
                精灵Cards = 合作中可使用精灵(1) & "|" & 合作中可使用精灵(0)
            End If
        ElseIf 精灵count = 1 Then
            精灵Cards = 合作中可使用精灵(0)
        Else 
            精灵Cards = 字符串竖杠处理(精灵Cards)
        End If

        TracePrint "精灵Cards:" & 精灵Cards

        If len(精灵Cards) > 1 Then 
            Call 精灵执行操作(精灵Cards,oldTime)
        Else 
            TracePrint "没有要执行的精灵，退出循环"
            Exit For
        End If

        oldTime = Now
		
        If  get寒冰149统计() > 0 and 寒冰149红篮球上下魇ck = 1 Then 
            If len(get寒冰149结果()) > 0 Then 
                TracePrint "识别到149球,退出精灵执行"
                Exit For
            End If
        End If
        
        If 是否补星 = 1 Then 
            合作卡牌升满统计 (0)
            If 装备切换 = 0 or 卡牌是否全部升满 = 0 Then 
                TracePrint "不满足精灵控制执行，退出循环"
                Exit Function
            End If 
        End If

        Call 装备变更()
		
	
		
        If 寒冰ck = 1 and 当前合作关卡 >= 128 and 当前合作关卡 <= 129 Then 
            //If len(get船长点名()) > 0 Then 
            TracePrint "检测到船长点名，立即停止刷新,跳转到下卡d"
            Exit For
            //End If
        End If
        
        If 海妖换圣骑ck = 1 and 当前合作关卡 = 119 Then 
            TracePrint "海妖换圣骑情况,退出精灵执行"
            Exit For
        End If
        
        If 寒冰ck = 1 and 寒冰99识别ck = 1 and 当前合作关卡 >= 99 and 当前合作关卡 < 100 Then 
            If Len(get寒冰99点名识别()) = 2  Then 
                TracePrint "识别到龙王点名，退出精灵执行"
                Exit For
            End If
        End If
        
        If 当前合作关卡 >= 128 and 当前合作关卡 < 130 and 寒冰129点名自动上下卡ck = 1 Then 
            Call 当前合作关卡Handle(129)
            If len(get船长点名()) > 0 Then 
                TracePrint "识别到船长点名，退出精灵执行"
                Exit For
            End If
        End If
        
        If 当前合作关卡 >=145 and 当前合作关卡 < 150  and  get寒冰149统计() <= 6 and 寒冰149红篮球上下魇ck = 1 Then 
            TracePrint "识别到149球,退出精灵执行b"
            Exit For
        End If
        
        If 对战结束确定a() = 1 Then 
            当前在战斗 = 0
            TracePrint "识别到合作结束，退出精灵执行"
            Exit For
        End If

    Next
End Function
 
Function 精灵执行操作(精灵Cards, oldTime)
    TracePrint "精灵执行操作开始"
	
    Dim jlc,精灵List,已使用的精灵s,最终执行的精灵s
    精灵List = Split(精灵Cards, "|")
    精灵ListSize = UBound(精灵List)
    精灵Listbak = 精灵List
    精灵ListbakTem = 精灵List
    延迟时间All = 0
    识别结果count = 0
    For jlc = 0 To 精灵ListSize
        最终执行的精灵s = ""
        TracePrint "精灵执行操作开始-" & 精灵List(jlc)
        已使用的精灵List = Split(已使用的精灵s, "|")
        TracePrint "已使用的精灵s:" & 已使用的精灵s
        已使用的精灵Size = UBound(已使用的精灵List)
		
        If 当前合作关卡 >= 128 and 当前合作关卡 < 130 Then 
            If len(get船长点名()) > 0 Then 
                TracePrint "识别到船长点名，退出精灵执行aa"
                Exit Function
            End If
        End If
		
        For jlca = 0 To 精灵ListSize
            精灵bool = 1
            For jlcb = 0 To 已使用的精灵Size
                If 精灵List(jlca) = 已使用的精灵List(jlcb) Then 
                    精灵bool = 0
                End If
            Next
            If 精灵bool = 1 Then 
                最终执行的精灵s = 最终执行的精灵s & 精灵List(jlca) & "|"
            End If
			
        Next
        最终执行的精灵s = 字符串竖杠处理(最终执行的精灵s)
        TracePrint "最终执行的精灵s: "& 最终执行的精灵s
		
        If len(最终执行的精灵s) = 0 Then 
            TracePrint "最终执行的精灵为空，退出循环: "
            Exit For
        End If
		
        If 快速英雄识别结果 = 1 and 识别结果count = 1 Then 
            TracePrint "检查到快速识别上卡，延迟100毫秒" 
            dm.Delay 100
        End If
        最终执行的精灵List = Split(最终执行的精灵s, "|")
        最终执行的精灵size = UBound(最终执行的精灵List)
        Dim zki,zkCard,isYes
        For 20
            If 对战结束确定a() = 1 Then 
                当前在战斗 = 0
                Exit For
            End If
            快速英雄识别结果 = 0
            
            TracePrint "精灵执行操作-查找卡牌中..."	 
            是否需要刷新= 0
            识别结果count = 快速英雄识别Test(1, 最终执行的精灵s, 11, 0.85)
            If 识别结果count > 1 Then 
                TracePrint "精灵执行操作-等待一段时间识别到了aaaa"
                等待刷新次数 = 0
                isYes = 0
            	
                If 最终执行的精灵size = 精灵ListSize Then 
                    TracePrint "进入正常循环判断"
                    For jlcb = 0 To 最终执行的精灵size
                        最终执行的精灵card = 最终执行的精灵List(jlcb)
                        For zki = 0 To 2
                            zkCard = 识别到的英雄数组(zki)
                            If IsNumeric(zkCard) <> - 1  Then
                                If 最终执行的精灵card = zkCard Then 
                                    TracePrint zki&"：位置，精灵执行操作-快速手牌没识别成功，正常手牌识别成功:" & zkCard
                                    isYes = 1
                                    识别到的英雄数组 =  Array(0, 0, 0)
                                    识别到的英雄数组(zki) = zkCard
                                    Exit For
                                End If
                            End If
                        Next
                    Next	
                Else 
                    TracePrint "进入不正常循环判断"
                    For jlcb = 0 To 最终执行的精灵size
                        Call 调整精灵顺序最前面(最终执行的精灵List(jlcb))
                    Next	
            		
                    For jlcb = 0 To 精灵ListSize
                        最终执行的精灵card = 精灵Listbak(jlcb)
                        TracePrint "精灵bak值：" & 最终执行的精灵card
                        For zki = 0 To 2
                            zkCard = 识别到的英雄数组(zki)
                            If IsNumeric(zkCard) <> - 1  Then
                                If 最终执行的精灵card = zkCard Then 
                                    TracePrint zki&"：位置，精灵执行操作hhhh-快速手牌没识别成功，正常手牌识别成功:" & zkCard
                                    isYes = 1
                                    识别到的英雄数组 =  Array(0, 0, 0)
                                    识别到的英雄数组(zki) = zkCard
                                    Exit For
                                End If
                            End If
                        Next
                    Next		
                End If

                If isYes = 1 Then 
                    快速英雄识别结果 = 1
                    Exit For
                End If
    			
                If isYes = 0 Then 
                    等待刷新次数 = 0
                    是否需要刷新 = 1
                    TracePrint "精灵执行操作-后补刷新aaaacc...."
                Else 
                    快速英雄识别结果 = 1
                    Exit For	
                End If
            End If
			
            If 当前合作关卡 >= 128 and 当前合作关卡 < 130 Then 
                If len(get船长点名()) > 0 Then 
                    TracePrint "识别到船长点名，退出精灵执行aa"
                    Exit Function
                End If
            End If
	
            If 识别结果count = 0 Then 
                TracePrint "识别结果为0，刷新"
                Call 快速刷新(0)
                If 对战结束确定a() = 1 Then 
                    当前在战斗 = 0
                    Exit For
                End If
                dm.Delay 150
            End If
			
            If 识别结果count = 1 Then 
                快速英雄识别结果 = 1
                Exit For	
            End If
			
            If 是否需要刷新 = 1 Then 
                TracePrint "识别结果为没有想要的，刷新"
                Call 快速刷新(0)
                If 对战结束确定a() = 1 Then 
                    当前在战斗 = 0
                    Exit For
                End If
                dm.Delay 50
            End If
        Next
        If 快速英雄识别结果 = 1 Then 
            For kpzxi = 0 To 2
                得到的精灵 = 识别到的英雄数组(kpzxi)
                If IsNumeric(得到的精灵) = 0 and UBound(Filter(受控制类的精灵, 得到的精灵)) = 0 Then 
                    TracePrint "得到的精灵：" & 得到的精灵
            		
                    For aai =0  to UBound(合作中可使用精灵)
                        If 合作中可使用精灵(aai) = 得到的精灵 Then 
                            TracePrint  得到的精灵& " 延迟时间:" & 合作中可使用精灵时间(aai)
                            If 计时器(oldTime) + 延迟时间All >= 合作中可使用精灵时间(aai) Then 
                                TracePrint "时间满足，不延迟：" & 得到的精灵
                                dm.Delay 50
                                Exit For
                            Else 
                                延迟时间 = 合作中可使用精灵时间(aai) - 计时器(oldTime) - 延迟时间All
                                延迟时间All = 延迟时间All + 延迟时间
                                dm.Delay 延迟时间*1000
                                TracePrint 延迟时间 & "：时间不满足，延迟：" & 得到的精灵
                                Exit For
                            End If
                        End If
                    Next
                    Call 精灵上卡(得到的精灵)
                    dm.Delay 100
                    已使用的精灵s = 已使用的精灵s & 得到的精灵 & "|"
                    已使用的精灵s = 字符串竖杠处理(已使用的精灵s)
                    Exit For
                End If
            Next
            If 当前合作关卡 >= 128 and 当前合作关卡 < 130 Then 
                If len(get船长点名()) > 0 Then 
                    TracePrint "识别到船长点名，退出精灵执行aa"
                    Exit Function
                End If
            End If
            TracePrint "上卡完成，刷新"
            Call 快速刷新(0)
            dm.Delay 300
        End If
		
    Next	
	
End Function



Function 调整精灵顺序最前面(card)
    If 精灵Listbak(0) = card Then 
        TracePrint card &":已在目标位置不需要排序"
        Exit Function
    End If	

    变量 = 0
    For tz = 0 To 精灵ListSize
        If tz = 0 Then
            精灵ListbakTem(tz) = card
        ElseIf card = 精灵Listbak(tz-1) Then
            变量 = 1
            精灵ListbakTem(tz) = 精灵Listbak(tz)
        ElseIf 变量 = 1 Then
            精灵ListbakTem(tz) = 精灵Listbak(tz)    
        Else 
            精灵ListbakTem(tz) = 精灵Listbak(tz-1) 
        End If
    Next
    精灵Listbak = 精灵ListbakTem

End Function

Function 合作中可使用精灵加入最前面(card)
    Dim temp1,temp2,temp3,temp4
    If 合作中可使用精灵(0) = card Then 
        TracePrint card &":已在目标位置不需要排序"
        Exit Function
    End If	
  	
    temp1 = 合作中可使用精灵(0)
    temp2 = 合作中可使用精灵(1)
    temp3 = 合作中可使用精灵(2)
    temp4 = 合作中可使用精灵(3)
 
    合作中可使用精灵(0) = card
    合作中可使用精灵(1) = temp1
    合作中可使用精灵(2) = temp2
    合作中可使用精灵(3) = temp3

    TracePrint card &":调整卡牌顺序最前面："
    For ii = 0 To 3
        TracePrint 合作中可使用精灵(ii)
    Next

End Function


Function 删除合作中可使用精灵(card)
    Dim delbskpi
    For delbskpi=0 To 3
        If 合作中可使用精灵(delbskpi) = card Then 
            合作中可使用精灵(delbskpi) = 0
            Exit For
        End If
    Next
End Function


Function get合作中可使用精灵(card)
    Dim ix
    For ix = 0 To 3
        If card = 合作中可使用精灵(ix) Then 
            get合作中可使用精灵 = 1
            TracePrint "可以使用精灵了："&card
            Exit For
        End If
    Next	
End Function




Function 合作中要是否升满的英雄重制()
    合作中要升满的英雄 = Array(0, 0, 0, 0, 0, 0)
    合作中不升满的英雄 = Array(0, 0, 0, 0, 0,0)
End Function

Function add合作中要升满的英雄(card)
    booljlAdd = 0
    izmax = UBound(合作中要升满的英雄)
    For iz = 0 To izmax
        If card = 合作中要升满的英雄(iz)  Then 
            booljlAdd = 1
            Exit For
        End If
    Next
	
    If booljlAdd = 0 Then 
        ixmax = UBound(合作中要升满的英雄)
        For ix = 0 To ixmax
            z = 合作中要升满的英雄(ix)
            If IsNumeric(z) = -1  Then 
                合作中要升满的英雄(ix) = card
                Exit For
            End If
        Next	
    End If	
		
End Function

Function get合作中要升满的英雄(card)
    ixmax = UBound(合作中要升满的英雄)
    For jl = 0 To ixmax
        If card = 合作中要升满的英雄(jl) Then 
            get合作中要升满的英雄 = 1
            Exit For
        End If
    Next
End Function


Function add合作中不升满的英雄(card)
    booljlAdd = 0
    izmax = UBound(合作中不升满的英雄)
    For iz = 0 To izmax
        If card = 合作中不升满的英雄(iz)  Then 
            booljlAdd = 1
            Exit For
        End If
    Next
	
    If booljlAdd = 0 Then 
        ixmax = UBound(合作中不升满的英雄)
        For ix = 0 To ixmax
            z = 合作中不升满的英雄(ix)
            If IsNumeric(z) = -1  Then 
                合作中不升满的英雄(ix) = card
                Exit For
            End If
        Next	
    End If	
		
End Function

Function get合作中不升满的英雄(card)
    ixmax = UBound(合作中不升满的英雄)
    For jl = 0 To ixmax
        If card = 合作中不升满的英雄(jl) Then 
            get合作中不升满的英雄 = 1
            Exit For
        End If
    Next
End Function

