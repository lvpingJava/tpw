//注册
Function temPost(params, url)
    Dim ftemPost
    Set ftemPost = CreateObject("Msxml2.ServerXMLHTTP.3.0")
    ftemPost.Open "Post", url, False
    ftemPost.Send params
    If ftemPost.Status = "200"Then 
        temPost = ftemPost.responseText
    Else     
        temPost =""
    End If
    Set ftemPost = Nothing
End Function

//post调用python
function post_url(params,url)
    fpost.Open "Post", url, False
    fpost.Send params
    If fpost.Status = "200"Then 
        post_url = fpost.responseText
    Else     
        post_url =""
    End If
End Function

Function remoteFindPicNewS(region, matching,tag,cards,recursion)
    Dim param,url
    param = "{""hwnd"":"&getHwnd()&",""cards"":"""&cards&""",""region"":"""&region&""",""matching"":"""&matching&""",""tag"":"&tag&",""recursion"":"&recursion&"}"
    url = "http://127.0.0.1:"& pyport & "/findPics"
    remoteFindPicNewS = post_url(param,url)
End Function


Function remoteGetData(method,position,recursion)
    Dim param,url
    param = "{""hwnd"":"&getHwnd()&",""position"":"""&position&""",""recursion"":"&recursion&"}"
    url = "http://127.0.0.1:"& pyport & "/"& method
    remoteGetData = post_url(param,url)
End Function


Function remoteFindPicTest(region, matching,tag,cards,cardsAll,recursion)
    
    param = "{""hwnd"":"&getHwnd()&",""cards"":"""&cards&""",""cardsAll"":"""&cardsAll&""",""region"":"""&region&""",""matching"":"""&matching&""",""tag"":"&tag&",""recursion"":"&recursion&"}"
    url = "http://127.0.0.1:"& pyport & "/findPicTest"
    remoteFindPicTest = post_url(param,url)
End Function

Function remoteFindPicS(region, matching,tag,cards,recursion)
   
    param = "{""hwnd"":"&getHwnd()&",""cards"":"""&cards&""",""region"":"""&region&""",""matching"":"""&matching&""",""tag"":"&tag&",""recursion"":"&recursion&"}"
    url = "http://127.0.0.1:"& pyport & "/findPics"
    remoteFindPicS = post_url(param,url)
