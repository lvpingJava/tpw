Function remoteFindPic(card, region, matching, tag)
    param = "{""hwnd"":"&getHwnd()&",""card"":"""&card&""",""region"":"""&region&""",""matching"":"""&matching&""",""tag"":"&tag&"}"
    url = "http://127.0.0.1:"& pyport & "/findPic"
    remoteFindPic = post_url(param,url)
End Function

Function remoteFindStr(name, region)
    Dim param,url
    param = "{""hwnd"":"&getHwnd()&",""name"":"""&name&""",""region"":"""&region&"""}"
    url = "http://127.0.0.1:"& pyport & "/findStr"
    remoteFindStr = post_url(param,url)
End Function



Function remoteCardInfo(cards)
    Dim param,url
    param = "{""cards"":"""&cards&"""}"
    url = "http://127.0.0.1:"& pyport & "/cardInfo"
    remoteCardInfo = post_url(param,url)
End Function


Function remoteOcr(region, tag,hwnd)
    Dim param, url, hwndId
    hwndId = getHwnd()
    If hwnd > 0 Then 
        hwndId = hwnd
    End If
    param = "{""hwnd"":"&hwndId&",""region"":"""&region&""",""tag"":"&tag&"}"
    url = "http://127.0.0.1:"& pyport & "/getOcr"
    remoteOcr = post_url(param,url)
End Function


Function FindStrFastE(str,region)
    FindStrFastE = -1
    findStrResult = remoteFindStr(str,region)
    If len(findStrResult) > 1 Then 
        获得坐标数组 = Split(Trim(findStrResult), ",")
        intX = Int(获得坐标数组(0))
        intY = Int(获得坐标数组(1))
        FindStrFastE = 1
    End If
End Function