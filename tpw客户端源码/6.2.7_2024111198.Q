Sub 世界频道合作()
    If 是否合作刷金币 = 1 and 助战合作ck = 0 and 寒冰ck = 0 Then 
        TracePrint "进入世界合作....."
        TracePrint "是否合作刷金币:" & 是否合作刷金币
        第二天凌晨 = 是否是第二天凌晨(30)
        If 第二天凌晨 = 1 and 强制合作ck = 0 and  等待凌晨切换对战ck = 1 Then 
            //睡眠10分钟
            dm.Delay 600000
            是否合作刷金币 = 0
            TracePrint "合作判断出30分钟后已到第二天，结束合作"
            Form1.CheckBox16.Value = 0
            对战ck = 0
            降杯ck = 0
            是否合作刷金币 = 0
        End If
		
        TracePrint "世界合作来了"
        //合作助战
        dm.Delay 100	
        //If 0 = 0 Then 	
        //聊天窗口
        If 合作助战() = 1 and 第二天凌晨 = 0 or 强制合作ck = 1  or 世界频道社交() = 1 Then 
            dm.Delay 100
            //dm_ret = dm.FindPic(944,443,1019,501,"聊天窗口.bmp|聊天窗口2.bmp","30",0.80,0,intX,intY) 
            //dm_ret = dm.FindColorBlock(961,471,989,487,"ffe99e-050505|997359-050505",0.85,210,28,16,intX,intY)
            If 社交频道入口(0) = 1 or 世界频道社交() = 1 Then 
                Call MoveToFcn(977, 477)
                dm.Delay 100
                dm.LeftClick 
                dm.Delay 1500
    			
                If 世界频道社交() = 1 Then 
                    合作抢房间变量 = 1
                    Call 合作抢房间变量set()
                    //变量初始化
                    Call paramInit()
                    If getCard("幻精灵") = 0 Then 
                        装备切换 = - 1 
                    ElseIf 默认初始装备 = "无" Then
                        装备切换 = 1	
                    End If
                    //合作标志 = 1
                    Call 合作标志Handle(1)
                    扩建控制 = 合作前期扩建允许次数
                    TracePrint "已进入合作，开始合作"
                    dm.Delay 500
                    While 合作抢房间变量 > 0
                        合作抢房间变量 = get合作抢房间变量()
                        dm.Delay 10
                        Call MoveToFcn(818, 494)
                        dm.Delay 10
                        Call MoveToFcn(818, 494)
                        dm.Delay 30
                        dm.LeftClick 
    	 					
                        dm.Delay 10
                        Call MoveToFcn(691, 465)
                        dm.Delay 10
                        Call MoveToFcn(691, 465)
                        dm.Delay 30
                        dm.LeftClick 
                    Wend
                    当前在战斗 = 判断当前是否在战场中()
                End If
    			
            End If
        End If
    End If
End Sub

Sub 联盟频道合作()
    If 联盟自动抢房间ck = 1 Then 
        第二天凌晨 = 是否是第二天凌晨(35)
        If 第二天凌晨 = 1 and 强制合作ck = 0 and  等待凌晨切换对战ck = 1 Then 
            //睡眠10分钟
            dm.Delay 600000
            是否合作刷金币 = 0
            TracePrint "合作判断出30分钟后已到第二天，结束合作"
        End If
		
        TracePrint "联盟合作来了"
        dm.Delay 100
        Dim 联盟喊话内容temp,联盟循环统计
        联盟循环统计 = -1
        //聊天窗口
        If  第二天凌晨 = 0 or 强制合作ck = 1 Then 
            dm.Delay 100
            Do
                dm.Delay 30
                //dm_ret = dm.FindPic(942,368,1015,429,"联盟入口1.bmp|联盟入口2.bmp|联盟入口3.bmp","30",0.80,0,intX,intY) 
                //联盟入口
                dm_ret = dm.FindColorBlock(967,380,991,394,"8ee2f8-050505|08ace4-050505",0.85,130,24,14,intX,intY)
                If intX >= 0 and intY >= 0 Then 
                    Call MoveToFcn(974,400)
                    dm.Delay 100
                    dm.LeftClick 
                    dm.Delay 1500
   							
                    //变量初始化
                    Call paramInit()
                    If getCard("幻精灵") = 0 Then 
                        装备切换 = - 1 
                    ElseIf 默认初始装备 = "无" Then
                        装备切换 = 1			
                    End If
                    //合作标志 = 1
                    Call 合作标志Handle(1)
                    扩建控制 = 合作前期扩建允许次数
                    TracePrint "已进入联盟，开始联盟合作"
							
                End If
			
                dm.Delay 30
                dm_ret = dm.FindStrFast(240,173,279,530, "加入", "ffffff-292929", 0.83, intX, intY)
                If intX >= 0 and intY >= 0 Then 
    						
                    Call MoveToFcn(intX+5,intY+5)
                    dm.Delay 100
                    dm.LeftClick 
                    dm.Delay 1000
   							
                    For 2
                        dm.Delay 500
                        
                        dm_ret = remoteFindPic("红叉.tif", "725,160,788,201", 0.8, 1) 
                        If len(dm_ret) > 0 Then 
                            Call MoveToFcn(686,465)
                            dm.Delay 200
                            dm.LeftClick 
                            dm.Delay 200
                            dm.LeftClick 
                            Exit For
                        End If
                    Next
   							
    						
                End If
    				
    			
    				
                dm.Delay 30
                dm_ret = dm.FindStrFast(240,173,279,530, "加入", "ffffff-252525", 0.83, intX, intY)
                If intX >= 0 and intY>= 0 Then 
                    Call MoveToFcn(intX+5,intY+5)
                    dm.Delay 100
                    dm.LeftClick 
                    dm.Delay 1000
   							
                    For 2
                        dm.Delay 500
                      
                        dm_ret = remoteFindPic("红叉.tif", "734, 157, 785, 195", 0.8, 1) 
                        If len(dm_ret) > 0 Then 
                            Call MoveToFcn(686,465)
                            dm.Delay 200
                            dm.LeftClick 
                            dm.Delay 200
                            dm.LeftClick 
                            Exit For
                        End If
                    Next
   							
                End If
    					
    					
                
    					
                If 联盟循环统计 > 600 or 联盟循环统计 = -1 Then 
                    dm.Delay 30
                    dm_ret = dm.FindColorBlock(76,550,98,570,"ffffff-050505|ff7e1c-050505",0.85,280,22,20,intX,intY)
                    //dm_ret = dm.FindPic(62,539,114,580,"联盟喊话1.bmp|联盟喊话2.bmp","30",0.80,0,intX,intY) 
                    If intX >= 0 and intY >= 0 Then 
                        //点击输入框
                        Call MoveToFcn(183,560)
                        dm.Delay 500
                        dm.LeftClick 
                        dm.Delay 500
                        dm.LeftClick 
                        联盟喊话内容temp = 联盟喊话内容 & "--" & Hour(Now) &":" & Minute(Now)	
                        Call 喊话输入(联盟喊话内容temp)

                        //发送
                        dm.Delay 200
                        Call MoveToFcn(596,556)
                        dm.Delay 500
                        dm.LeftClick 
                        dm.Delay 2000
                        dm.LeftClick 
   								
                        联盟循环统计 = 0
                    End If	
                End If
    					
                联盟循环统计 = 联盟循环统计 + 1		
    					
                If 判断当前是否在战场中() = 1 Then 
                    当前在战斗 = 1
                    dm.Delay 100
                    Exit Do
                End If
						
            Loop
			
        End If
    End If
End Sub

//Function OCR识别(hwnd)
//	Dim 识别结果, 提取, 分割, 文字
//	OCR识别 = Plugin.ZXLOCR.TTOCR(73,464,197,501,hwnd)
//	TracePrint "OCR识别:"& OCR识别
//End Function

Function OCR识别(hwnd)
    Call Plugin.BGCP2_02.SavePicture(hwnd, 73, 464, 197, 501, "C:\test_game\ghdab.bmp")
    dm.Delay 10
    oauth_http.Open "POST", "http://127.0.0.1:19811/ocr1", False, "", ""
    dm.Delay 20
    params = B64("C:\test_game\ghdab.bmp")
    dm.Delay 10
    oauth_http.Send (params)
    If oauth_http.Status = "200"Then 
        OCR识别 = oauth_http.responseText
    Else     
        OCR识别 =""
    End If
    TracePrint "OCR识别:" & OCR识别
End Function

Function B64(imgUrl)
    ADS.LoadFromFile imgUrl
    dm.Delay 10
    node. NodeTypedvalue = ADS.Read()
    B64 = node.Text
End Function

Function 识别VX消息(窗口句柄, 关键词)
    wxStr = OCR识别(窗口句柄)
    //wxStr = remoteOcr("73,456,484,504", 0,窗口句柄)
    TracePrint "wxStr:"& wxStr
    If Instr(1, wxStr, 关键词, 1) > 0 Then 
        识别VX消息 = Mid(wxStr, Len(关键词)+1, Len(wxStr)-Len(关键词)+1) 'MyVar 包含 "Script"。
    End If
End Function

Function get车号()
    下拉框Strs = Split( Form1.ComboBox41.List,"|")
    get车号 = 下拉框Strs(微信车号Index)
End Function


Function 发送微信消息(wx句柄id,msgStr)
    For 3
        Delay 100
        Call Plugin.Bkgnd.MoveTo (wx句柄id, 31, 562)
        Delay 100
        Call Plugin.Bkgnd.LeftClick(wx句柄id, 31, 562)
    Next


    Delay 50
    Call Plugin.Bkgnd.SendString(wx句柄id,msgStr)
    If 微信回车键发送ck = 1 Then 
        Delay 500
        Plugin.Bkgnd.KeyDown wx句柄id, 13
    Else 
        For 2
            Delay 150
            Call Plugin.Bkgnd.MoveTo (wx句柄id,465, 610)
            Delay 150
            Call Plugin.Bkgnd.LeftClick(wx句柄id, 465, 610)
        Next
    End If       

End Function

Function 加入房间失败()
    加入房间失败 = 0
    dm_ret = dm.FindStrFast(536, 326, 558, 349, "失", "ffffff-202020", 0.83, intX1a, intY1b)
    dm_ret1 = dm.FindStrFast(536, 326, 558, 349, "失", "D7D7D7-282828", 0.85, intX1a, intY1b)
    TracePrint "dm_ret加入房间失败dm_ret1:" & dm_ret & "---" & dm_ret1
    If dm_ret >= 0 or dm_ret1 >=0 Then 
        加入房间失败 = 1
        TracePrint "加入房间失败"
    End If
End Function


Sub 微信房间合作()
    If 微信房间自动识别ck = 1 Then 
        TracePrint "微信房间合作来了"
        If 1 = 1 Then 
            Dim 房间ID, reStr, 好友房间号, 微信喊话时间间隔,wxNowTime
            微信喊话时间间隔 = Int(微信喊话间隔text)
            wxNowTime = Now
            Call Plugin.Window.Size(微信窗口句柄id, 550, 640)
            If 扩展次数 > 0 Then 
                Call 发送微信消息(微信窗口句柄id, get车号() & " 号车合作已结束，合作关卡为：" & 当前合作关卡 & "，用时："&计时器分(合作计时器)&"分钟")
                dm.Delay 200
            End If
            Call 发送微信消息(微信窗口句柄id, 微信喊话内容text&"->"& get车号() & "号车[合作]已空车，上车发送[" & get车号() & "号房间1234]")
				
            Do
                TracePrint " 计时器(wxNowTime) : 微信喊话时间间隔:" &  计时器(wxNowTime) &":" & 微信喊话时间间隔
                If 计时器(wxNowTime) > 微信喊话时间间隔 Then 
                    Call 发送微信消息(微信窗口句柄id, 微信喊话内容text&"->"& get车号() & "号车[合作]已空车，上车发送[" & get车号() & "号房间1234]")
                    wxNowTime = Now
                End If
					
                dm.Delay 100
                房间ID = 识别VX消息(微信窗口句柄id, get车号() & "号房间")
                好友房间号 = Int(房间ID)
                If 好友房间号 > 0 Then 
                    If 好友房间号 < 1000 Then 
                        wxNowTime = Now
                        Call 发送微信消息(微信窗口句柄id, get车号() & " 号识别出错，请重新创建房间发送")	
                    Else 
                        TracePrint "识别成功退出循环"
                        Call 发送微信消息(微信窗口句柄id, get车号() & " 号正在进入[合作]房间号 "&房间ID)	
                        Exit Do
                    End If
					
                End If
                TracePrint "识别房间号中"
            Loop
	
            Do
                If 好友房间号 > 0 Then 
                    合作计时器 = Now
                    TracePrint "拿到最终房间号：" & 好友房间号
                    is合作次数 = 1
                    For 4
                        If 合作助战() = 1 Then 
                            is合作次数 = 0
                            Exit For 
                        End If
                        dm.Delay 1000
                    Next
                    If is合作次数 = 0 Then 
                        Call MoveToFcn(629,571)
                        dm.Delay 200
                        dm.LeftClick 
                        dm.Delay 1000
                        is合作次数 = 1
                        For 5
                            If 合作助战弹窗() = 1 Then 
                                //点击输入框
                                Call MoveToFcn(504,358)
                                dm.Delay 100
                                dm.LeftClick 
                                dm.Delay 500
                                Call 喊话输入(好友房间号)
   								
                                //确定助战
                                dm.Delay 1000
                                For 1
                                    Call MoveToFcn(524,430)
                                    dm.Delay 50
                                    dm.LeftClick 
                                    dm.Delay 100
                                Next
                                For 8
                                    dm.Delay 300
                                    If 加入房间失败() = 1 Then 
                                        Call 发送微信消息(微信窗口句柄id, get车号() & " 号加入房间"&房间ID&"失败，请重新创建房间发送")
                                        好友房间号 = 0
                                        Exit For
                                    End If
                                Next
                                If 好友房间号 > 0 Then 
                                    dm.Delay 2500
                                End If
                                
                                //关闭助战
                                Call 关闭助战()
   								
                                is合作次数 = 0
                                Exit For
                            End If
                            dm.Delay 500
                        Next
   						
                        If 判断当前是否在战场中() = 1 and 好友房间号 > 0 Then 
                            当前在战斗 = 1
                            TracePrint "进入好友战场了"
                            dm.Delay 100
                            //变量初始化
                            Call paramInit()
                            If getCard("幻精灵") = 0 Then 
                                装备切换 = - 1 
                            ElseIf 默认初始装备 = "无" Then
                                装备切换 = 1			
                            End If
                            //合作标志 = 1
                            Call 合作标志Handle(1)
                            扩建控制 = 合作前期扩建允许次数
                            TracePrint "已进入好友房间，开始合作"
                            Exit Do
                        End If
                    End If

                    If is合作次数 = 1 Then 
                        Call MoveToFcn(629,571)
                        dm.Delay 50
                        dm.LeftClick 
                        For 5
                            dm.Delay 500
                            If 合作未打完弹窗() = 1 Then 
                                //点击与好友一起
                                For 3
                                    Call MoveToFcn(337,516)
                                    dm.Delay 50
                                    dm.LeftClick 
                                    dm.Delay 100
                                Next
   								
                                dm.Delay 2000
   								
                                //确定加入
                                For 3
                                    Call MoveToFcn(598,430)
                                    dm.Delay 50
                                    dm.LeftClick 
                                    dm.Delay 100
                                Next
   								
   								 
                                dm.Delay 2000
   								
   								
                                //点击输入框
                               
                                Call MoveToFcn(504,358)
                                dm.Delay 50
                                dm.LeftClick 
                                dm.Delay 200
                               

                                dm.Delay 2000
   								
                                Call 喊话输入(好友房间号)
   								
                                //确定助战
                                dm.Delay 1000
                                For 1
                                    Call MoveToFcn(524,430)
                                    dm.Delay 50
                                    dm.LeftClick 
                                    dm.Delay 100
                                Next

                                For 8
                                    dm.Delay 300
                                    If 加入房间失败() = 1 Then 
                                        Call 发送微信消息(微信窗口句柄id, get车号() & " 号加入房间"&房间ID&"失败，请重新创建房间发送")
                                        好友房间号 = 0
                                        Exit For
                                    End If
                                Next
                                If 好友房间号 > 0 Then 
                                    dm.Delay 2500
                                End If
                                //关闭助战
                                Call 关闭助战()	
                                is合作次数 = -1
                                Exit For
                            End If
                        Next
                    End If
					
                    //合作看广告判断
                    If is合作次数 = 1 Then 
                        Call MoveToFcn(629,571)
                        dm.Delay 50
                        dm.LeftClick 
	
                        For 5
                            dm.Delay 500
                           
                            dm_ret = remoteFindPic("合作看广告界面.tif", "416,406,462,450", 0.8, 1)
                            If len(dm_ret) > 0 Then 
                            	
                                //点击看广告
                                Call MoveToFcn(522,432)
                                dm.Delay 50
                                dm.LeftClick 
                                dm.Delay 2000
                                
                                dm_ret = remoteFindPic("合作看广告界面.tif", "416,406,462,450", 0.8, 1)
                                If len(dm_ret) > 0 Then 
                                    Call MoveToFcn(522,432)
                                    dm.Delay 50
                                    dm.LeftClick 
                                    dm.Delay 2000
                                End If
   								
   								
                                Call MoveToFcn(936,44)
                                dm.Delay 100
                                dm.LeftClick 
    							
                                If 是否有免广告特权ck = 1 Then 
                                    For 30
                                        dm.Delay 1000
                                        Call MoveToFcn(936,44)
                                        dm.Delay 100
                                        dm.LeftClick 
                                        If 主界面对战按钮() = 1 or 返回主页面按钮() = 1 Then 
    										
                                            Exit For
                                        End If
                                    Next
                                Else	
   								
                                    广告卡r = 0
                                    无广告可看r = 0
                                    For 6
                                        dm.Delay 1000
                                        If 广告卡r = 0 Then 
                                            广告卡r= 广告卡()
                                        End If
   			 							
                                        If 广告卡r = 2 Then 
                                            Exit For
                                        Else
                                            dm.Delay 1000
                                            无广告可看r = 无广告可看()
                                            If 无广告可看r = 1 Then 
                                                Exit For
                                            End If
                                        End If
   			 							
                                    Next
   		    						
                                    Call MoveToFcn(936,44)
                                    dm.Delay 100
                                    dm.LeftClick 
                                    dm.Delay 100
                                    dm.LeftClick
                                    If 主界面对战按钮() = 1 or 返回主页面按钮() = 1 Then 
                                        广告卡r = 2
                                    End If
   		    						
   		    						
                                    If 广告卡r <> 2 Then 
                                        If 无广告可看r <> 1 Then 
                                            Call 关闭广告()
                                        End If
                                    End If			
                                End If
                                //点合作
                                dm.Delay 3000
                                Call MoveToFcn(629,571)
                                dm.Delay 200
                                dm.LeftClick 
                                dm.Delay 2000
                    					
                                For 3
                                    dm.Delay 1000
                                    //dm_ret = dm.FindPic(296,463,395,523, "与好友一起1.bmp|与好友一起2.bmp|与好友一起3.bmp", "30", 0.80, 0, intX, intY)
                                    If 合作未打完弹窗() = 1 Then 
                                        //点击与好友一起
                                        Call MoveToFcn(337,516)
                                        dm.Delay 200
                                        dm.LeftClick 
                                        dm.Delay 1500
                                        dm.LeftClick 
                                        dm.Delay 1500
   										
                                        //确定加入
                                        Call MoveToFcn(598,430)
                                        dm.Delay 200
                                        dm.LeftClick 
                                        dm.Delay 1500
                                        dm.LeftClick 
                                        dm.Delay 1500
   										
   										
                                        //点击输入框
                                        Call MoveToFcn(504,358)
                                        dm.Delay 100
                                        dm.LeftClick 
                                        dm.Delay 2000
   										
                                        Call 喊话输入(好友房间号)
   										
                                        //确定助战
                                        dm.Delay 1000
                                        For 1
                                            Call MoveToFcn(524,430)
                                            dm.Delay 50
                                            dm.LeftClick 
                                            dm.Delay 100	
                                        Next
                                        For 8
                                            dm.Delay 300
                                            If 加入房间失败() = 1 Then 
                                                Call 发送微信消息(微信窗口句柄id, get车号() & " 号加入房间"&房间ID&"失败，请重新创建房间发送")
                                                好友房间号 = 0
                                                Exit For
                                            End If
                                        Next
                                        If 好友房间号 > 0 Then 
                                            dm.Delay 2500
                                        End If
                                        //关闭助战
                                        Call 关闭助战()
   											
                                        is合作次数 = -1
                                        Exit For
                                    End If
                                Next
   								
                                Exit For
                            End If
                        Next
                    End If
					
					
                Else 
                    TracePrint "当前好友没房间号：" & 好友房间号
                End If

                If 好友房间号 > 0 Then 
                	
                    //变量初始化
                    Call paramInit()
                    If getCard("幻精灵") = 0 Then 
                        装备切换 = - 1 
                    ElseIf 默认初始装备 = "无" Then
                        装备切换 = 1			
                    End If
                    //合作标志 = 1
                    Call 合作标志Handle(1)
                    扩建控制 = 合作前期扩建允许次数
                    For 40
                        dm.Delay 1000
                        If 判断当前是否在战场中() = 1 Then 
                            Call 发送微信消息(微信窗口句柄id, get车号() & " 号成功进入[合作]房间号 "&房间ID)
                            当前在战斗 = 1
                            TracePrint "进入战场了"
                            TracePrint "已进入好友房间，开始合作"
                            合作计时器 = Now
                            Exit Do
                        End If
                    Next
                End If 
				
    			
    			
                dm.Delay 200
                If 对战结束确定() = 1 Then 
                    当前在战斗 = 0
                    TracePrint "好友合作子程序判断了对战结束确定"
                    Call MoveToFcn(515,535)
                    dm.Delay 100
                    dm.LeftClick 
                End If
    			
    			
                Exit Do

            Loop
			
        End If
    End If
End Sub


Sub 微信房间寒冰() 
    Do
        Dim 房间ID, reStr, 好友房间号, 微信喊话时间间隔,wxNowTime,寒冰购买助战,与好友一起,加入房间,加入,res,寒冰未打完助战
        微信喊话时间间隔 = Int(微信喊话间隔text)
        wxNowTime = Now
        Call Plugin.Window.Size(微信窗口句柄id, 550, 640)
        If 扩展次数 > 0 Then 
            Call 发送微信消息(微信窗口句柄id, get车号() & " 号车寒冰已结束，合作关卡为：" & 当前合作关卡 & "，用时："&计时器分(合作计时器)&"分钟")
            
            dm.Delay 150
        End If
        Call 发送微信消息(微信窗口句柄id, 微信喊话内容text&"->"& get车号() & "号车[寒冰]已空车，上车发送[" & get车号() & "号房间1234]")
			
        Do
            TracePrint " 计时器(wxNowTime) : 微信喊话时间间隔:" &  计时器(wxNowTime) &":" & 微信喊话时间间隔
            If 计时器(wxNowTime) > 微信喊话时间间隔 Then 
                Call 发送微信消息(微信窗口句柄id, 微信喊话内容text&"->"& get车号() & "号车[寒冰]已空车，上车发送[" & get车号() & "号房间1234]")
                wxNowTime = Now
            End If
				
            dm.Delay 100
            房间ID = 识别VX消息(微信窗口句柄id, get车号() & "号房间")
            好友房间号 = Int(房间ID)
            If 好友房间号 > 0 Then 
                If 好友房间号 < 1000 Then 
                    wxNowTime = Now
                    Call 发送微信消息(微信窗口句柄id, get车号() & " 号识别出错，请重新创建房间发送")	
                Else 
                    TracePrint "识别成功退出循环"
                    Call 发送微信消息(微信窗口句柄id, get车号() & " 号正在进入[寒冰]房间号 "&房间ID)	
                    Exit Do
                End If
				
            End If
            TracePrint "识别房间号中"
        Loop
        
        If 好友房间号 > 0 Then 
            合作计时器 = Now
            If 进入寒冰主界面() = 1 Then 
                For 100
                    //加入房间......
                    dm.Delay 1000
    				
                    //单击冰堡挑战
                    Call MoveToFcn(840,567)
                    dm.Delay 50
                    dm.LeftClick 
                    dm.Delay 2000
        			
                    寒冰未打完助战 = remoteFindPic("寒冰未打完助战.bmp", "353,443,433,486", 0.8, 1)
                    If len(寒冰未打完助战) > 0 Then 
                        Call MoveToFcn(387,463)
                        dm.Delay 50
                        dm.LeftClick 
                        dm.Delay 1500
                    End If
    				
                    与好友一起 = remoteFindPic("与好友一起.bmp", "286,462,395,515", 0.83, 1)
                    If len(与好友一起) > 0 Then 
                        Call MoveToFcn(333,514)
                        dm.Delay 50
                        dm.LeftClick 
                        dm.Delay 1500
                    End If
    				
                    加入房间 = remoteFindPic("加入房间.bmp", "554,408,658,453", 0.80, 1)
                    If len(加入房间) > 0 Then 
                        Call MoveToFcn(605,430)
                        dm.Delay 50
                        dm.LeftClick 
                        dm.Delay 1500
                        出现房间号 = 1
                    End If
    				
                    寒冰购买助战 = remoteFindPic("寒冰购买助战.bmp", "341,442,443,488", 0.80, 1)
                    If len(寒冰购买助战) > 0 Then 
                        res = Split(寒冰购买助战, "|")
                        Call MoveToFcn(Int(res(0)),int(res(1)))
                        dm.Delay 50
                        dm.LeftClick 
                        dm.Delay 1500
                        出现房间号 = 1
                    End If

                    For 5
                        加入 = remoteFindPic("加入.bmp|合作寒冰助战.bmp", "491,416,547,452", 0.80, 1)
                        If len(加入) > 0  Then 
                            //点击输入框
                            Call MoveToFcn(504,358)
                            dm.Delay 100
                            dm.LeftClick 
                            dm.Delay 500
                            Call 喊话输入(好友房间号)
   							
                            //确定助战
                            dm.Delay 1000
                            Call MoveToFcn(524,430)
                            dm.Delay 50
                            dm.LeftClick 
                            dm.Delay 100
                        	
                            For 8
                                dm.Delay 300
                                If 加入房间失败() = 1 Then 
                                    好友房间号 = -1
                                    //Form1.InputBox74.Text = ""
                                    Call 发送微信消息(微信窗口句柄id, get车号() & " 号加入房间"&房间ID&"失败，请重新创建房间发送")
                                    Exit For
                                End If
                            Next
                            If 好友房间号 > 0 Then 
                                dm.Delay 5000
                            End If
                        	
                            //关闭助战
                            Call 关闭助战()
   							
                            is合作次数 = 0
                            Exit For
                        End If
                        dm.Delay 500
                    Next
    				
                    Exit For
                Next
            End If
	
	
            If 好友房间号 > 0 Then 
                好友房间号 = -1
                For 40
                    dm.Delay 1000
                    If 判断当前是否在战场中() = 1 Then 
                        Call 发送微信消息(微信窗口句柄id, get车号() & " 号成功进入[寒冰]房间号 "&房间ID)	
                        当前在战斗 = 1
                        TracePrint "进入战场了"
                        dm.Delay 50
                        //变量初始化
                        Call paramInit()
                        If getCard("幻精灵") = 0 Then 
                            装备切换 = - 1 
                        ElseIf 默认初始装备 = "无" Then
                            装备切换 = 1			
                        End If
                        //合作标志 = 1
                        Call 合作标志Handle(1)
                        扩建控制 = 合作前期扩建允许次数
                        好友房间号 = 1
                        合作计时器 = Now
                        TracePrint "已进入好友房间，开始合作"
                        Exit For
                    End If
                Next
            End If 
			
    		
        End If
    	
        dm.Delay 200
        If 对战结束确定() = 1 Then 
            当前在战斗 = 0
            TracePrint "好友合作子程序判断了对战结束确定"
            Call MoveToFcn(515,535)
            dm.Delay 100
            dm.LeftClick 
             	
        End If
       	
        If 好友房间号 <> -1 Then
            Exit Do
        End If
       
    Loop                
End Sub

Function 鼠标向左滑动()
    Delay 1500
    Call MoveToFcn(498, 309)
    Delay 100
    dm.LeftDown
    Delay 100
    Call MoveToFcn(498-150, 309)
    Delay 100
    dm.LeftUp
End Function


Function 双开自动完成6次寒冰b()
	
    Dim 好友房间号, 寒冰界面1, 寒冰界面2, 活动, res, 与好友一起, 加入房间,出现房间号,加入,寒冰未打完助战,isExtFor
    Do
    
        Do
            好友房间号 = Form1.InputBox74.Text
            If len(好友房间号) > 0 Then 
                好友房间号 = Int(好友房间号)
                If 好友房间号 > 999 Then 
                    Exit Do
                Else 
                    TracePrint "房间号不对，清空"
                    Form1.InputBox74.Text = ""
                End If
            End If
            dm.Delay 2000   
            TracePrint "等待房间号中"
        Loop
    	

        If 进入寒冰主界面() = 1 Then 
    		
            For 10
                //加入房间......
                dm.Delay 1000
    			
                //单击冰堡挑战
                Call MoveToFcn(840,567)
                dm.Delay 50
                dm.LeftClick 
                dm.Delay 2000
        		
        		
                TracePrint "识别寒冰未打完助战"
                寒冰未打完助战 = remoteFindPic("寒冰未打完助战.bmp", "353,443,433,486", 0.8, 1)
                If len(寒冰未打完助战) > 0 Then 
                    TracePrint "识别寒冰未打完助战成功"
                    Call MoveToFcn(387,463)
                    dm.Delay 50
                    dm.LeftClick 
                    dm.Delay 1500
                End If
        		
    			
                与好友一起 = remoteFindPic("与好友一起.bmp", "286,462,395,515", 0.81, 1)
                If len(与好友一起) > 0 Then 
                    Call MoveToFcn(333,514)
                    dm.Delay 50
                    dm.LeftClick 
                    dm.Delay 1500
                End If
    			
                加入房间 = remoteFindPic("加入房间.bmp", "554,408,658,453", 0.80, 1)
                If len(加入房间) > 0 Then 
                    Call MoveToFcn(605,430)
                    dm.Delay 50
                    dm.LeftClick 
                    dm.Delay 1500
                    出现房间号 = 1
                End If
    			
                For 5
                    加入 = remoteFindPic("加入.bmp|合作寒冰助战.bmp", "491,416,547,452", 0.80, 1)
                    If len(加入) > 0  Then 
                        //点击输入框
                        Call MoveToFcn(504,358)
                        dm.Delay 100
                        dm.LeftClick 
                        dm.Delay 500
                        Call 喊话输入(好友房间号)
   						
                        //确定助战
                        dm.Delay 1000
                        Call MoveToFcn(524,430)
                        dm.Delay 50
                        dm.LeftClick 
                        dm.Delay 100
                    	
                        For 8
                            dm.Delay 300
                            If 加入房间失败() = 1 Then 
                                好友房间号 = -1
                                Form1.InputBox74.Text = ""
                                isExtFor = 1
                                Exit For
                            End If
                        Next
                        If 好友房间号 > 0 Then 
                            dm.Delay 5000
                        End If
                    	
                        //关闭助战
                        Call 关闭助战()
   						
                        is合作次数 = 0
                        isExtFor = 1
                        Exit For
                    End If
                Next
           		
                If isExtFor = 1 Then 
                    Exit For
                End If
                dm.Delay 500
            Next
        End If


        If 好友房间号 > 0 Then 
            好友房间号 = -1
            For 40
                dm.Delay 1000
                If 判断当前是否在战场中() = 1 Then 
                    当前在战斗 = 1
                    TracePrint "进入战场了"
                    dm.Delay 50
                    //变量初始化
                    Call paramInit()
                    If getCard("幻精灵") = 0 Then 
                        装备切换 = - 1 
                    ElseIf 默认初始装备 = "无" Then
                        装备切换 = 1			
                    End If
                    //合作标志 = 1
                    Call 合作标志Handle(1)
                    扩建控制 = 合作前期扩建允许次数
                    好友房间号 = 1
                    TracePrint "已进入好友房间，开始合作"
                    Exit For
                End If
            Next
        End If 
		
    	
    	
        dm.Delay 200
        If 对战结束确定() = 1 Then 
            当前在战斗 = 0
            TracePrint "好友合作子程序判断了对战结束确定"
            Call MoveToFcn(515,535)
            dm.Delay 100
            dm.LeftClick 
             
        End If
       
        If 好友房间号 <> -1 Then
            Exit Do
        End If
    	
       
    Loop

End Function 
Function 双开自动完成6次寒冰a()
    Dim 好友房间号, 寒冰界面1, 寒冰界面2,  与好友一起, 创建房间,出现房间号
    出现房间号 = 0
    Do
        If 进入寒冰主界面() = 1 Then 
    		
            For 100
                //创建房间
                dm.Delay 1000
    			
                //单击冰堡挑战
                Call MoveToFcn(840,567)
                dm.Delay 50
                dm.LeftClick 
                dm.Delay 1500
    			
                与好友一起 = remoteFindPic("与好友一起.bmp", "286,462,395,515", 0.83, 1)
                If len(与好友一起) > 0 Then 
                    Call MoveToFcn(333,514)
                    dm.Delay 50
                    dm.LeftClick 
                    dm.Delay 1500
                End If
    			
                创建房间 = remoteFindPic("创建房间.bmp", "365,411,490,459", 0.80, 1)
                If len(创建房间) > 0 Then 
                    Call MoveToFcn(424,430)
                    dm.Delay 50
                    dm.LeftClick 
                    dm.Delay 1500
                    出现房间号 = 1
                End If
    			
                Exit For
            Next
        End If
    	


        If 出现房间号 > 0 Then 
        	
            For 5
                dm.Delay 200
                好友房间号 = dm.Ocr(484, 344, 560, 374, "D6D6D6-292929", 0.84)
                TracePrint "识别到房间号为：" & 好友房间号
                If len(好友房间号) <= 0 Then 
                    //执行创建房间
                    出现房间号 = 0
                Else 
                    If Int(好友房间号) > 999 Then 
                        Form1.InputBox74.Text = 好友房间号
                        出现房间号 = 1
                        dm.Delay 2000
                        If 社交频道入口(0) = 1 Then 
                            Call MoveToFcn(976,470)
                            dm.Delay 50
                            dm.LeftClick 
                        End If
                        Exit For
                    Else 
                        出现房间号 = 0
                    End If
                End If
            Next
        	
            If 出现房间号 > 0 Then 
                出现房间号 = -1
                For 180
                    dm.Delay 1000
                    TracePrint "等待进入战场中..."
                    If 判断当前是否在战场中() = 1 Then 
                        当前在战斗 = 1
                        TracePrint "进入战场了"
                        dm.Delay 50
                        //变量初始化
                        Call paramInit()
                        If getCard("幻精灵") = 0 Then 
                            装备切换 = - 1 
                        ElseIf 默认初始装备 = "无" Then
                            装备切换 = 1			
                        End If
                        //合作标志 = 1
                        Call 合作标志Handle(1)
                        扩建控制 = 合作前期扩建允许次数
                        TracePrint "已进入好友房间，开始合作"
                        出现房间号 = 1
                        Form1.InputBox74.Text = ""
                        Exit For
                    End If
                	
                    If len(Form1.InputBox74.Text) < 2 Then 
                        TracePrint "检查到房间号无效，重新创建"
                        出现房间号 = - 1 
                        dm.Delay 2000
                        Exit For
                    End If
                Next
            End If 
        End If 

        dm.Delay 200
        If 对战结束确定() = 1 Then 
            当前在战斗 = 0
            TracePrint "自动6次合作子程序判断了对战结束确定"
            Call MoveToFcn(515,535)
            dm.Delay 100
            dm.LeftClick 
        End If
    	
        If 世界频道社交() = 1 Then 
            Call MoveToFcn(620,586)
            dm.Delay 50
            dm.LeftClick 
            dm.Delay 3000
        End If
		
        If 出现房间号 <> - 1  Then 
            Exit Do
        End If  
    Loop

End Function

Sub 双开自动完成6次合作()
    If 双开自动完成6次合作Index = 0 Then 
        Call 双开自动完成6次合作a()
    ElseIf 双开自动完成6次合作Index = 1 Then 
        Call 双开自动完成6次合作b()
    End If	
End Sub

Sub 双开自动完成6次寒冰()
    If 双开自动完成6次合作Index = 0 Then 
        Call 双开自动完成6次寒冰a()
    ElseIf 双开自动完成6次合作Index = 1 Then 
        Call 双开自动完成6次寒冰b()
    End If	
End Sub
	


Function 双开自动完成6次合作b()
    Dim 好友房间号

    Do
        If 世界频道社交() = 1 Then 
            Call MoveToFcn(620,586)
            dm.Delay 50
            dm.LeftClick 
            dm.Delay 1000
        End If
		
        For 3
            dm.Delay 500
            dm_ret = remoteFindPic("红叉.tif", "69,73,962,528", 0.85, 1)
            If len(dm_ret) > 1 Then 
                TracePrint "自动6次合作开局检查到红叉"
                Dim res
                res = Split(dm_ret, "|")
                Call MoveToFcn(Int(res(0)),int(res(1)))
                dm.Delay 100
                dm.LeftClick 
                红叉i = 0
                TracePrint "关闭红叉"
                Exit For
            End If
        Next
		
        Do
            好友房间号 = Form1.InputBox74.Text
            If len(好友房间号) > 0 Then 
                If 双开自动6次后转对战ck = 1 Then 
                    If 好友房间号 = "转对战"  Then 
                        Call 转对战()
                        Exit Function
                    End If
                End If
                好友房间号 = Int(好友房间号)
                If 好友房间号 > 999 Then 
                    Exit Do
                Else 
                    TracePrint "房间号不对，清空"
                    Form1.InputBox74.Text = ""
                End If
            End If
            dm.Delay 2000   
            TracePrint "等待房间号中"
        Loop
    	
        If 好友房间号 > 0 Then 
            TracePrint "拿到最终房间号：" & 好友房间号
            is合作次数 = 1
            For 4
                If 合作助战() = 1 Then 
                    is合作次数 = 0
                    Exit For 
                End If
                dm.Delay 1000
            Next
            If is合作次数 = 0 Then 
                Call MoveToFcn(629,571)
                dm.Delay 200
                dm.LeftClick 
                dm.Delay 1000
   				
                For 5
                    
                    If 合作助战弹窗() = 1 Then 
                        //点击输入框
                        Call MoveToFcn(504,358)
                        dm.Delay 100
                        dm.LeftClick 
                        dm.Delay 500
                        Call 喊话输入(好友房间号)
   						
                        //确定助战
                        dm.Delay 1000
                        Call MoveToFcn(524,430)
                        dm.Delay 50
                        dm.LeftClick 
                        dm.Delay 100
                        
                        For 8
                            dm.Delay 300
                            If 加入房间失败() = 1 Then 
                                好友房间号 = -1
                                Form1.InputBox74.Text = ""
                                Exit For
                            End If
                        Next
                        If 好友房间号 > 0 Then 
                            dm.Delay 5000
                        End If
                        
                        //关闭助战
                        Call 关闭助战()
   						
                        is合作次数 = 0
                        Exit For
                    End If
                    dm.Delay 500
                Next

            End If

            If is合作次数 = 1 Then 
                Call MoveToFcn(629,571)
                dm.Delay 50
                dm.LeftClick 
                For 5
                    dm.Delay 500
                    If 合作未打完弹窗() = 1 Then 
                        //点击与好友一起
                        For 3
                            Call MoveToFcn(337,516)
                            dm.Delay 50
                            dm.LeftClick 
                            dm.Delay 100
                        Next
   						
                        dm.Delay 2000
   						
                        //确定加入
                        For 3
                            Call MoveToFcn(598,430)
                            dm.Delay 50
                            dm.LeftClick 
                            dm.Delay 100
                        Next
   						
   							
                        dm.Delay 2000
   						
   						
                        //点击输入框
                        Call MoveToFcn(504,358)
                        dm.Delay 100
                        dm.LeftClick 
                 
                   

                        dm.Delay 2000
   						
                        Call 喊话输入(好友房间号)
   						
                        //确定助战
                        dm.Delay 1000
                        For 1
                            Call MoveToFcn(524,430)
                            dm.Delay 50
                            dm.LeftClick 
                            dm.Delay 100
                        Next

                        For 8
                            dm.Delay 300
                            If 加入房间失败() = 1 Then 
                                好友房间号 = -1
                                Form1.InputBox74.Text = ""
                                Exit For
                            End If
                        Next
                        If 好友房间号 > 0 Then 
                            dm.Delay 2500
                        End If
                        //关闭助战
                        Call 关闭助战()	
                        is合作次数 = -1
                        Exit For
                    End If
                Next
            End If
			
            //合作看广告判断
            If is合作次数 = 1 Then 
                Call MoveToFcn(629,571)
                dm.Delay 50
                dm.LeftClick 

                For 5
                    dm.Delay 500
                   
                    dm_ret = remoteFindPic("合作看广告界面.tif", "416,406,462,450", 0.8, 1)
                    If len(dm_ret) > 0 Then 
                        //点击看广告
                        Call MoveToFcn(522,432)
                        dm.Delay 50
                        dm.LeftClick 
                        dm.Delay 2000
                        
                        dm_ret = remoteFindPic("合作看广告界面.tif", "416,406,462,450", 0.8, 1)
                        If len(dm_ret) > 0 Then 
                            Call MoveToFcn(522,432)
                            dm.Delay 50
                            dm.LeftClick 
                            dm.Delay 2000
                        End If
   						
   						
                        Call MoveToFcn(936,44)
                        dm.Delay 100
                        dm.LeftClick 
    					
                        If 是否有免广告特权ck = 1 Then 
                            For 30
                                dm.Delay 1000
                                Call MoveToFcn(936,44)
                                dm.Delay 100
                                dm.LeftClick 
                                If 主界面对战按钮() = 1 or 返回主页面按钮() = 1 Then 
                                    Exit For
                                End If
                            Next
                        Else	
   						
                            广告卡r = 0
                            无广告可看r = 0
                            For 6
                                dm.Delay 1000
                                If 广告卡r = 0 Then 
                                    广告卡r= 广告卡()
                                End If
   			 					
                                If 广告卡r = 2 Then 
                                    Exit For
                                Else
                                    dm.Delay 1000
                                    无广告可看r = 无广告可看()
                                    If 无广告可看r = 1 Then 
                                        Exit For
                                    End If
                                End If
   			 					
                            Next
   		    				
                            Call MoveToFcn(936,44)
                            dm.Delay 100
                            dm.LeftClick 
                            dm.Delay 100
                            dm.LeftClick
                            If 主界面对战按钮() = 1 or 返回主页面按钮() = 1 Then 
                                广告卡r = 2
                            End If
   		    				
   		    				
                            If 广告卡r <> 2 Then 
                                If 无广告可看r <> 1 Then 
                                    Call 关闭广告()
                                End If
                            End If			
                        End If
                        
                        //点合作
                        dm.Delay 3000
                        Call MoveToFcn(629,571)
                        dm.Delay 200
                        dm.LeftClick 
                        dm.Delay 2000
                    			
                        For 3
                            dm.Delay 1000
                            If 合作未打完弹窗() = 1 Then 
                                //点击与好友一起
                                Call MoveToFcn(337,516)
                                dm.Delay 200
                                dm.LeftClick 
                                dm.Delay 1500
                                dm.LeftClick 
                                dm.Delay 1500
   								
                                //确定加入
                                Call MoveToFcn(598,430)
                                dm.Delay 200
                                dm.LeftClick 
                                dm.Delay 1500
                                dm.LeftClick 
                                dm.Delay 1500
   								
   								
                                //点击输入框
                                Call MoveToFcn(504,358)
                                dm.Delay 100
                                dm.LeftClick 
                                dm.Delay 2000
                               
                                Call 喊话输入(好友房间号)
   								
                                //确定助战
                                dm.Delay 1000
                                For 1
                                    Call MoveToFcn(524,430)
                                    dm.Delay 50
                                    dm.LeftClick 
                                    dm.Delay 100	
                                Next
                                For 8
                                    dm.Delay 300
                                    If 加入房间失败() = 1 Then 
                                        好友房间号 = -1
                                        Form1.InputBox74.Text = ""
                                        Exit For
                                    End If
                                Next
                                If 好友房间号 > 0 Then 
                                    dm.Delay 2500
                                End If
                                //关闭助战
                                Call 关闭助战()
   									
                                is合作次数 = -1
                                Exit For
                            End If
                        Next
   						
                        Exit For
                    End If
                Next
            End If
			
			
        Else 
            TracePrint "当前好友没房间号：" & 好友房间号
        End If

        If 好友房间号 > 0 Then 
            好友房间号 = -1
            For 40
                dm.Delay 1000
                If 判断当前是否在战场中() = 1 Then 
                    当前在战斗 = 1
                    TracePrint "进入战场了"
                    dm.Delay 50
                    //变量初始化
                    Call paramInit()
                    If getCard("幻精灵") = 0 Then 
                        装备切换 = - 1 
                    ElseIf 默认初始装备 = "无" Then
                        装备切换 = 1			
                    End If
                    //合作标志 = 1
                    Call 合作标志Handle(1)
                    扩建控制 = 合作前期扩建允许次数
                    好友房间号 = 1
                    TracePrint "已进入好友房间，开始合作"
                    Exit For
                End If
            Next
        End If 
		
    	
    	
        dm.Delay 200
        If 对战结束确定() = 1 Then 
            当前在战斗 = 0
            TracePrint "好友合作子程序判断了对战结束确定"
            Call MoveToFcn(515,535)
            dm.Delay 100
            dm.LeftClick 
             
        End If
       
        If 好友房间号 <> -1 Then
            Exit Do
        End If
    	
       
    Loop

End Function

Function 双开自动完成6次合作a()

    Dim 出现房间号
    出现房间号 = 0
    Do
        If 世界频道社交() = 1 Then 
            Call MoveToFcn(620,586)
            dm.Delay 50
            dm.LeftClick 
            dm.Delay 1000
        End If
		
        For 3
            dm.Delay 500
            dm_ret = remoteFindPic("红叉.tif", "69,73,962,528", 0.85, 1)
            If len(dm_ret) > 1 Then 
                TracePrint "自动6次合作开局检查到红叉"
                Dim res
                res = Split(dm_ret, "|")
                Call MoveToFcn(Int(res(0)),int(res(1)))
                dm.Delay 100
                dm.LeftClick 
                红叉i = 0
                TracePrint "关闭红叉"
            End If
        Next
    
        If 1 > 0 Then 
            is合作次数 = 1
            For 3
                If 合作助战() = 1 Then 
                    is合作次数 = 0
                    Exit For 
                End If
                dm.Delay 1000
            Next
            If is合作次数 = 0 Then 
                If 双开自动6次后转对战ck = 1 Then 
                    Form1.InputBox74.Text ="转对战"
                    Call 转对战()
                    Exit Function
                Else 
                    MessageBox "合作已打完，该号不能创建房间了"
                End If
              
                Exit Do
            End If

            If is合作次数 = 1 Then 
                Call MoveToFcn(629,571)
                dm.Delay 50
                dm.LeftClick 
                For 5 
                    dm.Delay 500
                    If 合作未打完弹窗() = 1 Then 
                        //点击与好友一起
                        For 3
                            Call MoveToFcn(337,516)
                            dm.Delay 50
                            dm.LeftClick 
                            dm.Delay 100
                        Next
                        dm.Delay 3000
   						
                        //创建房间
                        Call MoveToFcn(418,431)
                        dm.Delay 50
                        dm.LeftClick 
                        dm.Delay 2000
   						
                        出现房间号 = 1
                        is合作次数 = 0
                        Exit For
                    End If	
                       
                Next
            End If
			
            //合作看广告判断
            If is合作次数 = 1 Then 
                Call MoveToFcn(629,571)
                dm.Delay 50
                dm.LeftClick 

                For 5
                    dm.Delay 600
                    dm_ret = remoteFindPic("合作看广告界面.tif", "416,406,462,450", 0.8, 1)
                    If len(dm_ret) > 0 Then 
                        //点击看广告
                        Call MoveToFcn(522,432)
                        dm.Delay 50
                        dm.LeftClick 
                        dm.Delay 2000
                            
                        dm_ret = remoteFindPic("合作看广告界面.tif", "416,406,462,450", 0.8, 1)
                        If len(dm_ret) > 0 Then 
                            Call MoveToFcn(522,432)
                            dm.Delay 50
                            dm.LeftClick 
                            dm.Delay 2000
                        End If
   						
   						
                        Call MoveToFcn(936,44)
                        dm.Delay 100
                        dm.LeftClick 
    					
                        If 是否有免广告特权ck = 1 Then 
                            For 30
                                dm.Delay 1000
                                Call MoveToFcn(936,44)
                                dm.Delay 100
                                dm.LeftClick 
                                If 主界面对战按钮() = 1 or 返回主页面按钮() = 1 Then 
                                    Exit For
                                End If
                            Next
                        Else	
   						
                            广告卡r = 0
                            无广告可看r = 0
                            For 6
                                dm.Delay 1000
                                If 广告卡r = 0 Then 
                                    广告卡r= 广告卡()
                                End If
   			 					
                                If 广告卡r = 2 Then 
                                    Exit For
                                Else
                                    dm.Delay 1000
                                    无广告可看r = 无广告可看()
                                    If 无广告可看r = 1 Then 
                                        Exit For
                                    End If
                                End If
   			 					
                            Next
   		    				
                            Call MoveToFcn(936,44)
                            dm.Delay 100
                            dm.LeftClick 
                            dm.Delay 100
                            dm.LeftClick
                            If 主界面对战按钮() = 1 or 返回主页面按钮() = 1 Then 
                                广告卡r = 2
                            End If
   		    				
   		    				
                            If 广告卡r <> 2 Then 
                                If 无广告可看r <> 1 Then 
                                    Call 关闭广告()
                                End If
                            End If			
                        End If
                        
                        //点合作
                        dm.Delay 3000
                        Call MoveToFcn(629,571)
                        dm.Delay 200
                        dm.LeftClick 
                        dm.Delay 1000
                    			
                        For 5 
                            dm.Delay 500
                            If 合作未打完弹窗() = 1 Then 
                                //点击与好友一起
                                For 3
                                    Call MoveToFcn(337,516)
                                    dm.Delay 50
                                    dm.LeftClick 
                                    dm.Delay 100
                                Next
                                dm.Delay 3000
   								
                                //创建房间
                                Call MoveToFcn(418,431)
                                dm.Delay 50
                                dm.LeftClick 
                                dm.Delay 2000
   								
                                出现房间号 = 1
                                Exit For
                            End If	
                       		
                        Next

                        Exit For
                    End If
                Next
            End If
        End If

	
		
        If 出现房间号 > 0 Then 
        	
            For 5
                dm.Delay 200
                好友房间号 = dm.Ocr(484, 344, 560, 374, "D6D6D6-292929", 0.84)
                TracePrint "识别到房间号为：" & 好友房间号
                If len(好友房间号) <= 0 Then 
                    //执行创建房间
                    出现房间号 = 0
                Else 
                    If Int(好友房间号) > 999 Then 
                        Form1.InputBox74.Text = 好友房间号
                        出现房间号 = 1
                        dm.Delay 2000
                        If 社交频道入口(0) = 1 Then 
                            Call MoveToFcn(976,470)
                            dm.Delay 50
                            dm.LeftClick 
                        End If
                        Exit For
                    Else 
                        出现房间号 = 0
                    End If
                End If
            Next
        	
            If 出现房间号 > 0 Then 
                出现房间号 = -1
                For 180
                    dm.Delay 1000
                    TracePrint "等待进入战场中..."
                    If 判断当前是否在战场中() = 1 Then 
                        当前在战斗 = 1
                        TracePrint "进入战场了"
                        dm.Delay 50
                        //变量初始化
                        Call paramInit()
                        If getCard("幻精灵") = 0 Then 
                            装备切换 = - 1 
                        ElseIf 默认初始装备 = "无" Then
                            装备切换 = 1			
                        End If
                        //合作标志 = 1
                        Call 合作标志Handle(1)
                        扩建控制 = 合作前期扩建允许次数
                        TracePrint "已进入好友房间，开始合作"
                        出现房间号 = 1
                        Form1.InputBox74.Text = ""
                        Exit For
                    End If
                	
                    If len(Form1.InputBox74.Text) < 2 Then 
                        TracePrint "检查到房间号无效，重新创建"
                        出现房间号 = - 1 
                        dm.Delay 2000
                        Exit For
                    End If
                Next
            End If 
        End If
        
        dm.Delay 200
        If 对战结束确定() = 1 Then 
            当前在战斗 = 0
            TracePrint "自动6次合作子程序判断了对战结束确定"
            Call MoveToFcn(515,535)
            dm.Delay 100
            dm.LeftClick 
        End If
    	
        If 世界频道社交() = 1 Then 
            Call MoveToFcn(620,586)
            dm.Delay 50
            dm.LeftClick 
            dm.Delay 3000
        End If
		
        If 出现房间号 <> - 1  Then 
            Exit Do
        End If  
    Loop

End Function

