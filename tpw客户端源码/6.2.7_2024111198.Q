Sub 清理缓存()
    //Plugin.lxj_Plug.lxj_Recycle "c:\test_game\*.dll",1
    Plugin.lxj_Plug.lxj_Recycle "c:\test_game\*.exe", 1
    Plugin.lxj_Plug.lxj_Recycle "c:\test_game\版本号.txt", 1
    Dim userPath
    userPath= ""
    //获取当前用户路径
    userPath = Plugin.lxj_Plug.lxj_GetSpecialPath(40)
    //Plugin.lxj_Plug.lxj_Recycle userPath & "AppData\Roaming\MyMacro\Runner.exe", 1
    Plugin.lxj_Plug.lxj_Recycle userPath & "AppData\Roaming\MyMacro\updatemacro.dat", 1
End Sub


