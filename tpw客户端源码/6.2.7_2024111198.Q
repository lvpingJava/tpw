Sub 关闭广告()
    TracePrint "进入循环看广告"
    For 3
        dm.Delay 1000
        Call 广告卡()
    Next
	
    dm.Delay 500
    是否无广告可看 = 无广告可看()
	
    If 是否无广告可看 = 1 Then 
        dm.Delay 2000
        Call MoveToFcn(936,44)
        dm.Delay 100
        dm.LeftClick 
    	
        Exit Sub
    End If
	
    Dim gbgg, gbggcount
    gbggcount = 0
    gbgg = 1
    While gbgg > 0
        isOk11 = 0
        If 广告视频已() = 1 Then 
            isOk11 = 1
        End If
	
        If isOk11 = 1 Then 
            TracePrint "识别成功，关闭广告"
            dm.Delay 500
            Call MoveToFcn(995,74)
            dm.Delay 100
            dm.LeftClick 
            If get合作标志() = 0 Then 
                dm.Delay 1000
                Call MoveToFcn(936,44)
                dm.Delay 100
                dm.LeftClick 
                dm.Delay 1000
                Call MoveToFcn(936,44)
                dm.Delay 100
                dm.LeftClick 	
            End If 	

            dm.Delay 1000
            Call MoveToFcn(995,74)
            dm.Delay 200
            dm.LeftClick 
            If get合作标志() = 0 Then 
                dm.Delay 1000
                Call MoveToFcn(936,44)
                dm.Delay 100
                dm.LeftClick 	
            End If 	
			
            If 广告视频已() = 0 Then 
                TracePrint "已识别到广告完成"
                gbgg = 0
            End If
			
    	
        End If
		
        TracePrint "广告循环判断中"
        If gbgg = 1 Then 
            dm.Delay 5000
            gbggcount = gbggcount + 1	
        End If
        If gbggcount > 10 Then 
            TracePrint "强制关闭"
            gbgg = 0
           
            dm.Delay 200
            Call MoveToFcn(995,74)
            dm.Delay 100
            dm.LeftClick 
            dm.Delay 500
            
            dm.Delay 200
            Call MoveToFcn(991,75)
            dm.Delay 100
            dm.LeftClick 
            dm.Delay 500
            
            dm.Delay 200
            Call MoveToFcn(997,74)
            dm.Delay 100
            dm.LeftClick 
            dm.Delay 500
  
            If get合作标志() = 0 Then 
                dm.Delay 2000
                Call MoveToFcn(936,44)
                dm.Delay 100
                dm.LeftClick 	
            End If 	
        End If
		
        dm.Delay 50
        Call 广告卡()
        dm.Delay 50
        Call 无广告可看()
        dm.Delay 50
        Call crjj()
    	
    	
        Call MoveToFcn(936,44)
        dm.Delay 100
        dm.LeftClick 
        dm.Delay 200
		
        If 主界面对战按钮() = 1  Then 
            TracePrint "在广告循环里 对战结束识别到了对战。。。"
            gbgg = 0
        End If
        
        
    Wend 
    dm.Delay 100
End Sub


    
Function 杯子数量判断(str)
    dm.Delay 100
    dm_ret = dm.FindStr(147,88,180,114,str,"ffffff-786249",0.85,intX,intY)
    If intX >= 0 and intY >= 0 Then 
        杯子数量判断 = 1
    End If
End Function

Function 降杯(xtag)
    tc = 0
    jb=2
    While jb <> 0
		
        If 主界面对战按钮() = 1 Then 
            Call MoveToFcn(886,560)
            dm.Delay 100
            dm.LeftClick 
            qd = 1
            tc = 1
            dm.Delay 1000
        End If	
		
		
        If 是否出现快速匹配() = 1 Then 
            Call MoveToFcn(701,524)
            dm.Delay 100
            dm.LeftClick 
            Call 已超过对战次数继续(0)
        End If	
		
		
	
		
        If tc = 1 Then 
            If 对战中退出() = 1 Then 
                tc = 0
            End If
        End If

        If 对战中退出确认() = 1 Then 
			
        End If
		
		
        If 对战结束确定() = 1 Then 
            Call MoveToFcn(515,535)
            dm.Delay 100
            dm.LeftClick 
            dm.Delay 50
            If xtag > 0 Then 
                jb = jb - 1
            End If
            dm.Delay 1500
            qd =0
        End If	
			
		
        If is残忍拒绝() = 1 Then 
            dm.Delay 100
            Call MoveToFcn(357,529)
            dm.Delay 100
            dm.LeftClick 
        End If
                						

        //当杯子降到3000时退出循环   
        If 三千杯子() = 1 Then
            jb = 0
            dm.Delay 3000
            TracePrint "满足条件，降杯结束"
        End If
    Wend
End Function


Function 三千杯子()
  
    三千杯子 = 0
    Dim dm_ret1,dm_ret2
    dm.Delay 10
    dm_ret1 = dm.Ocr(145, 93, 219, 118, "ffffff-202020", 0.76)
    dm.Delay 10
    dm_ret2 = dm.Ocr(145, 93, 219, 118, "ffffff-202020", 0.78)
    dm.Delay 10
    dm_ret3 = dm.Ocr(145, 93, 219, 118, "E1DCD7-1E2328", 0.83)
    dm.Delay 10
    dm_ret4 = dm.Ocr(145, 93, 219, 118, "E1DCD7-1E2328", 0.80)
    dm.Delay 10
    dm_ret5 = dm.Ocr(145, 93, 219, 118, "E1DCD7-1E2328", 0.79)
    
    TracePrint "当前分数：" & dm_ret1 & "---" & dm_ret2& "---" & dm_ret3& "---" & dm_ret4& "---" & dm_ret5
    If Len(dm_ret1) > 0 or Len(dm_ret2) > 0 or Len(dm_ret3) > 0 or Len(dm_ret4) > 0 or Len(dm_ret5) > 0 Then 
        If  Int(Trim(dm_ret2)) > 3020 Then 
            TracePrint "当前分数超过3万，继续降：" &  dm_ret2	
            Exit Function
        End If
    	
        If Int(Trim(dm_ret1)) > 3020  Then 
            TracePrint "当前分数超过3万，继续降：" &  dm_ret1	
            Exit Function
        End If
    	
        If Int(Trim(dm_ret3)) > 3020  Then 
            TracePrint "当前分数超过3万，继续降：" &  dm_ret3
            Exit Function
        End If
    	
        If Int(Trim(dm_ret4)) > 3020  Then 
            TracePrint "当前分数超过3万，继续降：" &  dm_ret4	
            Exit Function
        End If
    	
        If Int(Trim(dm_ret5)) > 3020  Then 
            TracePrint "当前分数超过3万，继续降：" &  dm_ret5
            Exit Function
        End If
    End If
    
    dm.Delay 30
    dm_ret = dm.FindStrFast(151,94,209,117, "3000", "ffffff-151515", 0.85, intX, intY)
    If intX >= 0 and intY >= 0 Then
        三千杯子 = 1
        Exit Function
    End If
	
    三千杯子 = 三千左右杯子() 
End Function

Function 三千左右杯子()
    //降到3000多点ck = 1 暂时注释	
    Dim dm_ret1,dm_ret2,dm_ret3
    三千左右杯子 = 0
    dm.Delay 20
    dm_ret1 = dm.FindStrFast(149, 95, 180, 117, "30", "ffffff-151515", 0.85, intX, intY)
    dm.Delay 20
    dm_ret2 = dm.FindStrFast(149, 95, 180, 117, "30", "ffffff-101010", 0.83, intX, intY)
    dm.Delay 20
    dm_ret3 = dm.FindStrFast(149,95,180,117, "30", "E1DCD7-1E2328", 0.84, intX, intY)
    If dm_ret1 >= 0  Then 
        三千左右杯子 = 1
        TracePrint "三千左右杯子1"
        Exit Function
    End If
    
    If dm_ret2 >= 0  Then 
        三千左右杯子 = 1
        TracePrint "三千左右杯子2"
        Exit Function
    End If
    
    If  dm_ret3 >= 0 Then 
        三千左右杯子 = 1
        TracePrint "三千左右杯子3"
        Exit Function
    End If
	
End Function

