//终止操作
Sub scriptExit
    Dim dm_ret
    Set dm = createobject("dm.dmsoft")
    dm_ret = dm.UnBindWindow()
    Set dm = Nothing
    TracePrint "辅助已停止！解绑窗口:"& dm_ret
    Plugin.Msg.Tips "脚本已停止！"
End Sub



Event Form1.Button1.Click
    Form1.Button1.Enabled = False
    Form1.Button1.Caption = "注册中,请耐心等待"
    Dim result, results,portTxt,txt

	portTxt = 5000
	txt = Plugin.lxj_Plug.lxj_Txtline("C:\test_game\port.txt")
	If txt = "" Then	
    	portTxt = 5000
	Else 
    	portTxt = Trim(txt(1))
	End If
	Form1.Label6.Caption = portTxt
	pyport = portTxt

    result = temPost("", "http://127.0.0.1:"& pyport & "/getIslogin")
    If len(result) > 0 Then 
        注册码校验结果 = 1
    End If
	
    If 注册码校验结果 = 1 Then 
        //注册成功记录
        Form1.Label97.Caption = "注册成功"
     	
        results = Split(result, ",")
        Form1.Container1.Visible = False
     
        Form1.Label8.Caption = results(1)
       
        Form1.Label4.Caption = results(0)
        Delay 50
        Form1.启动.Visible = True
        Form1.中止.Visible = True
    
        Form1.保存设置.Visible = True
        Form1.TabControl1.Tab = 1
     
        Call 配置回显("C:\test_game\总配置.txt", 3)
		
        Call 预加载()
		
        Call 到期时间提醒()
        
        Call 对战下拉初始化()
        Call 合作下拉初始化()
        Call 寒冰下拉初始化()
        
       
		
    Else 
        MessageBox "请先启动躺平王服务端，如果不会，请看辅助使用文档"
        Form1.Button1.Enabled = True
        Form1.Button1.Caption = "注册"
    End If
	
End Event

Sub 到期时间提醒()
    Delay valdiff
    valdiff = 0
    TracePrint "时间：" & Form1.Label4.Caption
    valdiff = DateDiff("d", Now, Form1.Label4.Caption)
    If valdiff < 4 Then 
        Form1.Label103.Visible = True
        Form1.Label104.Visible = True
        Form1.Label105.Visible = True
        Form1.Label105.Caption = Form1.Label4.Caption
    Else 
        Form1.Label103.Visible = False
        Form1.Label104.Visible = False
        Form1.Label105.Visible = False
    End If
End Sub

